<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\BuurmansRgb.ico</ApplicationIcon>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BuurmansRgb.Engine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\BuurmansRgb.ico" LogicalName="BuurmansRgb.ico" />
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>BuurmansRgb.Engine.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BuurmansRgb.Core\BuurmansRgb.Core.csproj" />
    <ProjectReference Include="..\BuurmansRgb.Effects\BuurmansRgb.Effects.csproj" />
    <ProjectReference Include="..\BuurmansRgb.Contracts\BuurmansRgb.Contracts.csproj" />
    <ProjectReference Include="..\BuurmansRgb.Providers.Simulated\BuurmansRgb.Providers.Simulated.csproj" />
    <ProjectReference Include="..\BuurmansRgb.Providers.OpenRgb\BuurmansRgb.Providers.OpenRgb.csproj" />
  </ItemGroup>

  <!-- The tray starts BuurmansRgb.UI.exe from the engine folder. The reference only makes the UI
       build first; the engine does not use its code. CopySettingsApp copies the UI next to it. -->
  <ItemGroup>
    <ProjectReference Include="..\BuurmansRgb.UI\BuurmansRgb.UI.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopySettingsApp" AfterTargets="Build">
    <MSBuild Projects="..\BuurmansRgb.UI\BuurmansRgb.UI.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_SettingsAppTargetPath" />
    </MSBuild>
    <ItemGroup>
      <_SettingsAppFile Include="%(_SettingsAppTargetPath.RootDir)%(_SettingsAppTargetPath.Directory)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_SettingsAppFile)"
          DestinationFiles="@(_SettingsAppFile->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
