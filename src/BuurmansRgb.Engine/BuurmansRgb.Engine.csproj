<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\BuurmansRgb.ico</ApplicationIcon>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- LibraryImport generates its marshalling code as unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Shared with BuurmansRgb.UI, see Directory.Build.props. -->
    <OutDir>$(AppOutputRoot)$(Configuration)\</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BuurmansRgb.Engine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\BuurmansRgb.ico" LogicalName="BuurmansRgb.ico" />
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>BuurmansRgb.Engine.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BuurmansRgb.Core\BuurmansRgb.Core.csproj" />
    <ProjectReference Include="..\BuurmansRgb.Effects\BuurmansRgb.Effects.csproj" />
    <ProjectReference Include="..\BuurmansRgb.Contracts\BuurmansRgb.Contracts.csproj" />
    <ProjectReference Include="..\BuurmansRgb.Providers.Simulated\BuurmansRgb.Providers.Simulated.csproj" />
    <ProjectReference Include="..\BuurmansRgb.Providers.OpenRgb\BuurmansRgb.Providers.OpenRgb.csproj" />
  </ItemGroup>

</Project>
