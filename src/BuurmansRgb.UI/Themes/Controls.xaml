<!-- The components of design/DESIGN.md (§ 4) and the dark look of the standard controls, with the
     hover border and focus ring of § 6. Uses the tokens of Tokens.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:BuurmansRgb.UI.Views">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Focus rings: 2 px in text, drawn just outside the control, only when the keyboard moved the focus. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="10" BorderThickness="2" BorderBrush="{StaticResource TextBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Around a card with the corners of a card (18), so the ring follows the whole card. -->
    <Style x:Key="FocusRingCard">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="21" BorderThickness="2" BorderBrush="{StaticResource TextBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Around a button or slider with the corners of a button (12), 3 px further out. -->
    <Style x:Key="FocusRingButton">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="15" BorderThickness="2" BorderBrush="{StaticResource TextBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Around a switch: round ends for a ring 38 px high. A larger radius would make WPF draw an
         ellipse instead of round ends. -->
    <Style x:Key="FocusRingSwitch">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="19" BorderThickness="2" BorderBrush="{StaticResource TextBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Around a square control that is drawn as a circle, such as an icon button. -->
    <Style x:Key="FocusRingRound">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="999" BorderThickness="2" BorderBrush="{StaticResource TextBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Line icons (§ 4): 24 by 24 like the screens of the design, drawn 22 px with a 2 px stroke. -->
    <Geometry x:Key="IconLamps">M9,18 H15 M10,21 H14 M12,3 A6,6 0 0 0 8,13.5 C8.8,14.3 9,15 9,16 H15 C15,15 15.2,14.3 16,13.5 A6,6 0 0 0 12,3 Z</Geometry>
    <Geometry x:Key="IconColor">M4,6 H14 M18,6 H20 M4,12 H8 M12,12 H20 M4,18 H16 M14,6 A2,2 0 1 0 18,6 A2,2 0 1 0 14,6 Z M8,12 A2,2 0 1 0 12,12 A2,2 0 1 0 8,12 Z M16,18 A2,2 0 1 0 20,18 A2,2 0 1 0 16,18 Z</Geometry>
    <Geometry x:Key="IconScenes">M4.5,3 H8.5 A1.5,1.5 0 0 1 10,4.5 V8.5 A1.5,1.5 0 0 1 8.5,10 H4.5 A1.5,1.5 0 0 1 3,8.5 V4.5 A1.5,1.5 0 0 1 4.5,3 Z M15.5,3 H19.5 A1.5,1.5 0 0 1 21,4.5 V8.5 A1.5,1.5 0 0 1 19.5,10 H15.5 A1.5,1.5 0 0 1 14,8.5 V4.5 A1.5,1.5 0 0 1 15.5,3 Z M4.5,14 H8.5 A1.5,1.5 0 0 1 10,15.5 V19.5 A1.5,1.5 0 0 1 8.5,21 H4.5 A1.5,1.5 0 0 1 3,19.5 V15.5 A1.5,1.5 0 0 1 4.5,14 Z M15.5,14 H19.5 A1.5,1.5 0 0 1 21,15.5 V19.5 A1.5,1.5 0 0 1 19.5,21 H15.5 A1.5,1.5 0 0 1 14,19.5 V15.5 A1.5,1.5 0 0 1 15.5,14 Z</Geometry>
    <Geometry x:Key="IconNeighbours">M2,12 L7,7 L12,12 L17,7 L22,12 M4,12 V20 H10 V12 M14,12 V20 H20 V12</Geometry>
    <!-- The wrench of the settings button in the design. -->
    <Geometry x:Key="IconSettings">M14.7,6.3 A4,4 0 0 0 9.3,11.7 L3,18 V21 H6 L12.3,14.7 A4,4 0 0 0 17.7,9.3 L15.1,11.9 L12.7,11.3 L12.1,8.9 Z</Geometry>
    <Geometry x:Key="IconChevronDown">M6,9 L12,15 L18,9</Geometry>

    <Style x:Key="LineIcon" TargetType="Path">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <!-- The 24 px grid of the design in 22 px. -->
                <ScaleTransform ScaleX="0.9167" ScaleY="0.9167" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The small dark app icon (icon/buurmansrgb-icon-small-dark.svg) for in the app itself. -->
    <DrawingImage x:Key="AppIconSmallDark">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#24242B" Geometry="M50,0 H170 A50,50 0 0 1 220,50 V170 A50,50 0 0 1 170,220 H50 A50,50 0 0 1 0,170 V50 A50,50 0 0 1 50,0 Z" />
                <GeometryDrawing Geometry="M98,152 L98,196">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#F4F1EA" Thickness="10" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M122,152 L122,170 L134,178 L130,198">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#F4F1EA" Thickness="10" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF3B3B" Geometry="M80,140 L80,82 A30,30 0 0 1 100,54 L100,140 Z" />
                <GeometryDrawing Brush="#1FC46A" Geometry="M100,52 H120 V140 H100 Z" />
                <GeometryDrawing Brush="#2F6BFF" Geometry="M120,54 A30,30 0 0 1 140,82 L140,140 L120,140 Z" />
                <GeometryDrawing Geometry="M80,140 L80,82 A30,30 0 0 1 140,82 L140,140 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#F4F1EA" Thickness="10" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#24242B">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="70,138,80,16" RadiusX="4" RadiusY="4" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#F4F1EA" Thickness="10" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <DrawingGroup>
                    <DrawingGroup.Transform>
                        <RotateTransform Angle="-16" CenterX="110" CenterY="108" />
                    </DrawingGroup.Transform>
                    <GeometryDrawing Brush="#E8BE96">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="50,92,120,32" RadiusX="16" RadiusY="16" />
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#1A1A1A" Thickness="9" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#F7E6D3">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="94,99,32,18" RadiusX="3" RadiusY="3" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- The word mark (§ 2): "buurmans" with R, g and b in their LED colors. -->
    <Style x:Key="Wordmark" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <TextBlock FontFamily="{StaticResource TextFont}" FontSize="{StaticResource WordmarkSize}" FontWeight="ExtraBold"
                               Foreground="{StaticResource TextBrush}" AutomationProperties.Name="buurmansRgb">
                        <Run Text="buurmans" /><Run Text="R" Foreground="{StaticResource LedRedBrush}" /><Run Text="g" Foreground="{StaticResource LedGreenBrush}" /><Run Text="b" Foreground="{StaticResource LedBlueBrush}" />
                    </TextBlock>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- § 2 Text roles -->
    <Style x:Key="ScreenTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource ScreenTitleSize}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>
    <Style x:Key="BigValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BigValueSize}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>
    <Style x:Key="SmallScreenTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource WordmarkSize}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SectionHeaderSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CardTitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SubText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SubTextSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Numbers beside a slider, in the mono font. -->
    <Style x:Key="MonoValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <!-- § 4 Card: surface with a 1 px border, no shadow. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style x:Key="LargeCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="CornerRadius" Value="{StaticResource LargeCardRadius}" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <!-- An LED bulb that is off shows led-off. -->
    <Style TargetType="views:LedBulb">
        <Setter Property="OffBrush" Value="{StaticResource LedOffBrush}" />
    </Style>

    <!-- The LED strip (§ 4): a row of evenly spread bulbs on the "circuit board". -->
    <Style x:Key="StripBoard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource StripBgBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource StripRadius}" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <!-- § 4 Switch: 52 by 32 with a 24 px knob. On, the track takes the color in Tag (the lamp's, or text
         for the whole house) and the knob bg; off, led-off with a knob-off knob. The track radius is
         half its height (SwitchRadius), so its ends are round; a larger one would make it an ellipse. -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Style.Resources>
            <CornerRadius x:Key="SwitchRadius">16</CornerRadius>
        </Style.Resources>
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Tag" Value="{StaticResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingSwitch}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Track" CornerRadius="{DynamicResource SwitchRadius}" Background="{StaticResource LedOffBrush}" />
                        <!-- Hover (§ 6): the track a little lighter, whatever its color. -->
                        <Border x:Name="Shine" CornerRadius="{DynamicResource SwitchRadius}" Background="{StaticResource TextBrush}" Opacity="0" />
                        <Ellipse x:Name="Knob" Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" Fill="{StaticResource KnobOffBrush}"
                                 Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shine" Property="Opacity" Value="0.15" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource BgBrush}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LargeSwitch" TargetType="ToggleButton" BasedOn="{StaticResource Switch}">
        <Style.Resources>
            <CornerRadius x:Key="SwitchRadius">18</CornerRadius>
        </Style.Resources>
        <Setter Property="Width" Value="60" />
        <Setter Property="Height" Value="36" />
    </Style>

    <!-- § 4 Primary button: text-colored, with the corners of ButtonRadius. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Padding" Value="28,0" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
        <Setter Property="Background" Value="{StaticResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingButton}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" CornerRadius="{StaticResource ButtonRadius}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A quieter button for the smaller actions: a surface with a border and the corners of ButtonRadius. -->
    <Style x:Key="SecondaryButton" TargetType="ButtonBase">
        <Setter Property="MinHeight" Value="{StaticResource MinClickSize}" />
        <Setter Property="MinWidth" Value="{StaticResource MinClickSize}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingButton}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Face" CornerRadius="{DynamicResource ButtonRadius}" BorderThickness="1" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A round 44 px button with a line icon as its content, such as the wrench in the design. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Style.Resources>
            <!-- Half of 44: a circle, as the round buttons in the design. -->
            <CornerRadius x:Key="ButtonRadius">22</CornerRadius>
        </Style.Resources>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRound}" />
        <Setter Property="Width" Value="{StaticResource MinClickSize}" />
        <Setter Property="Height" Value="{StaticResource MinClickSize}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- An IconButton that repeats while it is held down, such as − and + of a zone length. -->
    <Style x:Key="IconRepeatButton" TargetType="RepeatButton" BasedOn="{StaticResource SecondaryButton}">
        <Style.Resources>
            <CornerRadius x:Key="ButtonRadius">22</CornerRadius>
        </Style.Resources>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRound}" />
        <Setter Property="Width" Value="{StaticResource MinClickSize}" />
        <Setter Property="Height" Value="{StaticResource MinClickSize}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- § 4 "+ new" button: transparent with a dashed border-strong border and the corners of ButtonRadius. -->
    <Style x:Key="NewButton" TargetType="Button">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingButton}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="Dashes" RadiusX="{StaticResource ButtonCornerRadius}" RadiusY="{StaticResource ButtonCornerRadius}" StrokeThickness="2" StrokeDashArray="3 2"
                                   Stroke="{StaticResource BorderStrongBrush}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dashes" Property="Stroke" Value="{StaticResource TextMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- § 4 Preset tile: 44 px high, filled with its color; Tag True marks the chosen one with a 3 px
         text border. -->
    <Style x:Key="PresetTile" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource MinClickSize}" />
        <Setter Property="MinWidth" Value="{StaticResource MinClickSize}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="{StaticResource TileRadius}" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource TextBrush}" />
                <Setter Property="BorderThickness" Value="3" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A text link as a button, such as "+ Erbij knutselen". -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource LinkBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="{StaticResource MinClickSize}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter VerticalAlignment="Center" Margin="4,0" RecognizesAccessKey="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource LinkHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A card that opens something (§ 4, § 6): the whole card is the button, so the hover border and the
         focus ring follow the card. Other controls on the card sit beside it, not in it. -->
    <Style x:Key="CardButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingCard}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="{StaticResource CardRadius}" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{StaticResource LinkBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource LinkHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Sliders: a led-off rail, filled up to the thumb in the accent color in Foreground (text by
         default; Rood, Groen and Blauw use their own color, § 5.2). Arrow keys move them. -->
    <Style x:Key="SliderRail" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="6" CornerRadius="3" Background="{TemplateBinding Background}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingButton}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="6" CornerRadius="3" Background="{StaticResource LedOffBrush}" VerticalAlignment="Center" Margin="2,0" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRail}" Command="Slider.DecreaseLarge" Background="{TemplateBinding Foreground}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRail}" Command="Slider.IncreaseLarge" Background="Transparent" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="22" Height="22">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"
                                                     Stroke="{StaticResource BgBrush}" StrokeThickness="3" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource LedBlueBrush}" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="MinHeight" Value="{StaticResource MinClickSize}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Box" CornerRadius="12" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                        </Trigger>
                        <!-- Typing goes here: the same 2 px text ring as the focus of other controls. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                            <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="22" Height="22" CornerRadius="6" BorderThickness="2" VerticalAlignment="Center"
                                BorderBrush="{StaticResource BorderStrongBrush}" Background="Transparent">
                            <Path x:Name="Check" Data="M5,11 L9,15 L17,7" Stretch="None" Margin="-2" Stroke="{StaticResource BgBrush}" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource TextBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox: a surface field with a chevron, its list in a surface popup. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Item" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="2" BorderBrush="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{StaticResource BorderBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Item" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="MinHeight" Value="{StaticResource MinClickSize}" />
        <Setter Property="Padding" Value="14,0,44,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Field" CornerRadius="12" BorderThickness="1"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconChevronDown}" HorizontalAlignment="Right" Margin="0,0,12,0"
                                              Stroke="{StaticResource TextMutedBrush}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <!-- A text in Tag shows while nothing is selected, as a hint what to pick. -->
                        <TextBlock x:Name="Placeholder" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Text="{TemplateBinding Tag}" Foreground="{StaticResource TextMutedBrush}" Visibility="Collapsed" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border CornerRadius="12" BorderThickness="1" Padding="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedItem" Value="{x:Null}">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin dark scroll bars. -->
    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" CornerRadius="4" Background="{StaticResource BorderStrongBrush}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource TextMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollBarPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollBarPage}" Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollBarPage}" Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollBarThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Margin="2">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarPage}" Command="ScrollBar.PageLeftCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarPage}" Command="ScrollBar.PageRightCommand" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumb}" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="{StaticResource SubTextSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border MaxWidth="360" Padding="10,6" CornerRadius="10" BorderThickness="1"
                            Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderStrongBrush}">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
