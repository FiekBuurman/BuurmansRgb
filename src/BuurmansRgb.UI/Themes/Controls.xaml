<!-- The components of design/DESIGN.md (§ 4) and the dark look of the standard controls, with the
     hover border and focus ring of § 6. Uses the tokens of Tokens.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:res="clr-namespace:BuurmansRgb.UI.Resources"
                    xmlns:views="clr-namespace:BuurmansRgb.UI.Views">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Focus rings: 2 px in text, drawn just outside the control, only when the keyboard moved the focus. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource TextBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Around a card with the corners of a card (18), so the ring follows the whole card. -->
    <Style x:Key="FocusRingCard">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="21" BorderThickness="2" BorderBrush="{DynamicResource TextBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Around a button or slider with the corners of a button (12), 3 px further out. -->
    <Style x:Key="FocusRingButton">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="15" BorderThickness="2" BorderBrush="{DynamicResource TextBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Around a switch: round ends for a ring 38 px high. A larger radius would make WPF draw an
         ellipse instead of round ends. -->
    <Style x:Key="FocusRingSwitch">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="19" BorderThickness="2" BorderBrush="{DynamicResource TextBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Around a square control that is drawn as a circle, such as an icon button. -->
    <Style x:Key="FocusRingRound">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="999" BorderThickness="2" BorderBrush="{DynamicResource TextBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Line icons (§ 4): 24 by 24 like the screens of the design, drawn 22 px with a 2 px stroke. -->
    <Geometry x:Key="IconLamps">M9,18 H15 M10,21 H14 M12,3 A6,6 0 0 0 8,13.5 C8.8,14.3 9,15 9,16 H15 C15,15 15.2,14.3 16,13.5 A6,6 0 0 0 12,3 Z</Geometry>
    <Geometry x:Key="IconColor">M4,6 H14 M18,6 H20 M4,12 H8 M12,12 H20 M4,18 H16 M14,6 A2,2 0 1 0 18,6 A2,2 0 1 0 14,6 Z M8,12 A2,2 0 1 0 12,12 A2,2 0 1 0 8,12 Z M16,18 A2,2 0 1 0 20,18 A2,2 0 1 0 16,18 Z</Geometry>
    <Geometry x:Key="IconScenes">M4.5,3 H8.5 A1.5,1.5 0 0 1 10,4.5 V8.5 A1.5,1.5 0 0 1 8.5,10 H4.5 A1.5,1.5 0 0 1 3,8.5 V4.5 A1.5,1.5 0 0 1 4.5,3 Z M15.5,3 H19.5 A1.5,1.5 0 0 1 21,4.5 V8.5 A1.5,1.5 0 0 1 19.5,10 H15.5 A1.5,1.5 0 0 1 14,8.5 V4.5 A1.5,1.5 0 0 1 15.5,3 Z M4.5,14 H8.5 A1.5,1.5 0 0 1 10,15.5 V19.5 A1.5,1.5 0 0 1 8.5,21 H4.5 A1.5,1.5 0 0 1 3,19.5 V15.5 A1.5,1.5 0 0 1 4.5,14 Z M15.5,14 H19.5 A1.5,1.5 0 0 1 21,15.5 V19.5 A1.5,1.5 0 0 1 19.5,21 H15.5 A1.5,1.5 0 0 1 14,19.5 V15.5 A1.5,1.5 0 0 1 15.5,14 Z</Geometry>
    <!-- The wrench of the settings button in the design. -->
    <Geometry x:Key="IconSettings">M14.7,6.3 A4,4 0 0 0 9.3,11.7 L3,18 V21 H6 L12.3,14.7 A4,4 0 0 0 17.7,9.3 L15.1,11.9 L12.7,11.3 L12.1,8.9 Z</Geometry>
    <Geometry x:Key="IconChevronDown">M6,9 L12,15 L18,9</Geometry>

    <Style x:Key="LineIcon" TargetType="Path">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <!-- The 24 px grid of the design in 22 px. -->
                <ScaleTransform ScaleX="0.9167" ScaleY="0.9167" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The small dark app icon (icon/buurmansrgb-icon-small-dark.svg) for in the app itself. -->
    <DrawingImage x:Key="AppIconSmallDark">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#24242B" Geometry="M50,0 H170 A50,50 0 0 1 220,50 V170 A50,50 0 0 1 170,220 H50 A50,50 0 0 1 0,170 V50 A50,50 0 0 1 50,0 Z" />
                <GeometryDrawing Geometry="M98,152 L98,196">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#F4F1EA" Thickness="10" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M122,152 L122,170 L134,178 L130,198">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#F4F1EA" Thickness="10" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF3B3B" Geometry="M80,140 L80,82 A30,30 0 0 1 100,54 L100,140 Z" />
                <GeometryDrawing Brush="#1FC46A" Geometry="M100,52 H120 V140 H100 Z" />
                <GeometryDrawing Brush="#2F6BFF" Geometry="M120,54 A30,30 0 0 1 140,82 L140,140 L120,140 Z" />
                <GeometryDrawing Geometry="M80,140 L80,82 A30,30 0 0 1 140,82 L140,140 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#F4F1EA" Thickness="10" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#24242B">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="70,138,80,16" RadiusX="4" RadiusY="4" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#F4F1EA" Thickness="10" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <DrawingGroup>
                    <DrawingGroup.Transform>
                        <RotateTransform Angle="-16" CenterX="110" CenterY="108" />
                    </DrawingGroup.Transform>
                    <GeometryDrawing Brush="#E8BE96">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="50,92,120,32" RadiusX="16" RadiusY="16" />
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#1A1A1A" Thickness="9" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#F7E6D3">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="94,99,32,18" RadiusX="3" RadiusY="3" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- The word mark (§ 2): "buurmans" with R, g and b in their LED colors. -->
    <Style x:Key="Wordmark" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <TextBlock FontFamily="{StaticResource TextFont}" FontSize="{StaticResource WordmarkSize}" FontWeight="ExtraBold"
                               Foreground="{DynamicResource TextBrush}" AutomationProperties.Name="buurmansRgb">
                        <Run Text="buurmans" /><Run Text="R" Foreground="{StaticResource LedRedBrush}" /><Run Text="g" Foreground="{StaticResource LedGreenBrush}" /><Run Text="b" Foreground="{StaticResource LedBlueBrush}" />
                    </TextBlock>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The app icon and the word mark at the left of the title bar of our own (§ 6), in the main
         window and in the question before deleting. -->
    <Style x:Key="TitleBarLogo" TargetType="ContentControl">
        <Setter Property="Margin" Value="18,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="26" Height="26" Source="{StaticResource AppIconSmallDark}" AutomationProperties.Name="{x:Static res:Strings.WindowTitle}" />
                        <ContentControl Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Wordmark}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The buttons in the title bar of our own (§ 6), as those of Windows: an icon of Segoe Fluent
         Icons on the bar, lighter under the mouse, and out of the tab order. -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ItemHighlightBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnHighlightTextBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource CaptionPressedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnHighlightTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- The cross, red under the mouse as in Windows; in a contrast theme the highlight, like the
         other buttons of the title bar. -->
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Content" Value="&#xE8BB;" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CloseHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource CloseHoverTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- § 2 Text roles -->
    <Style x:Key="ScreenTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource ScreenTitleSize}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>
    <Style x:Key="BigValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource BigValueSize}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>
    <Style x:Key="SmallScreenTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource SmallScreenTitleSize}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>
    <!-- A heading goes on over more lines too, such as beside the links of Apparaten. -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource SectionHeaderSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource CardTitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Body text goes on over more lines, as subtext does, when it no longer fits beside its control,
         such as with a larger text size of Windows. -->
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SubText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource SubTextSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Numbers beside a slider, in the mono font. -->
    <Style x:Key="MonoValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="{DynamicResource SmallBodySize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <!-- § 4 Card: surface with a 1 px border, no shadow. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style x:Key="LargeCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="CornerRadius" Value="{StaticResource LargeCardRadius}" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <!-- An LED bulb that is off shows led-off; off or black, it gets a ring that shows where it is. -->
    <Style TargetType="views:LedBulb">
        <Setter Property="OffBrush" Value="{StaticResource LedOffBrush}" />
        <Setter Property="OffRingBrush" Value="{DynamicResource LedOffRingBrush}" />
    </Style>
    <!-- The preview of the LEDs of a device: a black LED gets the same ring. -->
    <Style TargetType="views:LedPreviewView">
        <Setter Property="OffRingBrush" Value="{DynamicResource LedOffRingBrush}" />
    </Style>

    <!-- The LED strip (§ 4): a row of evenly spread bulbs on the "circuit board". -->
    <Style x:Key="StripBoard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource StripBgBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource StripRadius}" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <!-- § 4 Switch: 52 by 32 with a 24 px knob. On, the track takes the color in Tag (the lamp's, or text
         for the whole house) and the knob bg; off, led-off with a knob-off knob. The track radius is
         half its height (SwitchRadius), so its ends are round; a larger one would make it an ellipse.
         In a contrast theme of Windows (ContrastTheme) the highlight covers the track when on, as in
         the switches of Windows, and a ring in the text color shows the track, in the highlight under
         the mouse (HoverOutlineBrush); otherwise the cover and the ring are transparent. -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Style.Resources>
            <CornerRadius x:Key="SwitchRadius">16</CornerRadius>
        </Style.Resources>
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Tag" Value="{DynamicResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingSwitch}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Track" CornerRadius="{DynamicResource SwitchRadius}" Background="{DynamicResource ControlTrackBrush}" />
                        <Border x:Name="Cover" CornerRadius="{DynamicResource SwitchRadius}" Background="{DynamicResource SwitchOnCoverBrush}" Visibility="Collapsed" />
                        <!-- Hover (§ 6): the track a little lighter, whatever its color. -->
                        <Border x:Name="Shine" CornerRadius="{DynamicResource SwitchRadius}" Background="{DynamicResource TextBrush}" Opacity="0" />
                        <Border x:Name="Outline" CornerRadius="{DynamicResource SwitchRadius}" BorderThickness="1" BorderBrush="{DynamicResource ControlOutlineBrush}" />
                        <Ellipse x:Name="Knob" Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" Fill="{DynamicResource KnobOffBrush}"
                                 Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shine" Property="Opacity" Value="0.15" />
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource HoverOutlineBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Cover" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnAccentBrush}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LargeSwitch" TargetType="ToggleButton" BasedOn="{StaticResource Switch}">
        <Style.Resources>
            <CornerRadius x:Key="SwitchRadius">18</CornerRadius>
        </Style.Resources>
        <Setter Property="Width" Value="60" />
        <Setter Property="Height" Value="36" />
    </Style>

    <!-- § 4 Primary button: text-colored, with the corners of ButtonRadius; in a contrast theme the
         highlight (AccentBrush). Under the mouse a little lighter; in a contrast theme, where
         that would not show, the colors swap and a ring in the highlight keeps the shape of the
         button, as the accent buttons of Windows do. Without one the hover tokens are the colors at
         rest and the ring is transparent. Under the mouse the face always takes AccentHoverBrush, as
         the trigger sets the face itself: a Background of your own on a PrimaryButton shows only at
         rest. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Padding" Value="28,0" />
        <Setter Property="FontSize" Value="{DynamicResource PrimaryButtonSize}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingButton}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Face" CornerRadius="{StaticResource ButtonRadius}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="HoverRing" CornerRadius="{StaticResource ButtonRadius}" BorderThickness="2" BorderBrush="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Opacity" Value="0.9" />
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            <Setter TargetName="HoverRing" Property="BorderBrush" Value="{DynamicResource HoverOutlineBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A quieter button for the smaller actions: a surface with a border and the corners of ButtonRadius. -->
    <Style x:Key="SecondaryButton" TargetType="ButtonBase">
        <Setter Property="MinHeight" Value="{StaticResource MinClickSize}" />
        <Setter Property="MinWidth" Value="{StaticResource MinClickSize}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ButtonFaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingButton}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Face" CornerRadius="{DynamicResource ButtonRadius}" BorderThickness="1" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A round 44 px button with a line icon as its content, such as the wrench in the design. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Style.Resources>
            <!-- Half of 44: a circle, as the round buttons in the design. -->
            <CornerRadius x:Key="ButtonRadius">22</CornerRadius>
        </Style.Resources>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRound}" />
        <Setter Property="Width" Value="{StaticResource MinClickSize}" />
        <Setter Property="Height" Value="{StaticResource MinClickSize}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- A round toggle with a short text, such as a day of the week: on, text-colored like the primary
         button with bg text; off, a surface with a border like the secondary button. A larger text
         size of Windows makes it a pill, as wide as its text. -->
    <Style x:Key="DayToggle" TargetType="ToggleButton" BasedOn="{StaticResource SecondaryButton}">
        <Style.Resources>
            <CornerRadius x:Key="ButtonRadius">22</CornerRadius>
        </Style.Resources>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRound}" />
        <Setter Property="MinWidth" Value="{StaticResource MinClickSize}" />
        <Setter Property="MinHeight" Value="{StaticResource MinClickSize}" />
        <Setter Property="Padding" Value="8,0" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- An IconButton that repeats while it is held down, such as − and + of a zone length. -->
    <Style x:Key="IconRepeatButton" TargetType="RepeatButton" BasedOn="{StaticResource SecondaryButton}">
        <Style.Resources>
            <CornerRadius x:Key="ButtonRadius">22</CornerRadius>
        </Style.Resources>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRound}" />
        <Setter Property="Width" Value="{StaticResource MinClickSize}" />
        <Setter Property="Height" Value="{StaticResource MinClickSize}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- § 4 "+ new" button: transparent with a dashed border-strong border and the corners of ButtonRadius,
         or the Corners.Radius of a style based on it. A dashed line needs a Rectangle, which has one
         radius: the top left one. -->
    <Style x:Key="NewButton" TargetType="Button">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="FontSize" Value="{DynamicResource NewButtonSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingButton}" />
        <Setter Property="views:Corners.Radius" Value="{StaticResource ButtonRadius}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="Dashes" StrokeThickness="2" StrokeDashArray="3 2" Stroke="{DynamicResource BorderStrongBrush}"
                                   RadiusX="{TemplateBinding views:Corners.Radius, Converter={x:Static views:Corners.TopLeft}}"
                                   RadiusY="{TemplateBinding views:Corners.Radius, Converter={x:Static views:Corners.TopLeft}}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dashes" Property="Stroke" Value="{DynamicResource ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- § 4 Preset tile: 44 px high, filled with its color; Tag True marks the chosen one with a 3 px
         text border. A binding gives Tag a bool, so the trigger compares with a bool: the text "True"
         never equals it. The corners are Corners.Radius, so a style based on it can set others. -->
    <Style x:Key="PresetTile" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource MinClickSize}" />
        <Setter Property="MinWidth" Value="{StaticResource MinClickSize}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="views:Corners.Radius" Value="{StaticResource TileRadius}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="{TemplateBinding views:Corners.Radius}" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
            </Trigger>
            <Trigger Property="Tag">
                <Trigger.Value>
                    <sys:Boolean>True</sys:Boolean>
                </Trigger.Value>
                <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                <Setter Property="BorderThickness" Value="3" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A preset tile of the toolbox on Kleur: a square of SmallTileSize instead of 44 px high, with
         smaller corners to go with it. The tiles of a list of colors stay PresetTile. -->
    <Style x:Key="SmallPresetTile" TargetType="Button" BasedOn="{StaticResource PresetTile}">
        <Setter Property="views:Corners.Radius" Value="{StaticResource SmallTileRadius}" />
        <Setter Property="Width" Value="{StaticResource SmallTileSize}" />
        <Setter Property="Height" Value="{StaticResource SmallTileSize}" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

    <!-- The tiles of a list of colors (ColorListEditor) and the steps of an own effect: rows of at
         most six tiles 44 wide and 8 apart, with the + and − buttons (ColorListButton) behind them. -->
    <Style x:Key="ColorTileList" TargetType="ItemsControl">
        <Setter Property="MaxWidth" Value="312" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A tile of a ColorTileList; its item gives IsSelected (Tag) and Name. -->
    <Style x:Key="ColorListTile" TargetType="Button" BasedOn="{StaticResource PresetTile}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Tag" Value="{Binding IsSelected}" />
        <Setter Property="ToolTip" Value="{Binding Name}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
    </Style>

    <Style x:Key="ColorListButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- "+" before the own colors of the toolbox: the "+ new" button as a square of SmallTileSize with
         the corners of a SmallPresetTile. -->
    <Style x:Key="AddTile" TargetType="Button" BasedOn="{StaticResource NewButton}">
        <Setter Property="Width" Value="{StaticResource SmallTileSize}" />
        <Setter Property="Height" Value="{StaticResource SmallTileSize}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="views:Corners.Radius" Value="{StaticResource SmallTileRadius}" />
    </Style>

    <!-- A text link as a button, such as "+ Erbij knutselen". One that does nothing now, such as
         "LED-kleuren van dit apparaat overnemen" with Hele huis, is grey, so it no longer looks like a
         link: a link has no frame or fill, so fading alone would leave it blue. The muted text at 0.6
         gives the same grey as the text of a disabled button at 0.4. The hand goes by itself, as WPF
         shows the cursor of the parent over a disabled element. Under the mouse a link gets lighter;
         in a contrast theme it takes the highlight and a line under it (HoverOutlineBrush), so
         the hover shows by more than color. The links of the design have no line, so without a
         contrast theme that line is transparent. -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource SmallBodySize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="{StaticResource MinClickSize}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid VerticalAlignment="Center" Margin="4,0">
                        <ContentPresenter RecognizesAccessKey="True" />
                        <Border x:Name="Underline" Height="1" VerticalAlignment="Bottom" Background="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Underline" Property="Background" Value="{DynamicResource HoverOutlineBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource LinkHoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A card that opens something (§ 4, § 6): the whole card is the button, so the hover border and the
         focus ring follow the card. Other controls on the card sit beside it, not in it. -->
    <Style x:Key="CardButton" TargetType="Button">
        <Style.Resources>
            <!-- A bulb on the card: its ring on the face of a button (CardLedOffRingBrush). -->
            <Style TargetType="views:LedBulb" BasedOn="{StaticResource {x:Type views:LedBulb}}">
                <Setter Property="OffRingBrush" Value="{DynamicResource CardLedOffRingBrush}" />
            </Style>
        </Style.Resources>
        <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ButtonFaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingCard}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="{StaticResource CardRadius}" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource LinkHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Sliders: a led-off rail, filled up to the thumb in the accent color in Foreground (text by
         default; Rood, Groen and Blauw use their own color, § 5.2). Arrow keys move them. -->
    <Style x:Key="SliderRail" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="6" CornerRadius="3" Background="{TemplateBinding Background}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingButton}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="6" CornerRadius="3" Background="{DynamicResource ControlTrackBrush}" VerticalAlignment="Center" Margin="2,0" />
                        <!-- The ring around the rail, which shows only in a contrast theme, as around a switch that is off. -->
                        <Border Height="6" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource ControlOutlineBrush}" VerticalAlignment="Center" Margin="2,0" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRail}" Command="Slider.DecreaseLarge" Background="{TemplateBinding Foreground}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRail}" Command="Slider.IncreaseLarge" Background="Transparent" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="22" Height="22">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"
                                                     Stroke="{DynamicResource BgBrush}" StrokeThickness="3" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
        <Setter Property="MinHeight" Value="{StaticResource MinClickSize}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Box" CornerRadius="12" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ControlHoverBrush}" />
                        </Trigger>
                        <!-- Typing goes here: the same 2 px text ring as the focus of other controls. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- The box and the first line both sit in the middle of the 32 px of MinHeight: the box
                             (22 px) 5 px from the top, a line of body text (20 px) 6 px. A text over more lines
                             goes on downwards and keeps the box beside its first line. The margins assume the body
                             size; a BulletDecorator does not help: it only moves the box down to a line taller than
                             the box, never a lower line down to the box, so a body text over more lines would sit
                             1 px off and lose its place in the middle of the 32 px. -->
                        <Border x:Name="Box" Width="22" Height="22" CornerRadius="6" BorderThickness="2" VerticalAlignment="Top" Margin="0,5,0,0"
                                BorderBrush="{DynamicResource InputBorderBrush}" Background="Transparent">
                            <Path x:Name="Check" Data="M5,11 L9,15 L17,7" Stretch="None" Margin="-2" Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                        </Border>
                        <!-- A text that does not fit goes on over more lines, such as that of the color loop in a narrow window. -->
                        <ContentPresenter Grid.Column="1" Margin="10,6,0,0" VerticalAlignment="Top" RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <Style TargetType="AccessText">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox: a surface field with a chevron, its list in a surface popup. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Item" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="2" BorderBrush="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource ItemHighlightBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnHighlightTextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Item" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
        <Setter Property="MinHeight" Value="{StaticResource MinClickSize}" />
        <Setter Property="Padding" Value="14,0,44,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Field" CornerRadius="12" BorderThickness="1"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconChevronDown}" HorizontalAlignment="Right" Margin="0,0,12,0"
                                              Stroke="{DynamicResource TextMutedBrush}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource ControlHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <!-- A text in Tag shows while nothing is selected, as a hint what to pick. -->
                        <TextBlock x:Name="Placeholder" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False" TextWrapping="Wrap"
                                   Text="{TemplateBinding Tag}" Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border CornerRadius="12" BorderThickness="1" Padding="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedItem" Value="{x:Null}">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin dark scroll bars. -->
    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" CornerRadius="4" Background="{DynamicResource BorderStrongBrush}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollBarPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollBarPage}" Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollBarPage}" Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollBarThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Margin="2">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarPage}" Command="ScrollBar.PageLeftCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarPage}" Command="ScrollBar.PageRightCommand" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumb}" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="{DynamicResource SubTextSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border MaxWidth="360" Padding="10,6" CornerRadius="10" BorderThickness="1"
                            Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
