<!-- The components of design/DESIGN.md (§ 4) and the dark look of the standard controls, with the
     hover border and focus ring of § 6. The components are in the files that this one merges; what
     is left here are the text roles and the status line, which build on them. Uses the tokens of
     Tokens.xaml. No ContentPresenter recognizes access keys: the app has none, so a "_" in a text,
     as in a zone name of OpenRGB, shows as it is. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:res="clr-namespace:BuurmansRgb.UI.Resources"
                    xmlns:views="clr-namespace:BuurmansRgb.UI.Views">

    <ResourceDictionary.MergedDictionaries>
        <!-- A StaticResource does not look in a file next to its own, so each file merges the tokens, focus
             rings and icons that it uses itself with a StaticResource, and no more: every Source= is a
             copy of its own, so a merge "to be safe" loads a file again. A lookup meets the last file first, and Controls.Cards.xaml
             comes last: the LedBulb style in it and the lookup of a token then find the same brush
             (LedRingStyleTests). -->
        <ResourceDictionary Source="Tokens.xaml" />
        <ResourceDictionary Source="Controls.Focus.xaml" />
        <ResourceDictionary Source="Controls.Icons.xaml" />
        <ResourceDictionary Source="Controls.Window.xaml" />
        <ResourceDictionary Source="Controls.Inputs.xaml" />
        <ResourceDictionary Source="Controls.Buttons.xaml" />
        <ResourceDictionary Source="Controls.Cards.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- § 2 Text roles -->
    <Style x:Key="ScreenTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource ScreenTitleSize}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>
    <Style x:Key="BigValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource BigValueSize}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>
    <Style x:Key="SmallScreenTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource SmallScreenTitleSize}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>
    <!-- A heading goes on over more lines too, such as beside the links of Apparaten. -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource SectionHeaderSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource CardTitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Body text goes on over more lines, as subtext does, when it no longer fits beside its control,
         such as with a larger text size of Windows. -->
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SubText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource SubTextSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Numbers beside a slider, in the mono font. -->
    <Style x:Key="MonoValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="{DynamicResource SmallBodySize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <!-- The status line (Statusregel, DESIGN.md § 4): a card with one message, its action and "Details" that
         unfolds the other messages; Views/StatusLine.xaml puts it together. -->
    <Style x:Key="StatusLineCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="16,10" />
    </Style>
    <Style x:Key="StatusLineText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- A message under "Details": subtext in the text color, so it reads as part of the line. -->
    <Style x:Key="StatusLineDetailText" TargetType="TextBlock" BasedOn="{StaticResource SubText}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- "Details" and "Uitleg": a secondary button that shows it is on while the other messages or the
         explanation are unfolded, like a day of a scene; its state is what a screen reader reads. Nothing
         moves when they unfold. -->
    <Style x:Key="StatusLineDetailsToggle" TargetType="ToggleButton" BasedOn="{StaticResource SecondaryButton}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
