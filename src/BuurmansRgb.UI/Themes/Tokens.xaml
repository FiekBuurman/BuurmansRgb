<!-- The design tokens of design/DESIGN.md (§ 1–3): colors, fonts and sizes. The app is always dark,
     so the LED colors glow; there is no light theme. A contrast theme of Windows replaces the colors
     of text, surfaces, borders and links with its own (ContrastTheme), so the XAML refers to those
     with DynamicResource; the LED colors stay. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- § 1 Colors -->
    <Color x:Key="BgColor">#16161A</Color>
    <Color x:Key="SurfaceColor">#212128</Color>
    <Color x:Key="SurfaceRaisedColor">#24242B</Color>
    <Color x:Key="NavBgColor">#1A1A1F</Color>
    <Color x:Key="BorderColor">#2E2E36</Color>
    <Color x:Key="BorderStrongColor">#4A4A54</Color>
    <Color x:Key="TextColor">#F4F1EA</Color>
    <Color x:Key="TextMutedColor">#A9A6A0</Color>
    <Color x:Key="LedOffColor">#3A3A42</Color>
    <Color x:Key="KnobOffColor">#8C8A85</Color>
    <Color x:Key="PreviewBgColor">#0E0E11</Color>
    <Color x:Key="StripBgColor">#26262D</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="NavBgBrush" Color="{StaticResource NavBgColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="LedOffBrush" Color="{StaticResource LedOffColor}" />
    <SolidColorBrush x:Key="KnobOffBrush" Color="{StaticResource KnobOffColor}" />
    <SolidColorBrush x:Key="PreviewBgBrush" Color="{StaticResource PreviewBgColor}" />
    <SolidColorBrush x:Key="StripBgBrush" Color="{StaticResource StripBgColor}" />

    <!-- The hover border of cards and buttons (§ 6), which is border-strong. -->
    <SolidColorBrush x:Key="HoverBorderBrush" Color="{StaticResource BorderStrongColor}" />

    <!-- The border of a field you type in or pick from, and of a check box: not in the design, whose
         border (1.2:1) and border-strong (1.8:1) do not make a field recognizable. It stands out at
         least 3:1 on bg, surface and preview-bg (WCAG 1.4.11); the focus is the ring of 2 px in text.
         TokenContrastTests checks the ratios. -->
    <Color x:Key="InputBorderColor">#74727A</Color>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}" />
    <!-- The hover of a control whose edge or thumb lights up under the mouse: the border of a field
         and a check box, the dashed border of "+ new" and the thumb of a scroll bar. Text-muted,
         lighter than HoverBorderBrush of cards and buttons. -->
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource TextMutedColor}" />

    <!-- Links, as in the screens of the design. -->
    <SolidColorBrush x:Key="LinkBrush" Color="#7FB0FF" />
    <SolidColorBrush x:Key="LinkHoverBrush" Color="#A9C9FF" />

    <!-- Roles of the colors above that a contrast theme of Windows gives a color of its own
         (ContrastTheme): here they look as the design says. Not the same as TextSelectionBrush
         below, the selected text in a field. -->
    <!-- A selected or hovered item, which a contrast theme gives the highlight, with
         OnHighlightTextBrush (or muted, OnHighlightMutedTextBrush) on it: the page in the menu, an
         item of a list and a button of the title bar under the mouse, or pressed. -->
    <SolidColorBrush x:Key="NavSelectedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="ItemHighlightBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="CaptionPressedBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="OnHighlightTextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="OnHighlightMutedTextBrush" Color="{StaticResource TextMutedColor}" />
    <!-- The close button of the title bar under the mouse: red with a white cross, as in Windows. -->
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="CloseHoverTextBrush" Color="White" />
    <!-- The border of the scene card you edit. -->
    <SolidColorBrush x:Key="EditingCardBorderBrush" Color="{StaticResource BorderStrongColor}" />
    <!-- Buttons (§ 4): a secondary button, an icon button and a card you click are a surface with
         text and a border. A contrast theme gives a button the face and text of a button
         (ButtonFace, ButtonText), as Windows does. -->
    <SolidColorBrush x:Key="ButtonFaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="ButtonTextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource BorderColor}" />
    <!-- The accent: what is primary or on, which a contrast theme gives the highlight, as Windows does.
         Text-colored with bg on it: the primary button, a day that is on and a ticked check box, with
         the text, the tick and the knob of a switch that is on in OnAccentBrush. Under the mouse the
         colors of the primary button swap in a contrast theme; here they are the colors at rest. -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="OnAccentHoverBrush" Color="{StaticResource BgColor}" />
    <!-- The track of a control (§ 4): of a switch that is off, and the rail of a slider beside its
         fill. The cover over the track of a switch that is on shows only in a contrast theme. -->
    <SolidColorBrush x:Key="ControlTrackBrush" Color="{StaticResource LedOffColor}" />
    <SolidColorBrush x:Key="SwitchOnCoverBrush" Color="Transparent" />
    <!-- Outlines: lines that show only in a contrast theme, so they are transparent here. Around the
         track of a switch and the rail of a slider in the text color, and in the highlight on what
         is under the mouse: the ring of the primary button and of a switch, and the line under a
         link. -->
    <SolidColorBrush x:Key="ControlOutlineBrush" Color="Transparent" />
    <SolidColorBrush x:Key="HoverOutlineBrush" Color="Transparent" />

    <!-- The ring of an LED that is off or black, in the bulbs and the preview (LedRing): not in the
         design, where led-off (1.4–1.7:1) and black hardly stand out on bg, surface, preview-bg and
         the strip board. Grey and without a glow, so it does not look like an LED that is on; at
         least 3:1 on those four (WCAG 1.4.11, TokenContrastTests). -->
    <Color x:Key="LedOffRingColor">#7A7880</Color>
    <SolidColorBrush x:Key="LedOffRingBrush" Color="{StaticResource LedOffRingColor}" />
    <!-- The same ring on a card that is a button (CardButton: a device, a scene), which a contrast
         theme gives ButtonFace instead of Window, so the ring takes ButtonText there. -->
    <SolidColorBrush x:Key="CardLedOffRingBrush" Color="{StaticResource LedOffRingColor}" />
    <!-- The same ring on the strip board of Kleur, which stays dark in a contrast theme (content, as
         StripBgBrush): so not in ContrastTheme.SystemBrushes, or the text color of a light theme
         would vanish on it. -->
    <SolidColorBrush x:Key="StripLedOffRingBrush" Color="{StaticResource LedOffRingColor}" />

    <!-- LED colors, with a glow, except black (LedRing.IsDark), which gets the ring instead (LedBulb). -->
    <Color x:Key="LedRedColor">#FF5A5A</Color>
    <Color x:Key="LedYellowColor">#FFD84D</Color>
    <Color x:Key="LedGreenColor">#3DDC84</Color>
    <Color x:Key="LedBlueColor">#5B93FF</Color>

    <SolidColorBrush x:Key="LedRedBrush" Color="{StaticResource LedRedColor}" />
    <SolidColorBrush x:Key="LedYellowBrush" Color="{StaticResource LedYellowColor}" />
    <SolidColorBrush x:Key="LedGreenBrush" Color="{StaticResource LedGreenColor}" />
    <SolidColorBrush x:Key="LedBlueBrush" Color="{StaticResource LedBlueColor}" />

    <!-- The selected text in a field and the warning sign: LED colors here, but no LEDs, so a
         contrast theme gives them a color of its own (ContrastTheme). -->
    <SolidColorBrush x:Key="TextSelectionBrush" Color="{StaticResource LedBlueColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource LedYellowColor}" />

    <!-- § 2 Typography. The fonts ship with the app (Fonts\, SIL Open Font License); the families after
         the first are the fallback of the design. -->
    <FontFamily x:Key="TextFont">pack://application:,,,/BuurmansRgb.UI;component/Fonts/#Bricolage Grotesque, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/BuurmansRgb.UI;component/Fonts/#IBM Plex Mono, Cascadia Mono, Consolas</FontFamily>

    <!-- The sizes of text follow the text size of Windows (TextScale), so the XAML refers to them with
         DynamicResource. The word mark is the logo and keeps its size. -->
    <sys:Double x:Key="ScreenTitleSize">30</sys:Double>
    <sys:Double x:Key="BigValueSize">26</sys:Double>
    <sys:Double x:Key="WordmarkSize">22</sys:Double>
    <sys:Double x:Key="SmallScreenTitleSize">22</sys:Double>
    <sys:Double x:Key="SectionHeaderSize">18</sys:Double>
    <sys:Double x:Key="CardTitleSize">16</sys:Double>
    <sys:Double x:Key="BodySize">15</sys:Double>
    <sys:Double x:Key="SubTextSize">13</sys:Double>
    <sys:Double x:Key="NavLabelSize">12</sys:Double>
    <sys:Double x:Key="HexCodeSize">30</sys:Double>
    <!-- Sizes of the screens of the design outside the type scale: the card title of a scene and the
         text of the primary button (17), of "+ nieuw" (16), smaller body text such as links and the
         numbers beside a slider (14), and the counter of the LEDs of a zone (44). -->
    <sys:Double x:Key="SceneCardTitleSize">17</sys:Double>
    <sys:Double x:Key="PrimaryButtonSize">17</sys:Double>
    <sys:Double x:Key="NewButtonSize">16</sys:Double>
    <sys:Double x:Key="SmallBodySize">14</sys:Double>
    <sys:Double x:Key="CountValueSize">44</sys:Double>

    <!-- § 3 Sizes -->
    <CornerRadius x:Key="LargeCardRadius">22</CornerRadius>
    <CornerRadius x:Key="CardRadius">18</CornerRadius>
    <CornerRadius x:Key="TileRadius">12</CornerRadius>
    <CornerRadius x:Key="StripRadius">8</CornerRadius>
    <!-- Buttons with text are rectangles with the corners of a preset tile, not pills as in § 4: WPF
         turns a radius of half a wide button into an ellipse instead of round ends. -->
    <CornerRadius x:Key="ButtonRadius">12</CornerRadius>
    <sys:Double x:Key="MinClickSize">44</sys:Double>
    <!-- The tiles of the toolbox on Kleur: smaller than MinClickSize, so more colors fit; the handleiding
         names it as a deviation from the design. -->
    <sys:Double x:Key="SmallTileSize">32</sys:Double>
    <CornerRadius x:Key="SmallTileRadius">8</CornerRadius>
    <!-- The page margin on the desktop (§ 6). -->
    <Thickness x:Key="PageMargin">32</Thickness>
    <sys:Double x:Key="PageMaxWidth">1200</sys:Double>
</ResourceDictionary>
