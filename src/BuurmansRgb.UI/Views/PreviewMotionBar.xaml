<!-- Only while "Animatie-effecten" of Windows is off: says that the preview stands still, or that it runs
     anyway, with the button that switches between the two for as long as the app is open. Calm, like the
     PauseBar: it is a choice, not an error. A screen reader reads the line when it changes. The button stays
     where it is with another text, so it keeps the focus. The DataContext is PreviewMotionViewModel. -->
<UserControl x:Class="BuurmansRgb.UI.Views.PreviewMotionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BuurmansRgb.UI.ViewModels"
             xmlns:views="clr-namespace:BuurmansRgb.UI.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PreviewMotionViewModel}"
             Focusable="False"
             Visibility="{Binding IsShown, Converter={StaticResource BoolToVisibility}}">
    <Border Style="{StaticResource Card}" Padding="16,10">
        <DockPanel>
            <Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}"
                    Content="{Binding ButtonText}" ToolTip="{Binding ButtonHelpText}" Command="{Binding ToggleCommand}"
                    AutomationProperties.Name="{Binding ButtonAccessibleName}"
                    AutomationProperties.HelpText="{Binding ButtonHelpText}"
                    AutomationProperties.AutomationId="PreviewMotionButton" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Text, NotifyOnTargetUpdated=True}"
                       AutomationProperties.AutomationId="PreviewMotion" AutomationProperties.LiveSetting="Polite"
                       views:LiveRegion.AnnouncesUpdates="True" />
        </DockPanel>
    </Border>
</UserControl>
