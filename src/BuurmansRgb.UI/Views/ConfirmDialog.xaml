<Window x:Class="BuurmansRgb.UI.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:BuurmansRgb.UI.Resources"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
        FontFamily="{StaticResource TextFont}" FontSize="{StaticResource BodySize}"
        KeyboardNavigation.TabNavigation="Cycle" FocusManager.FocusedElement="{Binding ElementName=CancelButton}"
        PreviewKeyDown="OnPreviewKeyDown">
    <!-- The title bar of our own, as that of MainWindow (§ 6), with only the cross. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <StackPanel MinWidth="380" MaxWidth="460">
        <DockPanel Height="44">
            <Button DockPanel.Dock="Right" Style="{StaticResource CloseCaptionButton}" Click="OnCancelClick"
                    AutomationProperties.Name="{x:Static res:Strings.CaptionClose}" />
            <ContentControl Style="{StaticResource TitleBarLogo}" />
        </DockPanel>

        <StackPanel Margin="24,12,24,24">
            <TextBlock x:Name="QuestionText" Style="{StaticResource SectionHeader}" TextWrapping="Wrap" />
            <TextBlock x:Name="DetailText" Margin="0,8,0,0" Style="{StaticResource SubText}" />
            <!-- Annuleren first, where the focus starts; Enter does the button that has the focus. -->
            <StackPanel Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.Cancel}" Click="OnCancelClick" />
                <Button x:Name="ConfirmButton" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}"
                        MinHeight="{StaticResource MinClickSize}" Padding="20,0" FontSize="{StaticResource BodySize}"
                        Content="{x:Static res:Strings.ConfirmDelete}" Click="OnConfirmClick" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
