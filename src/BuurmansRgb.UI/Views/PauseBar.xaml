<!-- Calm on purpose: a pause is a choice or Windows being locked, not an error. Read out when it changes,
     also when it ends: then it says so for a moment before it goes. The DataContext is EffectsPauseViewModel. -->
<UserControl x:Class="BuurmansRgb.UI.Views.PauseBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:BuurmansRgb.UI.Resources"
             xmlns:vm="clr-namespace:BuurmansRgb.UI.ViewModels"
             xmlns:views="clr-namespace:BuurmansRgb.UI.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EffectsPauseViewModel}"
             Focusable="False"
             Visibility="{Binding IsShown, Converter={StaticResource BoolToVisibility}}">
    <Border Style="{StaticResource Card}" Padding="16,10">
        <DockPanel>
            <Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}"
                    Content="{x:Static res:Strings.ResumeEffects}" ToolTip="{x:Static res:Strings.ResumeEffectsToolTip}"
                    Command="{Binding ResumeCommand}" Click="OnResumeClick"
                    Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{x:Static res:Strings.ResumeEffectsAccessibleName}" />
            <!-- A pause sign drawn as a shape, which a screen reader skips: the text already says it. -->
            <Path DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center" Data="M0,0 H3.5 V12 H0 Z M6.5,0 H10 V12 H6.5 Z"
                  Fill="{DynamicResource TextMutedBrush}"
                  Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Text, NotifyOnTargetUpdated=True}"
                       AutomationProperties.AutomationId="EffectsPause" AutomationProperties.LiveSetting="Polite"
                       views:LiveRegion.AnnouncesUpdates="True" />
        </DockPanel>
    </Border>
</UserControl>
