<!-- Kleur (§ 5.2, § 6 and the layers of § 9), in the order of the effect (§ 9.2): the lamp to change at
     the top; then the effect as tiles; then what belongs to that effect (card 4): the colors of the loop or
     of the effect, or the editor of an own effect, above the mixing panel with left a big preview with the
     strip and the hex code and right the Rood, Groen and Blauw sliders, the presets and the own colors, whose
     color goes on at once (without the design's "Op de strip zetten"); with Regenboog one sentence. Then the
     brightness, speed and direction, "Bewaar als scène", and under "Per apparaat" a card per device with its
     LEDs, the per-LED editor and the zone lengths, closed for "Hele huis" until you open it. -->
<UserControl x:Class="BuurmansRgb.UI.Views.Pages.ColorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:res="clr-namespace:BuurmansRgb.UI.Resources"
             xmlns:vm="clr-namespace:BuurmansRgb.UI.ViewModels"
             xmlns:views="clr-namespace:BuurmansRgb.UI.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <!-- The real devices and the simulated ones each under their own heading; "all devices" has none. -->
        <CollectionViewSource x:Key="GroupedDevices" Source="{Binding Devices}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- Least widths in em of the body text, which a larger text size of Windows makes wider, so
             fewer columns fit and the rest goes under them. A column of the preview and the sliders
             fits the hex code (8.4 em + 54 px) beside "255 · 255 · 255" (7.8 em + 12 px) in the padding
             and border of the preview (38 px), with a little to spare: 358 px at 100 %; the mixing panel
             (ColorMixer) has the same. A column with a value (brightness, speed, direction or, in
             CustomEffectEditor, a time of a step) fits its name beside it: 150 px.
             The title of the page (10 em) keeps 12 em beside the choice of the lamp, and the line of
             the chosen LEDs as much beside Verloop vullen and Selectie opheffen. -->
        <views:EmConverter x:Key="MixColumnWidth" Ems="16.5" Extra="110" />
        <views:EmConverter x:Key="ValueColumnWidth" Ems="10" />
        <views:EmConverter x:Key="HeadingWidth" Ems="12" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource PageMaxWidth}">
            <!-- The title, with the choice of the lamp and its switch beside it, or under it when the text of a
                 larger text size of Windows needs the room. -->
            <views:HeaderPanel Margin="0,0,0,18" MinHeadingWidth="{Binding (TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={StaticResource HeadingWidth}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SmallScreenTitle}" Text="{x:Static res:Strings.ColorPageTitle}" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Style="{StaticResource SubText}">
                        <Run Text="{Binding SelectedDevice.DisplayName, Mode=OneWay}" /> · <Run Text="{Binding SelectedDevice.Details, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <!-- The choice takes the width the page has left beside the switch, so a very long name
                     ends in "…" instead of past the edge of the page. -->
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="DeviceChoice" MinWidth="280" VerticalAlignment="Center"
                              ItemsSource="{Binding Source={StaticResource GroupedDevices}}" SelectedItem="{Binding SelectedDevice}"
                              AutomationProperties.Name="{x:Static res:Strings.LampChoiceLabel}">
                        <!-- The location label tells twins apart, such as the RAM sticks of a kit. On the
                             selected item of the open list it takes the color for muted text there, which
                             a contrast theme makes the text on its highlight: the item takes that template
                             from ItemContainerStyle while it is selected. The selection box has no
                             ComboBoxItem around it, so it shows the template by type; there is no
                             ItemTemplate, which would win over both. -->
                        <ComboBox.Resources>
                            <DataTemplate DataType="{x:Type vm:DeviceItem}">
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="{Binding LocationLabel, Mode=OneWay, StringFormat={}  {0}, TargetNullValue={x:Static sys:String.Empty}}" Foreground="{DynamicResource TextMutedBrush}" />
                                </TextBlock>
                            </DataTemplate>
                            <DataTemplate x:Key="SelectedDeviceTemplate" DataType="{x:Type vm:DeviceItem}">
                                <TextBlock>
                                    <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="{Binding LocationLabel, Mode=OneWay, StringFormat={}  {0}, TargetNullValue={x:Static sys:String.Empty}}" Foreground="{DynamicResource OnHighlightMutedTextBrush}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.Resources>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SelectedDeviceTemplate}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="{x:Null}">
                                                <Setter Property="AutomationProperties.Name" Value="{x:Static res:Strings.AllDevices}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="Heading" Margin="12,10,0,4" Style="{StaticResource SubText}" FontWeight="SemiBold" Text="{Binding Name}" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="{x:Null}">
                                                <Setter TargetName="Heading" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ComboBox.GroupStyle>
                    </ComboBox>
                    <!-- The chosen lamp on or off, or the whole house. -->
                    <views:ToggleSwitch Grid.Column="1" Margin="14,0,0,0" Style="{StaticResource Switch}" IsChecked="{Binding SelectedLamp.IsOn}"
                                  Tag="{Binding SelectedLamp.Color, Converter={StaticResource SwitchTrackBrush}}"
                                  AutomationProperties.Name="{Binding SelectedLamp.SwitchAccessibleName}"
                                  Visibility="{Binding SelectedLamp, Converter={StaticResource NullToCollapsed}}" />
                    <views:ToggleSwitch Grid.Column="1" Margin="14,0,0,0" Style="{StaticResource Switch}" IsChecked="{Binding Lamps.IsAnyOn}" IsEnabled="{Binding Lamps.HasLamps}"
                                  AutomationProperties.Name="{x:Static res:Strings.WholeHouseSwitchAccessibleName}"
                                  Visibility="{Binding SelectedLamp, Converter={StaticResource NullToVisible}}" />
                </Grid>
            </views:HeaderPanel>

            <!-- One message at most (the connection gone, a pause, the preview still), the rest under Details. -->
            <views:StatusLine Margin="0,0,0,14" DataContext="{Binding StatusLine}" />

            <!-- First the effect (§ 9.2 and 9.3): a tile per effect, "Eigen effect" as the last, one group of
                 radio buttons with one Tab stop. Under it what the chosen effect does, and always
                 "Importeren…" and "Code plakken", which bring in scenes too (besluit 10). -->
            <Border Style="{StaticResource LargeCard}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,12" Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.EffectHeader}" AutomationProperties.HeadingLevel="Level2" />
                    <views:EffectTileGroup x:Name="EffectTiles" ItemsSource="{Binding EffectTiles.Tiles}" Focusable="True" IsTabStop="False" FocusVisualStyle="{x:Null}"
                                           KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle"
                                           AutomationProperties.Name="{x:Static res:Strings.EffectHeader}">
                        <views:EffectTileGroup.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </views:EffectTileGroup.ItemsPanel>
                        <views:EffectTileGroup.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EffectTileItem}">
                                <views:EffectTile Margin="0,0,10,10" Style="{StaticResource EffectTile}" Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsChosen, Mode=OneWay}" CanChoose="{Binding CanChoose}"
                                                  Command="{Binding DataContext.EffectTiles.ChooseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"
                                                  AutomationProperties.Name="{Binding DisplayName}" AutomationProperties.HelpText="{Binding HelpText}"
                                                  AutomationProperties.PositionInSet="{Binding Position}" AutomationProperties.SizeOfSet="{Binding SetSize}" />
                            </DataTemplate>
                        </views:EffectTileGroup.ItemTemplate>
                    </views:EffectTileGroup>
                    <!-- What the chosen effect does, in one sentence. Underneath, hidden, every sentence keeps the
                         room of the longest, so the links and the cards below do not move with another effect.
                         A screen reader hears it as the help of each tile. -->
                    <Grid>
                        <views:DecorativeItemsControl ItemsSource="{Binding Effects}" Focusable="False" IsTabStop="False" Visibility="Hidden">
                            <views:DecorativeItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid />
                                </ItemsPanelTemplate>
                            </views:DecorativeItemsControl.ItemsPanel>
                            <views:DecorativeItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:EffectOption">
                                    <TextBlock Style="{StaticResource SubText}" Text="{Binding Description}" />
                                </DataTemplate>
                            </views:DecorativeItemsControl.ItemTemplate>
                        </views:DecorativeItemsControl>
                        <TextBlock Style="{StaticResource SubText}" Text="{Binding SelectedEffect.Description}" />
                    </Grid>
                    <!-- An own effect or a scene of someone else, from a file or a code (SharingViewModel); a scene
                         that comes this way shows on Scènes. -->
                    <WrapPanel>
                        <views:LinkButton Margin="0,4,18,0" Content="{x:Static res:Strings.ShareImport}"
                                ToolTip="{x:Static res:Strings.ShareImportToolTip}"
                                AutomationProperties.Name="{x:Static res:Strings.ShareImportAccessibleName}"
                                Command="{Binding Sharing.ImportCommand}" />
                        <views:LinkButton Margin="0,4,0,0" Content="{x:Static res:Strings.SharePasteCode}"
                                ToolTip="{x:Static res:Strings.SharePasteCodeToolTip}"
                                AutomationProperties.Name="{x:Static res:Strings.SharePasteCodeAccessibleName}"
                                Command="{Binding Sharing.PasteCodeCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Then what belongs to the effect (§ 9.2, ColorCard): its heading says what is in it. With chosen
                 LEDs, whatever the effect, the color for those LEDs; else the colors of the loop or of the
                 effect, "Jouw effect", where to choose LEDs, or with Regenboog one sentence. Under it the mixing
                 panel, always there where there is something to mix (besluit 2). -->
            <Border Margin="0,14,0,0" Style="{StaticResource LargeCard}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,12" Style="{StaticResource SectionHeader}" Text="{Binding ColorCardHeader}" AutomationProperties.HeadingLevel="Level2" />

                    <!-- Which LEDs get the mixed color, with Verloop vullen and Selectie opheffen on its right, or
                         under it when the text of a larger text size of Windows needs the room. Selectie opheffen
                         hides this, and then the focus goes to the chosen effect tile. -->
                    <views:HeaderPanel Margin="0,0,0,14" MinHeadingWidth="{Binding (TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={StaticResource HeadingWidth}}"
                                       Visibility="{Binding LedEditor.HasSelection, Converter={StaticResource BoolToVisibility}}"
                                       views:FocusFallback.Target="{Binding ElementName=EffectTiles}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Body}" Text="{Binding LedEditor.SelectionText}" />
                            <TextBlock Style="{StaticResource SubText}" Text="{Binding LedEditor.SelectionHint}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.FillGradient}"
                                    ToolTip="{x:Static res:Strings.FillGradientToolTip}" Command="{Binding FillGradientCommand}" />
                            <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.ClearLedSelection}"
                                    Command="{Binding ClearLedSelectionCommand}" />
                        </StackPanel>
                    </views:HeaderPanel>

                    <!-- Where the mixed color goes (DESIGN.md § 4, Kleur in lagen): "Per LED", the per-LED effect, or
                         "Als laag boven het effect", a fixed color over any effect; two round toggles as the pace of
                         Tellen, each its own Tab stop, grouped by their panel: a GroupName would join those of another
                         ColorPage in the same window. The panel is a ChoiceGroup, so a screen reader hears them as
                         the group "Waar komt de kleur?". Laag weghalen is always there, grey with its tooltip while no
                         chosen LED has a layer. Hidden with the selection, as the panel above. -->
                    <StackPanel Margin="0,0,0,14" Visibility="{Binding LedEditor.HasSelection, Converter={StaticResource BoolToVisibility}}"
                                views:FocusFallback.Target="{Binding ElementName=EffectTiles}">
                        <TextBlock Style="{StaticResource SubText}" Text="{x:Static res:Strings.LedPaintModeLabel}" />
                        <WrapPanel Margin="0,4,0,0">
                            <views:ChoiceGroup x:Name="LedPaintMode" Margin="0,0,18,8" Orientation="Horizontal"
                                               AutomationProperties.Name="{x:Static res:Strings.LedPaintModeLabel}">
                                <RadioButton x:Name="PaintPerLed" Margin="0,0,6,0" Style="{StaticResource DayToggle}"
                                             Content="{x:Static res:Strings.LedPaintPerLed}" IsChecked="{Binding LedEditor.PaintsPerLed}"
                                             ToolTip="{x:Static res:Strings.LedPaintPerLedHelp}"
                                             AutomationProperties.Name="{x:Static res:Strings.LedPaintPerLed}"
                                             AutomationProperties.HelpText="{x:Static res:Strings.LedPaintPerLedHelp}" />
                                <RadioButton x:Name="PaintLayer" Style="{StaticResource DayToggle}"
                                             Content="{x:Static res:Strings.LedPaintLayer}" IsChecked="{Binding LedEditor.PaintsLayer}"
                                             ToolTip="{x:Static res:Strings.LedPaintLayerHelp}"
                                             AutomationProperties.Name="{x:Static res:Strings.LedPaintLayer}"
                                             AutomationProperties.HelpText="{x:Static res:Strings.LedPaintLayerHelp}" />
                            </views:ChoiceGroup>
                            <Button x:Name="RemoveLayerButton" Margin="0,0,0,8" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.RemoveLayer}"
                                    ToolTip="{x:Static res:Strings.RemoveLayerToolTip}" ToolTipService.ShowOnDisabled="True"
                                    AutomationProperties.HelpText="{x:Static res:Strings.RemoveLayerToolTip}"
                                    Command="{Binding RemoveLayerCommand}" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- With the color loop, the mixed color goes to the chosen color of the loop. -->
                    <StackPanel Margin="0,0,0,14" Visibility="{Binding ShowsColorLoopList, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource SubText}" Text="{x:Static res:Strings.ColorLoopHint}" />
                        <views:ColorListEditor Margin="0,12,0,0" DataContext="{Binding ColorLoopEditor}" ListName="{x:Static res:Strings.ColorLoopHeader}" />
                        <CheckBox Margin="0,4,0,0" IsChecked="{Binding ColorLoopEditor.Spread}" Content="{x:Static res:Strings.ColorLoopSpread}" />
                    </StackPanel>

                    <!-- With comet, scanner, twinkle or fire, the mixed color goes to the chosen color of its list. -->
                    <StackPanel Margin="0,0,0,14" Visibility="{Binding ShowsEffectColorsList, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource SubText}" Text="{Binding EffectColorsHint}" />
                        <views:ColorListEditor Margin="0,12,0,0" DataContext="{Binding EffectColorsEditor}" ListName="{x:Static res:Strings.EffectColorsHeader}" />
                        <!-- Back to the lamp color, or the warm colors of the fire; only with a list of its own. -->
                        <Button Margin="0,4,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"
                                Content="{x:Static res:Strings.EffectColorsDefault}" ToolTip="{x:Static res:Strings.EffectColorsDefaultToolTip}"
                                ToolTipService.ShowOnDisabled="True" Command="{Binding ResetEffectColorsCommand}" />
                    </StackPanel>

                    <!-- "Jouw effect" (CustomEffectEditor). When it hides with the focus in it, such as after deleting
                         the effect, the focus goes to the chosen effect tile. -->
                    <views:CustomEffectEditor Margin="0,0,0,14" Visibility="{Binding ShowsCustomEffectCard, Converter={StaticResource BoolToVisibility}}"
                                              views:FocusFallback.Target="{Binding ElementName=EffectTiles}" />

                    <!-- Per LED without chosen LEDs: where to choose them, and a jump to "Per apparaat". -->
                    <StackPanel Margin="0,0,0,14" Visibility="{Binding ShowsPerLedHint, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Body}" FontWeight="Normal" Text="{x:Static res:Strings.PerLedHint}" />
                        <views:LinkButton HorizontalAlignment="Left" Content="{x:Static res:Strings.GoToDevices}" ToolTip="{x:Static res:Strings.GoToDevicesToolTip}"
                                          Click="OnGoToDevicesClick" />
                    </StackPanel>

                    <!-- Regenboog makes its own colors: nothing to mix, one sentence instead. -->
                    <TextBlock Style="{StaticResource Body}" FontWeight="Normal" Text="{Binding NoColorText}"
                               Visibility="{Binding ShowsNoColor, Converter={StaticResource BoolToVisibility}}" />

                    <!-- The mixing panel (ColorMixer). -->
                    <views:ColorMixer Visibility="{Binding ShowsMixer, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- How bright and how fast: brightness, speed and, for the effects that run over the LEDs, the
                 direction; three columns, or fewer when the text of a larger text size of Windows needs the room. -->
            <Border Margin="0,14,0,0" Style="{StaticResource LargeCard}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,14" Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.BrightnessSpeedHeader}" AutomationProperties.HeadingLevel="Level2" />
                    <views:CardGrid MaxColumns="3" Gap="24" MinColumnWidth="{Binding (TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={StaticResource ValueColumnWidth}}">
                        <views:ValueSlider Label="{x:Static res:Strings.BrightnessHeader}" ValueText="{Binding Brightness, StringFormat={}{0:0}%}"
                                           Minimum="0" Maximum="100" Value="{Binding Brightness}" SmallChange="1" LargeChange="10" TickFrequency="1" />
                        <StackPanel>
                            <views:ValueSlider Label="{x:Static res:Strings.SpeedHeader}" ValueText="{Binding Speed, StringFormat={}{0:0}%}" IsEnabled="{Binding IsSpeedEnabled}"
                                               Minimum="{x:Static vm:MainViewModel.MinSpeed}" Maximum="{x:Static vm:MainViewModel.MaxSpeed}"
                                               Value="{Binding Speed}" SmallChange="5" LargeChange="25" TickFrequency="5" />
                            <TextBlock Style="{StaticResource SubText}" Text="{x:Static res:Strings.SpeedOnlyAnimated}"
                                       Visibility="{Binding IsSpeedEnabled, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                        <!-- Only for the effects that run over the LEDs; the arrow points the way, 0° to the right. -->
                        <StackPanel Visibility="{Binding IsDirectionVisible, Converter={StaticResource BoolToVisibility}}">
                            <!-- The help is the tooltip of the slider too. Its AutomationId stays DirectionSlider. -->
                            <views:ValueSlider x:Name="DirectionSlider" Label="{x:Static res:Strings.DirectionHeader}" ValueText="{Binding DirectionText}"
                                               HelpText="{x:Static res:Strings.DirectionHelp}" ItemStatus="{Binding DirectionText}"
                                               Minimum="{x:Static vm:MainViewModel.MinDirection}" Maximum="{x:Static vm:MainViewModel.MaxDirection}"
                                               Value="{Binding Direction}" SmallChange="5" LargeChange="45" TickFrequency="1"
                                               PreviewKeyDown="OnDirectionKeyDown" Thumb.DragCompleted="OnDirectionThumbDragCompleted">
                                <views:ValueSlider.ValueIcon>
                                    <!-- An arrow drawn as a shape, which a screen reader skips: the degrees already say it. -->
                                    <Path Margin="0,0,8,0" VerticalAlignment="Center" Width="12" Height="12"
                                          Data="M1,6 H11 M7,2 L11,6 L7,10" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5"
                                          Visibility="{Binding HasDirection, Converter={StaticResource BoolToVisibility}}">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="{Binding Direction}" />
                                        </Path.RenderTransform>
                                    </Path>
                                </views:ValueSlider.ValueIcon>
                            </views:ValueSlider>
                            <views:LinkButton Margin="0,4,0,0" HorizontalAlignment="Left"
                                    Content="{x:Static res:Strings.DirectionClear}" Command="{Binding ClearDirectionCommand}"
                                    AutomationProperties.Name="{x:Static res:Strings.DirectionClearAccessibleName}"
                                    Visibility="{Binding HasDirection, Converter={StaticResource BoolToVisibility}}"
                                    views:FocusFallback.Target="{Binding Slider, ElementName=DirectionSlider}" />
                        </StackPanel>
                    </views:CardGrid>
                </StackPanel>
            </Border>

            <!-- The lighting of all devices as a scene, without going to Scènes, with the name card of "+ Nieuwe
                 scène" under it while naming; in a column as wide as one of the mixing panel. -->
            <views:CardGrid Margin="0,14,0,0" MaxColumns="2" Gap="24" MinColumnWidth="{Binding (TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={StaticResource MixColumnWidth}}">
                <StackPanel>
                    <Button x:Name="SaveAsScene" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"
                            Content="{x:Static res:Strings.SaveAsScene}" ToolTip="{x:Static res:Strings.NewSceneHint}" ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.HelpText="{x:Static res:Strings.NewSceneHint}"
                            Command="{Binding Profiles.StartNewCommand}" Click="OnSaveAsSceneClick"
                            Visibility="{Binding Profiles.IsNaming, Converter={StaticResource InverseBoolToVisibility}}" />
                    <views:SceneNameCard x:Name="SceneName" ReturnFocusTo="{Binding ElementName=SaveAsScene}" />
                </StackPanel>
            </views:CardGrid>

            <views:LedPreviewPanel x:Name="DevicesPanel" Margin="0,28,0,0" ReturnFocusTo="{Binding ElementName=DeviceChoice}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
