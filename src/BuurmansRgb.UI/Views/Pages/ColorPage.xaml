<!-- Kleur mengen (§ 5.2 and § 6): the lamp to change at the top; left a big preview with the strip and the
     hex code, and under it the colors of the loop or of the effect, or the editor of an own effect; right the
     Rood, Groen and Blauw sliders, the presets and "Op de strip zetten". Below them the
     brightness, effect, speed and direction of the lamp, and the preview of its LEDs with the per-LED editor
     and the zone lengths. -->
<UserControl x:Class="BuurmansRgb.UI.Views.Pages.ColorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:res="clr-namespace:BuurmansRgb.UI.Resources"
             xmlns:vm="clr-namespace:BuurmansRgb.UI.ViewModels"
             xmlns:views="clr-namespace:BuurmansRgb.UI.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <!-- The real devices and the simulated ones each under their own heading; "all devices" has none. -->
        <CollectionViewSource x:Key="GroupedDevices" Source="{Binding Devices}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- The twelve bulbs of the strip in the preview. -->
        <x:Array x:Key="StripBulbs" Type="sys:Int32">
            <sys:Int32>1</sys:Int32><sys:Int32>2</sys:Int32><sys:Int32>3</sys:Int32><sys:Int32>4</sys:Int32>
            <sys:Int32>5</sys:Int32><sys:Int32>6</sys:Int32><sys:Int32>7</sys:Int32><sys:Int32>8</sys:Int32>
            <sys:Int32>9</sys:Int32><sys:Int32>10</sys:Int32><sys:Int32>11</sys:Int32><sys:Int32>12</sys:Int32>
        </x:Array>

        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- The hex code in the preview, in the mono font of the design; typing a code mixes that color. -->
        <Style x:Key="HexBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="{StaticResource HexCodeSize}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="-6,0,0,0" />
            <Setter Property="MaxLength" Value="7" />
        </Style>

        <!-- A tile of the toolbox, of a preset or an own color: shows its Color under its Name, a click
             mixes it, and it is marked when it is the mixed color. -->
        <Style x:Key="ToolboxTile" TargetType="Button" BasedOn="{StaticResource SmallPresetTile}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="{Binding Color, Converter={StaticResource ColorToBrush}}" />
            <Setter Property="ToolTip" Value="{Binding Name}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Command" Value="{Binding DataContext.ColorPicker.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="CommandParameter" Value="{Binding Color}" />
            <Setter Property="Tag">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource EqualValues}">
                        <Binding Path="Color" />
                        <Binding Path="DataContext.ColorPicker.Color" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource PageMaxWidth}">
            <DockPanel Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox MinWidth="280" VerticalAlignment="Center"
                              ItemsSource="{Binding Source={StaticResource GroupedDevices}}" SelectedItem="{Binding SelectedDevice}"
                              AutomationProperties.Name="{x:Static res:Strings.LampChoiceLabel}">
                        <!-- The location label tells twins apart, such as the RAM sticks of a kit. -->
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DeviceItem}">
                                <TextBlock>
                                    <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="{Binding LocationLabel, Mode=OneWay, StringFormat={}  {0}, TargetNullValue={x:Static sys:String.Empty}}" Foreground="{StaticResource TextMutedBrush}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="{x:Null}">
                                                <Setter Property="AutomationProperties.Name" Value="{x:Static res:Strings.AllDevices}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="Heading" Margin="12,10,0,4" Style="{StaticResource SubText}" FontWeight="SemiBold" Text="{Binding Name}" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="{x:Null}">
                                                <Setter TargetName="Heading" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ComboBox.GroupStyle>
                    </ComboBox>
                    <!-- The chosen lamp on or off, or the whole house. -->
                    <ToggleButton Margin="14,0,0,0" Style="{StaticResource Switch}" IsChecked="{Binding SelectedLamp.IsOn}"
                                  Tag="{Binding SelectedLamp.Color, Converter={StaticResource SwitchTrackBrush}}"
                                  AutomationProperties.Name="{Binding SelectedLamp.SwitchAccessibleName}"
                                  Visibility="{Binding SelectedLamp, Converter={StaticResource NullToCollapsed}}" />
                    <ToggleButton Margin="14,0,0,0" Style="{StaticResource Switch}" IsChecked="{Binding Lamps.IsAnyOn}" IsEnabled="{Binding Lamps.HasLamps}"
                                  AutomationProperties.Name="{x:Static res:Strings.WholeHouseSwitchAccessibleName}"
                                  Visibility="{Binding SelectedLamp, Converter={StaticResource NullToVisible}}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource SmallScreenTitle}" Text="{x:Static res:Strings.ColorPageTitle}" />
                    <TextBlock Style="{StaticResource SubText}">
                        <Run Text="{Binding SelectedDevice.DisplayName, Mode=OneWay}" /> · <Run Text="{Binding SelectedDevice.Details, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <views:PauseBar Margin="0,0,0,14" DataContext="{Binding EffectsPause}" />

            <!-- While LEDs are chosen in the preview, the mixed color goes to those LEDs. -->
            <Border Margin="0,0,0,14" Style="{StaticResource Card}"
                    Visibility="{Binding LedEditor.HasSelection, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.FillGradient}"
                                ToolTip="{x:Static res:Strings.FillGradientToolTip}" Command="{Binding FillGradientCommand}" />
                        <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.ClearLedSelection}"
                                Command="{Binding ClearLedSelectionCommand}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Body}" Text="{Binding LedEditor.SelectionText}" />
                        <TextBlock Style="{StaticResource SubText}" Text="{x:Static res:Strings.LedSelectionHint}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Style="{StaticResource LargeCard}" Background="{StaticResource PreviewBgBrush}" Padding="18,26,18,20"
                            AutomationProperties.Name="{x:Static res:Strings.ColorPreviewAccessibleName}">
                        <StackPanel>
                            <Border Style="{StaticResource StripBoard}">
                                <ItemsControl ItemsSource="{StaticResource StripBulbs}" Focusable="False" IsTabStop="False" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <views:LedBulb Diameter="12" GlowBlur="14" GlowSpread="4"
                                                           Color="{Binding DataContext.ColorPicker.Color, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <DockPanel Margin="0,22,0,0">
                                <TextBlock DockPanel.Dock="Right" Margin="12,0,0,8" VerticalAlignment="Bottom" Style="{StaticResource MonoValue}" FontSize="13"
                                           Text="{Binding ColorPicker.RgbText}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SubText}" Text="{x:Static res:Strings.CurrentColorLabel}" />
                                    <TextBox Style="{StaticResource HexBox}" Text="{Binding ColorPicker.HexColor, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{x:Static res:Strings.HexLabel}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource SubText}" Text="{x:Static res:Strings.ColorNotApplied}"
                                       Visibility="{Binding ColorPicker.HasUnappliedChange, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!-- With the color loop, the mixed color goes to the chosen color of the loop. -->
                    <Border Margin="0,14,0,0" Style="{StaticResource LargeCard}"
                            Visibility="{Binding IsColorLoop, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}" Text="{x:Static res:Strings.ColorLoopHeader}" />
                            <TextBlock Style="{StaticResource SubText}" Text="{x:Static res:Strings.ColorLoopHint}" />
                            <views:ColorListEditor Margin="0,12,0,0" DataContext="{Binding ColorLoopEditor}" />
                            <CheckBox Margin="0,4,0,0" IsChecked="{Binding ColorLoopEditor.Spread}" Content="{x:Static res:Strings.ColorLoopSpread}" />
                        </StackPanel>
                    </Border>

                    <!-- With comet, scanner, twinkle or fire, the mixed color goes to the chosen color of its list. -->
                    <Border Margin="0,14,0,0" Style="{StaticResource LargeCard}"
                            Visibility="{Binding HasEffectColors, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}" Text="{x:Static res:Strings.EffectColorsHeader}" />
                            <TextBlock Style="{StaticResource SubText}" Text="{Binding EffectColorsHint}" />
                            <views:ColorListEditor Margin="0,12,0,0" DataContext="{Binding EffectColorsEditor}" />
                            <!-- Back to the lamp color, or the warm colors of the fire; only with a list of its own. -->
                            <Button Margin="0,4,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"
                                    Content="{x:Static res:Strings.EffectColorsDefault}" ToolTip="{x:Static res:Strings.EffectColorsDefaultToolTip}"
                                    ToolTipService.ShowOnDisabled="True" Command="{Binding ResetEffectColorsCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- With an own effect: its name, its steps and the times of the chosen step; the mixed color goes
                         to that step. Deleting it hides the panel, and the focus goes to the effect choice. -->
                    <Border x:Name="CustomEffectPanel" Margin="0,14,0,0" Style="{StaticResource LargeCard}"
                            Visibility="{Binding IsCustomEffect, Converter={StaticResource BoolToVisibility}}"
                            views:FocusFallback.Target="{Binding ElementName=EffectChoice}">
                        <StackPanel DataContext="{Binding CustomEffectEditor}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.CustomEffectDelete}"
                                        ToolTip="{x:Static res:Strings.CustomEffectDeleteToolTip}" Command="{Binding DeleteCommand}"
                                        AutomationProperties.Name="{x:Static res:Strings.CustomEffectDeleteAccessibleName}" />
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource Body}" Text="{x:Static res:Strings.CustomEffectHeader}" />
                            </DockPanel>
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource SubText}" TextWrapping="Wrap" Text="{x:Static res:Strings.CustomEffectHint}" />

                            <TextBlock Margin="0,12,0,0" Style="{StaticResource Label}" Text="{x:Static res:Strings.CustomEffectNameLabel}" />
                            <!-- The name counts when the box loses the focus, or with Enter. -->
                            <TextBox Text="{Binding Name}" MaxLength="40" KeyDown="OnCustomEffectNameKeyDown"
                                     AutomationProperties.Name="{x:Static res:Strings.CustomEffectNameAccessibleName}" />
                            <DockPanel Margin="0,6,0,0" Visibility="{Binding NameError, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource WarningMark}" AutomationProperties.Name="{x:Static res:Strings.Warning}" />
                                <TextBlock TextWrapping="Wrap" Text="{Binding NameError, NotifyOnTargetUpdated=True}"
                                           AutomationProperties.LiveSetting="Polite" views:LiveRegion.AnnouncesUpdates="True" />
                            </DockPanel>

                            <TextBlock Margin="0,12,0,0" Style="{StaticResource Label}" Text="{x:Static res:Strings.CustomEffectStepsLabel}" />
                            <!-- Rows of at most six tiles, as the color lists; a pattern shows as a gradient. -->
                            <WrapPanel>
                                <ItemsControl x:Name="StepTiles" Style="{StaticResource ColorTileList}" ItemsSource="{Binding Steps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CustomEffectStepItem}">
                                            <Button Style="{StaticResource ColorListTile}" Background="{Binding Colors, Converter={StaticResource ColorsToBrush}}"
                                                    AutomationProperties.HelpText="{x:Static res:Strings.CustomEffectStepHelp}"
                                                    Command="{Binding DataContext.SelectStepCommand, ElementName=StepTiles}"
                                                    CommandParameter="{Binding Index}" PreviewKeyDown="OnStepKeyDown" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource ColorListButton}" Content="+"
                                        ToolTip="{x:Static res:Strings.CustomEffectStepAdd}" AutomationProperties.Name="{x:Static res:Strings.CustomEffectStepAdd}"
                                        Command="{Binding AddStepCommand}" Click="OnStepButtonClick" />
                                <Button Style="{StaticResource ColorListButton}" Content="−"
                                        ToolTip="{x:Static res:Strings.CustomEffectStepRemove}" AutomationProperties.Name="{x:Static res:Strings.CustomEffectStepRemove}"
                                        Command="{Binding RemoveStepCommand}" Click="OnStepButtonClick" />
                                <Button Style="{StaticResource ColorListButton}" Content="←"
                                        ToolTip="{x:Static res:Strings.CustomEffectStepEarlier}" AutomationProperties.Name="{x:Static res:Strings.CustomEffectStepEarlier}"
                                        Command="{Binding MoveStepEarlierCommand}" Click="OnStepButtonClick" />
                                <Button Style="{StaticResource ColorListButton}" Content="→"
                                        ToolTip="{x:Static res:Strings.CustomEffectStepLater}" AutomationProperties.Name="{x:Static res:Strings.CustomEffectStepLater}"
                                        Command="{Binding MoveStepLaterCommand}" Click="OnStepButtonClick" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource SubText}" Text="{Binding SelectedStepText}" />
                            <Button Margin="0,4,0,0" HorizontalAlignment="Left" Style="{StaticResource LinkButton}"
                                    Content="{x:Static res:Strings.CustomEffectTakePattern}" ToolTip="{x:Static res:Strings.CustomEffectTakePatternToolTip}"
                                    ToolTipService.ShowOnDisabled="True"
                                    Command="{Binding DataContext.TakeLedPatternCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoValue}" Text="{Binding HoldText}" />
                                <TextBlock Style="{StaticResource Label}" Text="{x:Static res:Strings.CustomEffectHold}" />
                            </DockPanel>
                            <Slider Minimum="{x:Static vm:CustomEffectEditorViewModel.MinSeconds}" Maximum="{x:Static vm:CustomEffectEditorViewModel.MaxSeconds}"
                                    Value="{Binding HoldSeconds}" SmallChange="0.1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="0.1"
                                    AutomationProperties.Name="{x:Static res:Strings.CustomEffectHold}" AutomationProperties.ItemStatus="{Binding HoldText}" />
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoValue}" Text="{Binding FadeText}" />
                                <TextBlock Style="{StaticResource Label}" Text="{x:Static res:Strings.CustomEffectFade}" />
                            </DockPanel>
                            <Slider Minimum="{x:Static vm:CustomEffectEditorViewModel.MinSeconds}" Maximum="{x:Static vm:CustomEffectEditorViewModel.MaxSeconds}"
                                    Value="{Binding FadeSeconds}" SmallChange="0.1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="0.1"
                                    AutomationProperties.Name="{x:Static res:Strings.CustomEffectFade}" AutomationProperties.ItemStatus="{Binding FadeText}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoValue}" Text="{Binding ColorPicker.Red, StringFormat={}{0:0}}" />
                        <TextBlock Style="{StaticResource Label}" Text="{x:Static res:Strings.ChannelRed}" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="255" Value="{Binding ColorPicker.Red}" SmallChange="1" LargeChange="16" IsSnapToTickEnabled="True" TickFrequency="1"
                            Foreground="{StaticResource LedRedBrush}" AutomationProperties.Name="{x:Static res:Strings.ChannelRed}" />
                    <DockPanel Margin="0,14,0,0">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoValue}" Text="{Binding ColorPicker.Green, StringFormat={}{0:0}}" />
                        <TextBlock Style="{StaticResource Label}" Text="{x:Static res:Strings.ChannelGreen}" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="255" Value="{Binding ColorPicker.Green}" SmallChange="1" LargeChange="16" IsSnapToTickEnabled="True" TickFrequency="1"
                            Foreground="{StaticResource LedGreenBrush}" AutomationProperties.Name="{x:Static res:Strings.ChannelGreen}" />
                    <DockPanel Margin="0,14,0,0">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoValue}" Text="{Binding ColorPicker.Blue, StringFormat={}{0:0}}" />
                        <TextBlock Style="{StaticResource Label}" Text="{x:Static res:Strings.ChannelBlue}" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="255" Value="{Binding ColorPicker.Blue}" SmallChange="1" LargeChange="16" IsSnapToTickEnabled="True" TickFrequency="1"
                            Foreground="{StaticResource LedBlueBrush}" AutomationProperties.Name="{x:Static res:Strings.ChannelBlue}" />

                    <TextBlock Margin="0,18,0,10" Style="{StaticResource SubText}" Text="{x:Static res:Strings.ToolboxHeader}" />
                    <!-- Squares of 32 px, 8 apart, instead of the 44 px of the design: the nine fit one row. -->
                    <ItemsControl ItemsSource="{x:Static vm:ColorPickerViewModel.Presets}" Focusable="False" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ColorPreset}">
                                <Button Style="{StaticResource ToolboxTile}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- The own colors, kept by the engine: "+" first, so the tiles after it wrap within the
                         column; a click mixes one, Delete or its context menu takes it away. -->
                    <TextBlock Margin="0,10,0,10" Style="{StaticResource SubText}" Text="{x:Static res:Strings.CustomColorsHeader}" />
                    <DockPanel>
                        <Button x:Name="AddCustomColor" DockPanel.Dock="Left" Margin="0,0,8,8" VerticalAlignment="Top" Style="{StaticResource AddTile}" Content="+"
                                ToolTip="{x:Static res:Strings.CustomColorsAddToolTip}" ToolTipService.ShowOnDisabled="True"
                                AutomationProperties.Name="{x:Static res:Strings.CustomColorsAdd}"
                                Command="{Binding CustomColors.AddCommand}" Click="OnAddCustomColorClick" />
                        <ItemsControl x:Name="CustomColorTiles" ItemsSource="{Binding CustomColors.Colors}" Focusable="False" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CustomColorItem}">
                                    <Button Style="{StaticResource ToolboxTile}" AutomationProperties.HelpText="{x:Static res:Strings.CustomColorHelp}"
                                            PreviewKeyDown="OnCustomColorKeyDown" views:FocusKeeper.Key="{Binding FocusKey}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{x:Static res:Strings.CustomColorRemove}" Click="OnRemoveCustomColorClick" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>

                    <!-- Only for the color of the whole lamp: a color of a list or of chosen LEDs changes at once. -->
                    <Button Margin="0,12,0,0" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}" Content="{x:Static res:Strings.ApplyColor}"
                            Command="{Binding ColorPicker.ApplyCommand}"
                            Visibility="{Binding ColorPicker.AppliesAtOnce, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
            </Grid>

            <!-- How the lamp shines: brightness, effect, speed and direction. -->
            <Border Margin="0,24,0,0" Style="{StaticResource LargeCard}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,14" Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.LightingHeader}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoValue}" Text="{Binding Brightness, StringFormat={}{0:0}%}" />
                                <TextBlock Style="{StaticResource Label}" Text="{x:Static res:Strings.BrightnessHeader}" />
                            </DockPanel>
                            <Slider Minimum="0" Maximum="100" Value="{Binding Brightness}" SmallChange="1" LargeChange="10"
                                    IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="{x:Static res:Strings.BrightnessHeader}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="{x:Static res:Strings.EffectHeader}" />
                            <ComboBox x:Name="EffectChoice" ItemsSource="{Binding Effects}" SelectedItem="{Binding SelectedEffect}" DisplayMemberPath="DisplayName"
                                      AutomationProperties.Name="{x:Static res:Strings.EffectHeader}" />
                            <!-- A new own effect of steps, which the editor above then shows. -->
                            <Button Margin="0,4,0,0" HorizontalAlignment="Left" Style="{StaticResource LinkButton}"
                                    Content="{x:Static res:Strings.CustomEffectNew}" ToolTip="{x:Static res:Strings.CustomEffectNewToolTip}"
                                    ToolTipService.ShowOnDisabled="True" Command="{Binding NewCustomEffectCommand}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <DockPanel IsEnabled="{Binding IsSpeedEnabled}">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoValue}" Text="{Binding Speed, StringFormat={}{0:0}%}" />
                                <TextBlock Style="{StaticResource Label}" Text="{x:Static res:Strings.SpeedHeader}" />
                            </DockPanel>
                            <Slider Minimum="{x:Static vm:MainViewModel.MinSpeed}" Maximum="{x:Static vm:MainViewModel.MaxSpeed}"
                                    Value="{Binding Speed}" SmallChange="5" LargeChange="25" IsSnapToTickEnabled="True" TickFrequency="5"
                                    IsEnabled="{Binding IsSpeedEnabled}" AutomationProperties.Name="{x:Static res:Strings.SpeedHeader}" />
                            <TextBlock Style="{StaticResource SubText}" Text="{x:Static res:Strings.SpeedOnlyAnimated}"
                                       Visibility="{Binding IsSpeedEnabled, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                        <!-- Only for the effects that run over the LEDs; the arrow points the way, 0° to the right. -->
                        <StackPanel Grid.Column="6" Visibility="{Binding IsDirectionVisible, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoValue}" Text="{Binding DirectionText}" />
                                <!-- An arrow drawn as a shape, which a screen reader skips: the degrees already say it. -->
                                <Path DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center" Width="12" Height="12"
                                      Data="M1,6 H11 M7,2 L11,6 L7,10" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5"
                                      Visibility="{Binding HasDirection, Converter={StaticResource BoolToVisibility}}">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="{Binding Direction}" />
                                    </Path.RenderTransform>
                                </Path>
                                <TextBlock Style="{StaticResource Label}" Text="{x:Static res:Strings.DirectionHeader}" />
                            </DockPanel>
                            <Slider x:Name="DirectionSlider" Minimum="{x:Static vm:MainViewModel.MinDirection}" Maximum="{x:Static vm:MainViewModel.MaxDirection}"
                                    Value="{Binding Direction}" SmallChange="5" LargeChange="45" IsSnapToTickEnabled="True" TickFrequency="1"
                                    AutomationProperties.Name="{x:Static res:Strings.DirectionHeader}"
                                    AutomationProperties.HelpText="{x:Static res:Strings.DirectionHelp}"
                                    AutomationProperties.ItemStatus="{Binding DirectionText}"
                                    ToolTip="{x:Static res:Strings.DirectionHelp}"
                                    PreviewKeyDown="OnDirectionKeyDown" Thumb.DragCompleted="OnDirectionThumbDragCompleted" />
                            <Button Margin="0,4,0,0" HorizontalAlignment="Left" Style="{StaticResource LinkButton}"
                                    Content="{x:Static res:Strings.DirectionClear}" Command="{Binding ClearDirectionCommand}"
                                    AutomationProperties.Name="{x:Static res:Strings.DirectionClearAccessibleName}"
                                    Visibility="{Binding HasDirection, Converter={StaticResource BoolToVisibility}}"
                                    views:FocusFallback.Target="{Binding ElementName=DirectionSlider}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <views:LedPreviewPanel Margin="0,28,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
