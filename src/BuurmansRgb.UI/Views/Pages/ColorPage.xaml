<!-- Kleur mengen: the lamp to change, its color, brightness, effect and speed, and the preview of its LEDs
     with the per-LED editor and the zone lengths. -->
<UserControl x:Class="BuurmansRgb.UI.Views.Pages.ColorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:BuurmansRgb.UI.Resources"
             xmlns:vm="clr-namespace:BuurmansRgb.UI.ViewModels"
             xmlns:views="clr-namespace:BuurmansRgb.UI.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <!-- The real devices and the simulated ones each under their own heading; "all devices" has none. -->
        <CollectionViewSource x:Key="GroupedDevices" Source="{Binding Devices}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource PageMaxWidth}">
            <DockPanel Margin="0,0,0,18">
                <ComboBox DockPanel.Dock="Right" MinWidth="280" VerticalAlignment="Center"
                          ItemsSource="{Binding Source={StaticResource GroupedDevices}}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name"
                          AutomationProperties.Name="{x:Static res:Strings.LampChoiceLabel}">
                    <ComboBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="Heading" Margin="12,10,0,4" Style="{StaticResource SubText}" Text="{Binding Name}" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Name}" Value="{x:Null}">
                                            <Setter TargetName="Heading" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ComboBox.GroupStyle>
                </ComboBox>
                <StackPanel>
                    <TextBlock Style="{StaticResource SmallScreenTitle}" Text="{x:Static res:Strings.ColorPageTitle}" />
                    <TextBlock Style="{StaticResource SubText}" Text="{Binding SelectedDevice.Name}" />
                </StackPanel>
            </DockPanel>

            <views:PauseBar Margin="0,0,0,14" DataContext="{Binding EffectsPause}" />

            <Border Margin="0,0,0,14" Style="{StaticResource Card}"
                    Visibility="{Binding LedEditor.HasSelection, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.FillGradient}"
                                ToolTip="{x:Static res:Strings.FillGradientToolTip}" Command="{Binding FillGradientCommand}" />
                        <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.ClearLedSelection}"
                                Command="{Binding ClearLedSelectionCommand}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Body}" Text="{Binding LedEditor.SelectionText}" />
                        <TextBlock Style="{StaticResource SubText}" Text="{x:Static res:Strings.LedSelectionHint}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource LargeCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,0,0,12" Text="{x:Static res:Strings.ColorHeader}" />
                    <StackPanel Orientation="Horizontal">
                        <Border Width="48" Height="48" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                Background="{Binding ColorPicker.Color, Converter={StaticResource ColorToBrush}}" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SubText}" Text="{x:Static res:Strings.HexLabel}" />
                            <TextBox Width="120" Text="{Binding ColorPicker.HexColor, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{x:Static res:Strings.HexLabel}" />
                        </StackPanel>
                    </StackPanel>

                    <ItemsControl Margin="0,12,0,0" ItemsSource="{x:Static vm:ColorPickerViewModel.Presets}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ColorPreset}">
                                <Button Width="44" Margin="0,0,8,8" Style="{StaticResource PresetTile}"
                                        Background="{Binding Color, Converter={StaticResource ColorToBrush}}"
                                        ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                        Command="{Binding DataContext.ColorPicker.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Color}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Label}" Margin="0,8,0,6" Text="{x:Static res:Strings.HueLabel}" />
                    <Slider Minimum="0" Maximum="360" Value="{Binding ColorPicker.Hue}" SmallChange="1" LargeChange="15"
                            AutomationProperties.Name="{x:Static res:Strings.HueLabel}" />
                    <TextBlock Style="{StaticResource Label}" Margin="0,12,0,6" Text="{x:Static res:Strings.SaturationLabel}" />
                    <Slider Minimum="0" Maximum="100" Value="{Binding ColorPicker.Saturation}" SmallChange="1" LargeChange="10"
                            Foreground="{Binding ColorPicker.HueColor, Converter={StaticResource ColorToBrush}}"
                            AutomationProperties.Name="{x:Static res:Strings.SaturationLabel}" />

                    <!-- With the color loop, the picker above colors the selected color of the loop. -->
                    <StackPanel Margin="0,18,0,0" Visibility="{Binding IsColorLoop, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Body}" Text="{x:Static res:Strings.ColorLoopHeader}" />
                        <TextBlock Style="{StaticResource SubText}" Text="{x:Static res:Strings.ColorLoopHint}" />
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding ColorLoopEditor.Swatches}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ColorLoopSwatch}">
                                        <Button Width="44" Margin="0,0,8,0" Style="{StaticResource PresetTile}" Tag="{Binding IsSelected}"
                                                Background="{Binding Color, Converter={StaticResource ColorToBrush}}"
                                                ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                                Command="{Binding DataContext.ColorLoopEditor.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Index}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Margin="0,0,8,0" Style="{StaticResource IconButton}" Content="+"
                                    ToolTip="{x:Static res:Strings.ColorLoopAdd}" AutomationProperties.Name="{x:Static res:Strings.ColorLoopAdd}"
                                    Command="{Binding ColorLoopEditor.AddColorCommand}" />
                            <Button Style="{StaticResource IconButton}" Content="−"
                                    ToolTip="{x:Static res:Strings.ColorLoopRemove}" AutomationProperties.Name="{x:Static res:Strings.ColorLoopRemove}"
                                    Command="{Binding ColorLoopEditor.RemoveColorCommand}" />
                        </StackPanel>
                        <CheckBox Margin="0,10,0,0" IsChecked="{Binding ColorLoopEditor.Spread}" Content="{x:Static res:Strings.ColorLoopSpread}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,14,0,0" Style="{StaticResource LargeCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoValue}" Text="{Binding Brightness, StringFormat={}{0:0} %}" />
                            <TextBlock Style="{StaticResource Label}" Text="{x:Static res:Strings.BrightnessHeader}" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="100" Value="{Binding Brightness}" SmallChange="1" LargeChange="10"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                AutomationProperties.Name="{x:Static res:Strings.BrightnessHeader}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Label}" Text="{x:Static res:Strings.EffectHeader}" />
                        <ComboBox ItemsSource="{Binding Effects}" SelectedItem="{Binding SelectedEffect}" DisplayMemberPath="DisplayName"
                                  AutomationProperties.Name="{x:Static res:Strings.EffectHeader}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <DockPanel IsEnabled="{Binding IsSpeedEnabled}">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoValue}" Text="{Binding Speed, StringFormat={}{0:0} %}" />
                            <TextBlock Style="{StaticResource Label}" Text="{x:Static res:Strings.SpeedHeader}" />
                        </DockPanel>
                        <Slider Minimum="{x:Static vm:MainViewModel.MinSpeed}" Maximum="{x:Static vm:MainViewModel.MaxSpeed}"
                                Value="{Binding Speed}" SmallChange="5" LargeChange="25" IsSnapToTickEnabled="True" TickFrequency="5"
                                IsEnabled="{Binding IsSpeedEnabled}" AutomationProperties.Name="{x:Static res:Strings.SpeedHeader}" />
                        <TextBlock Style="{StaticResource SubText}" Text="{x:Static res:Strings.SpeedOnlyAnimated}"
                                   Visibility="{Binding IsSpeedEnabled, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <views:LedPreviewPanel Margin="0,24,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
