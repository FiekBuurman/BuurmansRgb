<!-- Lampen (§ 5.1 and § 6): the whole house with how many lamps are on and what they show, then every
     lamp as a card, the real ones and the simulated ones each under their own heading. A card opens
     the lamp on the Kleur page; its switch puts it on or off. "Verversen" at the heading is not in
     the design (see docs/handleiding.md). -->
<UserControl x:Class="BuurmansRgb.UI.Views.Pages.LampsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:BuurmansRgb.UI.Resources"
             xmlns:vm="clr-namespace:BuurmansRgb.UI.ViewModels"
             xmlns:views="clr-namespace:BuurmansRgb.UI.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedLamps" Source="{Binding Lamps.Lamps}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Device.Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource PageMaxWidth}">
            <!-- The word mark, and how buurmansRgb gets on with OpenRGB: whether the real lamps can come. -->
            <DockPanel Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SubText}" VerticalAlignment="Center" Text="{Binding OpenRgbStatus.Text, NotifyOnTargetUpdated=True}"
                               ToolTip="{Binding OpenRgbStatus.Hint}" AutomationProperties.HelpText="{Binding OpenRgbStatus.Hint}"
                               AutomationProperties.AutomationId="OpenRgbStatus" AutomationProperties.LiveSetting="Polite"
                               views:LiveRegion.AnnouncesUpdates="True" />
                    <TextBlock Margin="8,0,0,0" Style="{StaticResource InfoMark}" Tag="{Binding OpenRgbStatus.Hint}"
                               Visibility="{Binding OpenRgbStatus.HasHint, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.Name="{x:Static res:Strings.OpenRgbHintAccessibleName}" />
                </StackPanel>
                <ContentControl Style="{StaticResource Wordmark}" VerticalAlignment="Center" />
            </DockPanel>

            <views:PauseBar Margin="0,0,0,16" DataContext="{Binding EffectsPause}" />

            <!-- Hele huis: how many lamps are on, a big switch for all of them, and a strip with what they show now. -->
            <Border Style="{StaticResource LargeCard}">
                <StackPanel>
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource LargeSwitch}" IsChecked="{Binding Lamps.IsAnyOn}"
                                      IsEnabled="{Binding Lamps.HasLamps}"
                                      AutomationProperties.Name="{x:Static res:Strings.WholeHouseSwitchAccessibleName}"
                                      AutomationProperties.HelpText="{Binding Lamps.Summary}" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubText}" Text="{x:Static res:Strings.WholeHouse}" />
                            <TextBlock Style="{StaticResource BigValue}" Text="{Binding Lamps.Summary}" AutomationProperties.AutomationId="WholeHouseSummary" />
                        </StackPanel>
                    </DockPanel>
                    <views:DecorativeItemsControl Margin="4,18,4,6" ItemsSource="{Binding Lamps.Strip}" Focusable="False" IsTabStop="False">
                        <views:DecorativeItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </views:DecorativeItemsControl.ItemsPanel>
                        <views:DecorativeItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StripLed}">
                                <views:LedBulb Diameter="12" GlowBlur="10" GlowSpread="2" IsLit="{Binding IsLit}"
                                               Color="{Binding Color}" />
                            </DataTemplate>
                        </views:DecorativeItemsControl.ItemTemplate>
                    </views:DecorativeItemsControl>
                </StackPanel>
            </Border>

            <!-- "Verversen" lets OpenRGB search again and says "Zoeken…" meanwhile; it stays enabled, so
                 the keyboard focus stays on it, and a second click while it searches does nothing. -->
            <DockPanel Margin="0,22,0,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Margin="0,0,12,0" Style="{StaticResource LinkButton}" Content="{Binding DeviceRescan.ButtonText}"
                            ToolTip="{x:Static res:Strings.RescanToolTip}" AutomationProperties.HelpText="{x:Static res:Strings.RescanToolTip}"
                            AutomationProperties.Name="{Binding DeviceRescan.ButtonText}" AutomationProperties.AutomationId="RescanDevices"
                            Command="{Binding DeviceRescan.RescanCommand}" />
                    <Button Style="{StaticResource LinkButton}" Content="{x:Static res:Strings.AddLamps}"
                            ToolTip="{x:Static res:Strings.AddLampsToolTip}" AutomationProperties.HelpText="{x:Static res:Strings.AddLampsToolTip}"
                            Command="{Binding Navigation.GoToCommand}" CommandParameter="{x:Static vm:AppPage.Settings}" />
                </StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" VerticalAlignment="Center" Text="{x:Static res:Strings.LampsHeader}" />
            </DockPanel>

            <!-- What the last search left to say, read out by a screen reader when it appears. -->
            <TextBlock Margin="0,4,0,0" Style="{StaticResource SubText}" TextWrapping="Wrap"
                       Text="{Binding DeviceRescan.Message, NotifyOnTargetUpdated=True}"
                       Visibility="{Binding DeviceRescan.HasMessage, Converter={StaticResource BoolToVisibility}}"
                       AutomationProperties.AutomationId="RescanMessage" AutomationProperties.LiveSetting="Polite"
                       views:LiveRegion.AnnouncesUpdates="True" />

            <TextBlock Margin="0,8,0,0" Style="{StaticResource SubText}" Text="{x:Static res:Strings.NoLamps}"
                       Visibility="{Binding Lamps.HasLamps, Converter={StaticResource InverseBoolToVisibility}}" />

            <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedLamps}}" Focusable="False" IsTabStop="False">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <StackPanel>
                                                <ContentPresenter />
                                                <ItemsPresenter />
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,14,0,10" Style="{StaticResource SubText}" FontWeight="SemiBold" Text="{Binding Name}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <!-- Within each group: two or three lamps side by side, after the width. -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <views:CardGrid MinColumnWidth="280" MaxColumns="3" Gap="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LampItem}">
                        <!-- The card itself opens the lamp; its switch sits on it, after it for the keyboard.
                             The tooltip sits on its content, not on the button: WPF reads the tooltip of a
                             button without help text out as its help text, so the name would sound twice.
                             It fills the whole card, padding included, so the edge of the card and the strip
                             that a taller card in the same row adds show the tooltip too. -->
                        <Grid>
                            <Button Style="{StaticResource CardButton}" Padding="0" VerticalContentAlignment="Stretch"
                                    Command="{Binding DataContext.Lamps.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding OpenAccessibleName}"
                                    AutomationProperties.HelpText="{Binding Device.AccessibleHelpText}">
                                <Border Background="Transparent" Padding="16,14,82,14" ToolTip="{Binding Device.CardToolTip}">
                                    <DockPanel VerticalAlignment="Center">
                                        <views:LedBulb DockPanel.Dock="Left" Margin="0,0,14,0" VerticalAlignment="Center" Diameter="38" GlowBlur="16" GlowSpread="2"
                                                       IsLit="{Binding IsOn}" Color="{Binding Color}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Device.Name}" />
                                            <TextBlock Style="{StaticResource SubText}" Text="{Binding Details}" />
                                            <TextBlock Style="{StaticResource SubText}" Text="{Binding Device.LocationLabel}"
                                                       Visibility="{Binding Device.ShowsLocationLabel, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Style="{StaticResource SubText}" ToolTip="{x:Static res:Strings.NoDirectModeHint}"
                                                       Visibility="{Binding Device.LacksDirectMode, Converter={StaticResource BoolToVisibility}}">
                                                <Run Text="⚠" FontFamily="Segoe UI Symbol" Foreground="{StaticResource LedYellowBrush}" /> <Run Text="{x:Static res:Strings.NoDirectModeWarning}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Button>
                            <ToggleButton Margin="0,0,16,0" HorizontalAlignment="Right" Style="{StaticResource Switch}" IsChecked="{Binding IsOn}"
                                          Tag="{Binding Color, Converter={StaticResource SwitchTrackBrush}}"
                                          AutomationProperties.Name="{Binding SwitchAccessibleName}"
                                          AutomationProperties.HelpText="{Binding Details}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
