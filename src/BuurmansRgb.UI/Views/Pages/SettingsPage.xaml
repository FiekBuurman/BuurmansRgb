<!-- Instellingen: what the devices do while the pc sleeps or is locked, what comes back after a restart,
     how buurmansRgb gets on with OpenRGB, what the engine uses, when the simulated devices show, the effects,
     the scene times, the hotkeys and "Starten met Windows", saving and restoring the settings, the log of the engine
     and the folder with the settings, and at the bottom the version and the guide. Whether saving
     worked is in the status line of MainWindow. -->
<UserControl x:Class="BuurmansRgb.UI.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:BuurmansRgb.UI.Resources"
             xmlns:vm="clr-namespace:BuurmansRgb.UI.ViewModels"
             xmlns:views="clr-namespace:BuurmansRgb.UI.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <!-- The width of a choice, in em of its text: 240 and 300 px at 100 %, wider with a larger text
             size of Windows, so the longest option still fits. -->
        <views:EmConverter x:Key="NarrowChoiceWidth" Ems="16" />
        <views:EmConverter x:Key="ChoiceWidth" Ems="20" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource PageMaxWidth}">
            <TextBlock Style="{StaticResource ScreenTitle}" Text="{x:Static res:Strings.SettingsTitle}" />
            <TextBlock Margin="0,2,0,22" Style="{StaticResource SubText}" Text="{x:Static res:Strings.SettingsSubtitle}" />

            <!-- Where the other pages put their cards, but no wider than a line of text reads well. -->
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                <!-- What the devices do while the pc sleeps or is locked (pausedLights), first, as it is what most
                     people look for here. The pause it only counts under, which also rests the effects, comes
                     first in the block, as the switch the choice depends on. The choice is grey while that pause
                     is off, and a line under it, also in its help text for a screen reader, says why. A heading
                     for a screen reader. -->
                <Border Style="{StaticResource LargeCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.SleepHeader}"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <DockPanel Margin="0,12,0,0">
                            <ToggleButton DockPanel.Dock="Right" Margin="14,0,0,0" VerticalAlignment="Top" Style="{StaticResource Switch}"
                                          IsChecked="{Binding EffectOptions.PauseOnLockAndSleep}"
                                          AutomationProperties.Name="{x:Static res:Strings.PauseOnLockLabel}"
                                          AutomationProperties.HelpText="{x:Static res:Strings.PauseOnLockHint}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}" Text="{x:Static res:Strings.PauseOnLockLabel}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource SubText}" Text="{x:Static res:Strings.PauseOnLockHint}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Margin="0,18,0,12" Style="{StaticResource SubText}" Text="{x:Static res:Strings.PausedLightsHint}" />
                        <ComboBox Width="{Binding FontSize, RelativeSource={RelativeSource Self}, Converter={StaticResource NarrowChoiceWidth}}" HorizontalAlignment="Left" ItemsSource="{x:Static vm:EffectOptionsViewModel.PausedLightsOptions}" DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding EffectOptions.SelectedPausedLights}"
                                  IsEnabled="{Binding EffectOptions.PauseOnLockAndSleep}"
                                  AutomationProperties.Name="{x:Static res:Strings.SleepHeader}"
                                  AutomationProperties.HelpText="{Binding EffectOptions.PausedLightsHelpText}"
                                  AutomationProperties.AutomationId="PausedLights" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource SubText}" TextWrapping="Wrap" Text="{x:Static res:Strings.PausedLightsNeedsPause}"
                                   AutomationProperties.AutomationId="PausedLightsNeedsPause"
                                   Visibility="{Binding EffectOptions.PauseOnLockAndSleep, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </Border>
                <!-- What comes back after a restart (AfterRestartViewModel): what the engine keeps in settings.json and puts
                     back when it starts, following the scene that is on, the choice above and "Starten met Windows" as they
                     change. Not a live region: a screen reader reads it when it gets there. Without "Starten met Windows" it
                     says the lighting does not come back by itself, with a button that does what the switch under "Opstarten"
                     does; when the button goes, the focus goes to that switch, which then says it is on. A heading for a
                     screen reader. -->
                <Border Margin="0,14,0,0" Style="{StaticResource LargeCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.AfterRestartHeader}"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Margin="0,8,0,2" Style="{StaticResource SubText}" TextWrapping="Wrap" Text="{x:Static res:Strings.AfterRestartIntro}" />
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Left" Margin="0,0,8,0" Style="{StaticResource Body}" Text="•" />
                            <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Text="{Binding AfterRestart.LightingText}" AutomationProperties.AutomationId="AfterRestartLighting" />
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Left" Margin="0,0,8,0" Style="{StaticResource Body}" Text="•" />
                            <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Text="{x:Static res:Strings.AfterRestartBrightness}" />
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Left" Margin="0,0,8,0" Style="{StaticResource Body}" Text="•" />
                            <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Text="{Binding AfterRestart.SleepText}" AutomationProperties.AutomationId="AfterRestartSleep" />
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource SubText}" TextWrapping="Wrap" Text="{x:Static res:Strings.AfterRestartSceneTimes}"
                                   AutomationProperties.AutomationId="AfterRestartSceneTimes"
                                   Visibility="{Binding AfterRestart.CatchesUpSceneTimes, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource Body}" TextWrapping="Wrap" Text="{Binding AfterRestart.AutoStartText}"
                                   AutomationProperties.AutomationId="AfterRestartAutoStart" />
                        <Button Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.AfterRestartTurnOnAutoStart}"
                                Command="{Binding AfterRestart.TurnOnAutoStartCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.AfterRestartTurnOnAutoStart}"
                                AutomationProperties.HelpText="{Binding AfterRestart.AutoStartText}"
                                AutomationProperties.AutomationId="AfterRestartTurnOnAutoStart"
                                Visibility="{Binding AfterRestart.StartsWithWindows, Converter={StaticResource InverseBoolToVisibility}}"
                                views:FocusFallback.Target="{Binding ElementName=AutoStartSwitch}" />
                    </StackPanel>
                </Border>

                <!-- Whether the real devices can come: the state in plain words, read out when it changes, with the
                     technical status (OpenRGB, its SDK server) and the tip spelled out under it and behind the ⓘ,
                     and "Herstarten" as beside the status on Apparaten. -->
                <Border Margin="0,14,0,0" Style="{StaticResource LargeCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SubText}" Text="{x:Static res:Strings.OpenRgbHeader}" />
                        <DockPanel Margin="0,2,0,0">
                            <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" Style="{StaticResource InfoMark}" Tag="{Binding OpenRgbStatus.ToolTip}"
                                       Visibility="{Binding OpenRgbStatus.HasHint, Converter={StaticResource BoolToVisibility}}"
                                       AutomationProperties.Name="{x:Static res:Strings.OpenRgbHintAccessibleName}" />
                            <TextBlock Style="{StaticResource SectionHeader}" TextWrapping="Wrap" Text="{Binding OpenRgbStatus.Text, NotifyOnTargetUpdated=True}"
                                       ToolTip="{Binding OpenRgbStatus.ToolTip}" AutomationProperties.HelpText="{Binding OpenRgbStatus.ToolTip}"
                                       AutomationProperties.AutomationId="OpenRgbStatus" AutomationProperties.LiveSetting="Polite"
                                       views:LiveRegion.AnnouncesUpdates="True" />
                        </DockPanel>
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource SubText}" Text="{Binding OpenRgbStatus.TechnicalText}"
                                   AutomationProperties.AutomationId="OpenRgbTechnical" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource SubText}" Text="{Binding OpenRgbStatus.Hint}"
                                   Visibility="{Binding OpenRgbStatus.HasHint, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource SubText}" TextWrapping="Wrap" Text="{x:Static res:Strings.OpenRgbExplanation}" />
                        <Button Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.RestartEngine}"
                                ToolTip="{x:Static res:Strings.RestartEngineToolTip}" AutomationProperties.HelpText="{x:Static res:Strings.RestartEngineToolTip}"
                                AutomationProperties.Name="{x:Static res:Strings.RestartEngineAccessibleName}" AutomationProperties.AutomationId="RestartEngine"
                                Command="{Binding OpenRgbStatus.RestartCommand}"
                                Visibility="{Binding OpenRgbStatus.CanRestart, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- What the engine uses now, read by the app every 2 s only while this page shows
                     (EngineUsageViewModel). Not a live region: a screen reader reads it when it gets
                     there, not at every reading. -->
                <Border Margin="0,14,0,0" Style="{StaticResource LargeCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.UsageHeader}" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Body}" TextWrapping="Wrap" Text="{Binding EngineUsage.Text}"
                                   AutomationProperties.HelpText="{x:Static res:Strings.UsageHint}"
                                   AutomationProperties.AutomationId="EngineUsage" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource SubText}" Text="{x:Static res:Strings.UsageHint}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Style="{StaticResource LargeCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.SimulatedDevicesHeader}" />
                        <TextBlock Margin="0,4,0,12" Style="{StaticResource SubText}" Text="{x:Static res:Strings.SimulatedDevicesHint}" />
                        <ComboBox Width="{Binding FontSize, RelativeSource={RelativeSource Self}, Converter={StaticResource NarrowChoiceWidth}}" HorizontalAlignment="Left" ItemsSource="{x:Static vm:SimulatedDevicesViewModel.Options}" DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SimulatedDevices.SelectedOption}"
                                  AutomationProperties.Name="{x:Static res:Strings.SimulatedDevicesLabel}"
                                  AutomationProperties.HelpText="{x:Static res:Strings.SimulatedDevicesHint}" />
                    </StackPanel>
                </Border>

                <!-- How smooth the effects move. -->
                <Border Margin="0,14,0,0" Style="{StaticResource LargeCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.EffectOptionsHeader}" />
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource Body}" Text="{x:Static res:Strings.FrameRateLabel}" />
                        <TextBlock Margin="0,2,0,8" Style="{StaticResource SubText}" Text="{x:Static res:Strings.FrameRateHint}" />
                        <ComboBox Width="{Binding FontSize, RelativeSource={RelativeSource Self}, Converter={StaticResource ChoiceWidth}}" HorizontalAlignment="Left" ItemsSource="{Binding EffectOptions.FrameRates}" DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding EffectOptions.SelectedFrameRate}"
                                  AutomationProperties.Name="{x:Static res:Strings.FrameRateLabel}"
                                  AutomationProperties.HelpText="{x:Static res:Strings.FrameRateHint}" />
                    </StackPanel>
                </Border>

                <!-- Whether a scene time that passed while the pc slept or the engine did not run comes on after all. -->
                <Border Margin="0,14,0,0" Style="{StaticResource LargeCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.SceneTimesHeader}" />
                        <DockPanel Margin="0,12,0,0">
                            <ToggleButton DockPanel.Dock="Right" Margin="14,0,0,0" VerticalAlignment="Top" Style="{StaticResource Switch}"
                                          IsChecked="{Binding SceneTimes.IsOn}"
                                          AutomationProperties.Name="{x:Static res:Strings.CatchUpLabel}"
                                          AutomationProperties.HelpText="{x:Static res:Strings.CatchUpHint}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}" Text="{x:Static res:Strings.CatchUpLabel}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource SubText}" Text="{x:Static res:Strings.CatchUpHint}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Whether the fixed keys of "Alles aan" and "Alles uit" in the tray menu work anywhere in Windows. -->
                <Border Margin="0,14,0,0" Style="{StaticResource LargeCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.HotkeysHeader}" />
                        <DockPanel Margin="0,12,0,0">
                            <ToggleButton DockPanel.Dock="Right" Margin="14,0,0,0" VerticalAlignment="Top" Style="{StaticResource Switch}"
                                          IsChecked="{Binding Hotkeys.IsOn}"
                                          AutomationProperties.Name="{x:Static res:Strings.HotkeysLabel}"
                                          AutomationProperties.HelpText="{x:Static res:Strings.HotkeysHint}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}" Text="{x:Static res:Strings.HotkeysLabel}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource SubText}" Text="{x:Static res:Strings.HotkeysHint}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- "Starten met Windows", the same as in the tray menu; the engine keeps it, so both show the same. -->
                <Border Margin="0,14,0,0" Style="{StaticResource LargeCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.AutoStartHeader}" />
                        <DockPanel Margin="0,12,0,0">
                            <ToggleButton x:Name="AutoStartSwitch" DockPanel.Dock="Right" Margin="14,0,0,0" VerticalAlignment="Top" Style="{StaticResource Switch}"
                                          IsChecked="{Binding AutoStart.IsOn}"
                                          AutomationProperties.Name="{x:Static res:Strings.AutoStartLabel}"
                                          AutomationProperties.HelpText="{x:Static res:Strings.AutoStartHint}"
                                          AutomationProperties.AutomationId="AutoStart" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}" Text="{x:Static res:Strings.AutoStartLabel}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource SubText}" Text="{x:Static res:Strings.AutoStartHint}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- The settings, scenes and own effects in one zip, and back: through the engine, so only while
                     the app is connected (SettingsBackupViewModel). Restoring asks first (ConfirmDialog). -->
                <Border Margin="0,14,0,0" Style="{StaticResource LargeCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.BackupHeader}" />
                        <TextBlock Margin="0,4,0,2" Style="{StaticResource SubText}" Text="{x:Static res:Strings.BackupHint}" />
                        <WrapPanel>
                            <Button Margin="0,10,10,0" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.BackupSave}"
                                    Command="{Binding Backup.SaveCommand}"
                                    ToolTip="{x:Static res:Strings.BackupSaveHint}"
                                    AutomationProperties.Name="{x:Static res:Strings.BackupSave}"
                                    AutomationProperties.HelpText="{x:Static res:Strings.BackupSaveHint}" />
                            <Button Margin="0,10,0,0" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.BackupRestore}"
                                    Command="{Binding Backup.RestoreCommand}"
                                    ToolTip="{x:Static res:Strings.BackupRestoreHint}"
                                    AutomationProperties.Name="{x:Static res:Strings.BackupRestore}"
                                    AutomationProperties.HelpText="{x:Static res:Strings.BackupRestoreHint}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- "Logbestand openen", as in the tray menu: engine.log in the app that opens .log files; and
                     the folder with it and the settings files in Verkenner. Side by side, under each other
                     when the text size of Windows makes them too wide. -->
                <Border Margin="0,14,0,0" Style="{StaticResource LargeCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.LogHeader}" />
                        <TextBlock Margin="0,4,0,2" Style="{StaticResource SubText}" Text="{x:Static res:Strings.LogHint}" />
                        <WrapPanel>
                            <Button Margin="0,10,10,0" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.OpenLog}"
                                    Command="{Binding AppInfo.OpenLogCommand}"
                                    AutomationProperties.Name="{x:Static res:Strings.OpenLog}"
                                    AutomationProperties.HelpText="{x:Static res:Strings.LogHint}" />
                            <Button Margin="0,10,0,0" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.OpenDataFolder}"
                                    Command="{Binding AppInfo.OpenDataFolderCommand}"
                                    ToolTip="{x:Static res:Strings.DataFolderHint}"
                                    AutomationProperties.Name="{x:Static res:Strings.OpenDataFolder}"
                                    AutomationProperties.HelpText="{x:Static res:Strings.DataFolderHint}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- At the very bottom, under the cards: the version and the guide, a link in the style of Verversen
                     that only shows when there is a guide to open (AppInfoViewModel.GuideAddress). -->
                <StackPanel Margin="4,14,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource SubText}" Text="{Binding AppInfo.VersionText}"
                               AutomationProperties.AutomationId="AppVersion" />
                    <Button Margin="12,0,0,0" Style="{StaticResource LinkButton}" Content="{x:Static res:Strings.GuideLink}"
                            Command="{Binding AppInfo.OpenGuideCommand}"
                            Visibility="{Binding AppInfo.HasGuide, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="{x:Static res:Strings.GuideLink}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
