<!-- Instellingen: how buurmansRgb gets on with OpenRGB, when the simulated lamps show, the effects,
     the scene times, the hotkeys and "Starten met Windows", the log of the engine, and at the bottom
     the version and the guide. Whether saving worked is in the status line of MainWindow. -->
<UserControl x:Class="BuurmansRgb.UI.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:BuurmansRgb.UI.Resources"
             xmlns:vm="clr-namespace:BuurmansRgb.UI.ViewModels"
             xmlns:views="clr-namespace:BuurmansRgb.UI.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource PageMaxWidth}">
            <TextBlock Style="{StaticResource ScreenTitle}" Text="{x:Static res:Strings.SettingsTitle}" />
            <TextBlock Margin="0,2,0,22" Style="{StaticResource SubText}" Text="{x:Static res:Strings.SettingsSubtitle}" />

            <!-- Where the other pages put their cards, but no wider than a line of text reads well. -->
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                <!-- Whether the real lamps can come: the state of OpenRGB in one line, read out when it changes,
                     with the tip in view and behind the ⓘ. -->
                <Border Style="{StaticResource LargeCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SubText}" Text="{x:Static res:Strings.OpenRgbHeader}" />
                        <DockPanel Margin="0,2,0,0">
                            <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" Style="{StaticResource InfoMark}" Tag="{Binding OpenRgbStatus.Hint}"
                                       Visibility="{Binding OpenRgbStatus.HasHint, Converter={StaticResource BoolToVisibility}}"
                                       AutomationProperties.Name="{x:Static res:Strings.OpenRgbHintAccessibleName}" />
                            <TextBlock Style="{StaticResource SectionHeader}" TextWrapping="Wrap" Text="{Binding OpenRgbStatus.Text, NotifyOnTargetUpdated=True}"
                                       ToolTip="{Binding OpenRgbStatus.Hint}" AutomationProperties.HelpText="{Binding OpenRgbStatus.Hint}"
                                       AutomationProperties.AutomationId="OpenRgbStatus" AutomationProperties.LiveSetting="Polite"
                                       views:LiveRegion.AnnouncesUpdates="True" />
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource SubText}" Text="{Binding OpenRgbStatus.Hint}"
                                   Visibility="{Binding OpenRgbStatus.HasHint, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource SubText}" Text="{x:Static res:Strings.OpenRgbExplanation}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Style="{StaticResource LargeCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.SimulatedDevicesHeader}" />
                        <TextBlock Margin="0,4,0,12" Style="{StaticResource SubText}" Text="{x:Static res:Strings.SimulatedDevicesHint}" />
                        <ComboBox Width="240" HorizontalAlignment="Left" ItemsSource="{x:Static vm:SimulatedDevicesViewModel.Options}" DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SimulatedDevices.SelectedOption}"
                                  AutomationProperties.Name="{x:Static res:Strings.SimulatedDevicesLabel}"
                                  AutomationProperties.HelpText="{x:Static res:Strings.SimulatedDevicesHint}" />
                    </StackPanel>
                </Border>

                <!-- How smooth the effects move, and whether they rest while nobody sees them. -->
                <Border Margin="0,14,0,0" Style="{StaticResource LargeCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.EffectOptionsHeader}" />
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource Body}" Text="{x:Static res:Strings.FrameRateLabel}" />
                        <TextBlock Margin="0,2,0,8" Style="{StaticResource SubText}" Text="{x:Static res:Strings.FrameRateHint}" />
                        <ComboBox Width="300" HorizontalAlignment="Left" ItemsSource="{Binding EffectOptions.FrameRates}" DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding EffectOptions.SelectedFrameRate}"
                                  AutomationProperties.Name="{x:Static res:Strings.FrameRateLabel}"
                                  AutomationProperties.HelpText="{x:Static res:Strings.FrameRateHint}" />
                        <DockPanel Margin="0,18,0,0">
                            <ToggleButton DockPanel.Dock="Right" Margin="14,0,0,0" VerticalAlignment="Top" Style="{StaticResource Switch}"
                                          IsChecked="{Binding EffectOptions.PauseOnLockAndSleep}"
                                          AutomationProperties.Name="{x:Static res:Strings.PauseOnLockLabel}"
                                          AutomationProperties.HelpText="{x:Static res:Strings.PauseOnLockHint}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}" Text="{x:Static res:Strings.PauseOnLockLabel}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource SubText}" Text="{x:Static res:Strings.PauseOnLockHint}" />
                            </StackPanel>
                        </DockPanel>
                        <!-- What the lamps show during that pause; grey while the pause is off, as it only counts then. -->
                        <StackPanel Margin="0,18,0,0" IsEnabled="{Binding EffectOptions.PauseOnLockAndSleep}">
                            <TextBlock Style="{StaticResource Body}" Text="{x:Static res:Strings.PausedLightsLabel}" />
                            <TextBlock Margin="0,2,0,8" Style="{StaticResource SubText}" Text="{x:Static res:Strings.PausedLightsHint}" />
                            <ComboBox Width="300" HorizontalAlignment="Left" ItemsSource="{x:Static vm:EffectOptionsViewModel.PausedLightsOptions}" DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding EffectOptions.SelectedPausedLights}"
                                      AutomationProperties.Name="{x:Static res:Strings.PausedLightsLabel}"
                                      AutomationProperties.HelpText="{x:Static res:Strings.PausedLightsHint}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Whether a scene time that passed while the pc slept or the engine did not run comes on after all. -->
                <Border Margin="0,14,0,0" Style="{StaticResource LargeCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.SceneTimesHeader}" />
                        <DockPanel Margin="0,12,0,0">
                            <ToggleButton DockPanel.Dock="Right" Margin="14,0,0,0" VerticalAlignment="Top" Style="{StaticResource Switch}"
                                          IsChecked="{Binding SceneTimes.IsOn}"
                                          AutomationProperties.Name="{x:Static res:Strings.CatchUpLabel}"
                                          AutomationProperties.HelpText="{x:Static res:Strings.CatchUpHint}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}" Text="{x:Static res:Strings.CatchUpLabel}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource SubText}" Text="{x:Static res:Strings.CatchUpHint}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Whether the fixed keys of "Alles aan" and "Alles uit" in the tray menu work anywhere in Windows. -->
                <Border Margin="0,14,0,0" Style="{StaticResource LargeCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.HotkeysHeader}" />
                        <DockPanel Margin="0,12,0,0">
                            <ToggleButton DockPanel.Dock="Right" Margin="14,0,0,0" VerticalAlignment="Top" Style="{StaticResource Switch}"
                                          IsChecked="{Binding Hotkeys.IsOn}"
                                          AutomationProperties.Name="{x:Static res:Strings.HotkeysLabel}"
                                          AutomationProperties.HelpText="{x:Static res:Strings.HotkeysHint}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}" Text="{x:Static res:Strings.HotkeysLabel}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource SubText}" Text="{x:Static res:Strings.HotkeysHint}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- "Starten met Windows", the same as in the tray menu; the engine keeps it, so both show the same. -->
                <Border Margin="0,14,0,0" Style="{StaticResource LargeCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.AutoStartHeader}" />
                        <DockPanel Margin="0,12,0,0">
                            <ToggleButton DockPanel.Dock="Right" Margin="14,0,0,0" VerticalAlignment="Top" Style="{StaticResource Switch}"
                                          IsChecked="{Binding AutoStart.IsOn}"
                                          AutomationProperties.Name="{x:Static res:Strings.AutoStartLabel}"
                                          AutomationProperties.HelpText="{x:Static res:Strings.AutoStartHint}"
                                          AutomationProperties.AutomationId="AutoStart" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}" Text="{x:Static res:Strings.AutoStartLabel}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource SubText}" Text="{x:Static res:Strings.AutoStartHint}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- "Logbestand openen", as in the tray menu: engine.log in the app that opens .log files. -->
                <Border Margin="0,14,0,0" Style="{StaticResource LargeCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.LogHeader}" />
                        <TextBlock Margin="0,4,0,12" Style="{StaticResource SubText}" Text="{x:Static res:Strings.LogHint}" />
                        <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.OpenLog}"
                                Command="{Binding AppInfo.OpenLogCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.OpenLog}"
                                AutomationProperties.HelpText="{x:Static res:Strings.LogHint}" />
                    </StackPanel>
                </Border>

                <!-- At the very bottom, under the cards: the version and the guide, a link in the style of Verversen. -->
                <StackPanel Margin="4,14,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource SubText}" Text="{Binding AppInfo.VersionText}"
                               AutomationProperties.AutomationId="AppVersion" />
                    <Button Margin="12,0,0,0" Style="{StaticResource LinkButton}" Content="{x:Static res:Strings.GuideLink}"
                            Command="{Binding AppInfo.OpenGuideCommand}"
                            ToolTip="{x:Static res:Strings.GuideHint}"
                            AutomationProperties.Name="{x:Static res:Strings.GuideLink}"
                            AutomationProperties.HelpText="{x:Static res:Strings.GuideHint}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
