<!-- Buren: not designed yet (§ 5.4), so a calm page in the neighbour colors that says so and does nothing. -->
<UserControl x:Class="BuurmansRgb.UI.Views.Pages.NeighboursPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:BuurmansRgb.UI.Resources">
    <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource PageMaxWidth}">
        <TextBlock Style="{StaticResource ScreenTitle}" Text="{x:Static res:Strings.NeighboursTitle}" />
        <Border Margin="0,22,0,0" MaxWidth="560" HorizontalAlignment="Left" Padding="22" CornerRadius="{StaticResource LargeCardRadius}"
                BorderThickness="1" Background="{StaticResource BurenBgBrush}" BorderBrush="{StaticResource BurenBorderBrush}">
            <DockPanel>
                <!-- Two houses, as in the design's neighbour card. -->
                <Viewbox DockPanel.Dock="Left" Width="48" Height="48" Margin="0,0,18,0" VerticalAlignment="Top">
                    <Canvas Width="40" Height="40">
                        <Path Data="M3,20 L11,12 L19,20 L21,20 L29,12 L37,20 M6,20 H16 V32 H6 Z M24,20 H34 V32 H24 Z" StrokeThickness="2" StrokeLineJoin="Round"
                              Stroke="{StaticResource BurenIconBrush}" />
                        <Path Data="M16,24 Q20,20 24,24" StrokeThickness="2" StrokeDashArray="1 1" Stroke="{StaticResource LedBlueBrush}" />
                    </Canvas>
                </Viewbox>
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.NeighboursEmptyTitle}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource SubText}" Foreground="{StaticResource BurenTextMutedBrush}"
                               Text="{x:Static res:Strings.NeighboursEmptyText}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
