<!-- Scènes (§ 5.3 and § 6): the saved profiles as cards in three or four columns. A click on a card puts
     the scene on; its wrench chooses it to overwrite, delete or put on by itself, below the cards.
     "+ Nieuwe scène in elkaar zetten" saves the lighting as it is now under a new name. -->
<UserControl x:Class="BuurmansRgb.UI.Views.Pages.ScenesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:contracts="clr-namespace:BuurmansRgb.Contracts;assembly=BuurmansRgb.Contracts"
             xmlns:res="clr-namespace:BuurmansRgb.UI.Resources"
             xmlns:vm="clr-namespace:BuurmansRgb.UI.ViewModels"
             xmlns:views="clr-namespace:BuurmansRgb.UI.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource PageMaxWidth}">
            <TextBlock Style="{StaticResource ScreenTitle}" Text="{x:Static res:Strings.ProfilesHeader}" />
            <TextBlock Margin="0,2,0,20" FontSize="14" Foreground="{StaticResource TextMutedBrush}" Text="{x:Static res:Strings.ProfilesHint}" />

            <TextBlock Margin="0,0,0,14" Style="{StaticResource SubText}" Text="{x:Static res:Strings.NoScenes}"
                       Visibility="{Binding Profiles.HasScenes, Converter={StaticResource InverseBoolToVisibility}}" />

            <ItemsControl ItemsSource="{Binding Profiles.Cards}" Focusable="False" IsTabStop="False"
                          AutomationProperties.Name="{x:Static res:Strings.ProfilesHeader}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <views:CardGrid MinColumnWidth="220" MaxColumns="4" Gap="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SceneCard}">
                        <!-- The scene chosen with its wrench has a lighter border, and its name heads its settings below.
                             The scene that is on has the 2 px text border of the design, which wins over the lighter one;
                             1 px less padding keeps its content in place. -->
                        <Grid>
                            <Button x:Name="Card" Style="{StaticResource CardButton}" Padding="16" MinHeight="132" VerticalContentAlignment="Top" Command="{Binding DataContext.Profiles.LoadSceneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" ToolTip="{x:Static res:Strings.ProfileLoadToolTip}"
                                    AutomationProperties.Name="{Binding LoadAccessibleName}" AutomationProperties.HelpText="{Binding Description}">
                                <StackPanel Background="Transparent">
                                    <views:DecorativeItemsControl Margin="0,0,52,0" ItemsSource="{Binding Dots}" Focusable="False" IsTabStop="False"
                                                                  AutomationProperties.Name="{Binding DotsAccessibleName}">
                                        <views:DecorativeItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </views:DecorativeItemsControl.ItemsPanel>
                                        <views:DecorativeItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SceneDot}">
                                                <views:LedBulb Margin="0,0,6,0" Diameter="12" GlowBlur="8" GlowSpread="1" IsLit="{Binding IsLit}"
                                                               Color="{Binding Color}" />
                                            </DataTemplate>
                                        </views:DecorativeItemsControl.ItemTemplate>
                                    </views:DecorativeItemsControl>
                                    <TextBlock Margin="0,16,0,0" Style="{StaticResource CardTitle}" FontSize="17" Text="{Binding Name}" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource SubText}" Text="{Binding Description}" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,8,8,0" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource IconButton}"
                                    Command="{Binding DataContext.Profiles.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                    ToolTip="{x:Static res:Strings.SceneEditToolTip}" AutomationProperties.Name="{Binding EditAccessibleName}">
                                <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconSettings}" />
                            </Button>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource EqualValues}">
                                        <Binding Path="Name" />
                                        <Binding Path="DataContext.Profiles.SelectedName" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Card" Property="Padding" Value="15" />
                                <Setter TargetName="Card" Property="AutomationProperties.ItemStatus" Value="{x:Static res:Strings.SceneActiveStatus}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Margin="0,16,0,0" Style="{StaticResource NewButton}" Content="{x:Static res:Strings.NewScene}"
                    ToolTip="{x:Static res:Strings.NewSceneHint}" Command="{Binding Profiles.StartNewCommand}" Click="OnNewSceneClick"
                    Visibility="{Binding Profiles.IsNaming, Converter={StaticResource InverseBoolToVisibility}}" />

            <!-- The name of the new scene. -->
            <Border Margin="0,16,0,0" Style="{StaticResource LargeCard}" Visibility="{Binding Profiles.IsNaming, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static res:Strings.ProfileNameLabel}" />
                    <TextBlock Margin="0,0,0,10" Style="{StaticResource SubText}" Text="{x:Static res:Strings.NewSceneHint}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.Cancel}"
                                Command="{Binding Profiles.CancelNewCommand}" />
                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="{Binding Profiles.SaveLabel}"
                                ToolTip="{x:Static res:Strings.ProfileSaveToolTip}" Command="{Binding Profiles.SaveCommand}" />
                        <TextBox x:Name="NewSceneName" MaxLength="{x:Static contracts:ProfileNames.MaxLength}" Text="{Binding Profiles.Name, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{x:Static res:Strings.ProfileNameLabel}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding Profiles.SaveCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding Profiles.CancelNewCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- The chosen scene: put it on, overwrite it, delete it, or let it go on by itself. -->
            <Border Margin="0,16,0,0" Style="{StaticResource LargeCard}" Visibility="{Binding Profiles.HasSelection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding Profiles.EditTitle}" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.ProfileLoad}"
                                ToolTip="{x:Static res:Strings.ProfileLoadToolTip}" Command="{Binding Profiles.LoadCommand}" />
                        <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.SceneOverwrite}"
                                ToolTip="{x:Static res:Strings.SceneOverwriteToolTip}" Command="{Binding Profiles.OverwriteCommand}" />
                        <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.ProfileDelete}"
                                Command="{Binding Profiles.DeleteCommand}" />
                    </WrapPanel>

                    <TextBlock Margin="0,14,0,8" Style="{StaticResource Body}" Text="{Binding Profiles.Automation.Header}" />
                    <StackPanel IsEnabled="{Binding Profiles.Automation.HasProfile}">
                        <!-- The times, each with its days; the days are grey without a time, as they only
                             count with one. "−" takes a time away, "+ Nog een tijd" adds one. -->
                        <TextBlock Style="{StaticResource SubText}" Margin="0,0,0,6" Text="{x:Static res:Strings.ProfileLoadAtLabel}" />
                        <ItemsControl x:Name="TimesList" ItemsSource="{Binding Profiles.Automation.Times}" Focusable="False" IsTabStop="False"
                                      AutomationProperties.Name="{x:Static res:Strings.ProfileLoadAtLabel}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LoadTimeRow}">
                                    <WrapPanel Margin="0,0,0,6">
                                        <TextBox Width="110" Margin="0,0,12,6" VerticalAlignment="Center" MaxLength="5" FontFamily="{StaticResource MonoFont}"
                                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{x:Static res:Strings.ProfileLoadAtHint}"
                                                 AutomationProperties.Name="{Binding TimeAccessibleName}"
                                                 AutomationProperties.HelpText="{x:Static res:Strings.ProfileLoadAtHint}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding DataContext.Profiles.Automation.ApplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <ItemsControl ItemsSource="{Binding Days}" Focusable="False" IsEnabled="{Binding HasTime}"
                                                      AutomationProperties.Name="{Binding DaysAccessibleName}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:DayOption}">
                                                    <ToggleButton Margin="0,0,6,6" Style="{StaticResource DayToggle}" Content="{Binding ShortName}"
                                                                  IsChecked="{Binding IsChecked}" ToolTip="{Binding Name}"
                                                                  AutomationProperties.Name="{Binding Name}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Margin="6,0,0,6" Style="{StaticResource IconButton}" Content="−"
                                                ToolTip="{x:Static res:Strings.ProfileTimeRemoveToolTip}" AutomationProperties.Name="{Binding RemoveAccessibleName}"
                                                Command="{Binding DataContext.Profiles.Automation.RemoveTimeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Click="OnRemoveTimeClick" />
                                    </WrapPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="AddTime" HorizontalAlignment="Left" Style="{StaticResource LinkButton}" Content="{x:Static res:Strings.ProfileTimeAdd}"
                                ToolTip="{x:Static res:Strings.ProfileTimeAddToolTip}" Command="{Binding Profiles.Automation.AddTimeCommand}" Click="OnAddTimeClick" />

                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SubText}" Margin="0,0,0,6" Text="{x:Static res:Strings.ProfileProgramLabel}" />
                                <TextBox Text="{Binding Profiles.Automation.ProgramText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{x:Static res:Strings.ProfileProgramHint}"
                                         AutomationProperties.Name="{x:Static res:Strings.ProfileProgramLabel}"
                                         AutomationProperties.HelpText="{x:Static res:Strings.ProfileProgramHint}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding Profiles.Automation.ApplyCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </StackPanel>
                            <!-- Or pick the program: one that has a window now, or an .exe anywhere. -->
                            <DockPanel Grid.Row="1" Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                                        Content="{x:Static res:Strings.ProgramBrowse}" ToolTip="{x:Static res:Strings.ProgramBrowseToolTip}"
                                        Click="OnBrowseProgramClick" />
                                <ComboBox x:Name="RunningPrograms" ItemsSource="{Binding Profiles.Automation.RunningPrograms}"
                                          Tag="{x:Static res:Strings.ProgramPickPlaceholder}"
                                          IsVisibleChanged="OnRunningProgramsShown" DropDownOpened="OnRunningProgramsOpened" SelectionChanged="OnRunningProgramPicked"
                                          ToolTip="{x:Static res:Strings.ProgramPickToolTip}"
                                          AutomationProperties.Name="{x:Static res:Strings.ProgramPickPlaceholder}"
                                          AutomationProperties.HelpText="{x:Static res:Strings.ProgramPickToolTip}" />
                            </DockPanel>
                            <!-- Whether the program counts only while it is in the foreground; grey without a program, as it only counts with one. -->
                            <CheckBox Grid.Row="2" Margin="0,8,0,0" HorizontalAlignment="Left"
                                      IsChecked="{Binding Profiles.Automation.ForegroundOnly}" IsEnabled="{Binding Profiles.Automation.HasProgramText}"
                                      Content="{x:Static res:Strings.ProfileForegroundOnlyLabel}" ToolTip="{x:Static res:Strings.ProfileForegroundOnlyHint}"
                                      AutomationProperties.HelpText="{x:Static res:Strings.ProfileForegroundOnlyHint}" />
                            <Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Bottom" Style="{StaticResource SecondaryButton}"
                                    Content="{x:Static res:Strings.ProfileAutomationApply}" ToolTip="{x:Static res:Strings.ProfileAutomationApplyToolTip}"
                                    Command="{Binding Profiles.Automation.ApplyCommand}"
                                    AutomationProperties.Name="{x:Static res:Strings.ProfileAutomationApplyAccessibleName}" />
                        </Grid>
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource SubText}" Text="{x:Static res:Strings.ProfileLoadAtHint}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource SubText}" Text="{x:Static res:Strings.ProfileProgramHint}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource SubText}" Text="{x:Static res:Strings.ProfileForegroundOnlyHint}" />
                    <DockPanel Margin="0,8,0,0" Visibility="{Binding Profiles.Automation.HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource WarningMark}" AutomationProperties.Name="{x:Static res:Strings.Warning}" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding Profiles.Automation.Error, NotifyOnTargetUpdated=True}"
                                   AutomationProperties.AutomationId="ProfileAutomationError" AutomationProperties.LiveSetting="Polite"
                                   views:LiveRegion.AnnouncesUpdates="True" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
