<!-- Scènes: the saved profiles, to load, save, delete and load by themselves. -->
<UserControl x:Class="BuurmansRgb.UI.Views.Pages.ScenesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:contracts="clr-namespace:BuurmansRgb.Contracts;assembly=BuurmansRgb.Contracts"
             xmlns:res="clr-namespace:BuurmansRgb.UI.Resources"
             xmlns:vm="clr-namespace:BuurmansRgb.UI.ViewModels"
             xmlns:views="clr-namespace:BuurmansRgb.UI.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource PageMaxWidth}">
            <TextBlock Style="{StaticResource ScreenTitle}" Text="{x:Static res:Strings.ProfilesHeader}" />
            <TextBlock Margin="0,2,0,18" Style="{StaticResource SubText}" Text="{x:Static res:Strings.ProfilesHint}" />

            <ListBox MaxHeight="240" ItemsSource="{Binding Profiles.Names}" SelectedItem="{Binding Profiles.SelectedName}"
                     Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"
                     AutomationProperties.Name="{x:Static res:Strings.ProfilesHeader}"
                     AutomationProperties.HelpText="{x:Static res:Strings.ProfilesHint}">
                <ListBox.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding Profiles.LoadCommand}" />
                </ListBox.InputBindings>
            </ListBox>
            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.ProfileLoad}"
                        ToolTip="{x:Static res:Strings.ProfileLoadToolTip}" Command="{Binding Profiles.LoadCommand}" />
                <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.ProfileDelete}"
                        Command="{Binding Profiles.DeleteCommand}" />
            </StackPanel>

            <TextBlock Margin="0,18,0,6" Style="{StaticResource Body}" Text="{x:Static res:Strings.ProfileNameLabel}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="{Binding Profiles.SaveLabel}"
                        ToolTip="{x:Static res:Strings.ProfileSaveToolTip}" Command="{Binding Profiles.SaveCommand}" />
                <TextBox MaxLength="{x:Static contracts:ProfileNames.MaxLength}" Text="{Binding Profiles.Name, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{x:Static res:Strings.ProfileNameLabel}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding Profiles.SaveCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>

            <TextBlock Margin="0,22,0,6" Style="{StaticResource SectionHeader}" Text="{Binding Profiles.Automation.Header}" />
            <TextBlock Style="{StaticResource SubText}" Text="{x:Static res:Strings.ProfileAutomationNoSelection}"
                       Visibility="{Binding Profiles.Automation.HasProfile, Converter={StaticResource InverseBoolToVisibility}}" />
            <StackPanel IsEnabled="{Binding Profiles.Automation.HasProfile}">
                <TextBlock Margin="0,6,0,6" Style="{StaticResource Body}" Text="{x:Static res:Strings.ProfileLoadAtLabel}" />
                <TextBox Width="90" HorizontalAlignment="Left" MaxLength="5" FontFamily="{StaticResource MonoFont}"
                         Text="{Binding Profiles.Automation.LoadAtText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{x:Static res:Strings.ProfileLoadAtHint}"
                         AutomationProperties.Name="{x:Static res:Strings.ProfileLoadAtLabel}"
                         AutomationProperties.HelpText="{x:Static res:Strings.ProfileLoadAtHint}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding Profiles.Automation.ApplyCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Margin="0,12,0,6" Style="{StaticResource Body}" Text="{x:Static res:Strings.ProfileProgramLabel}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.ProfileAutomationApply}"
                            ToolTip="{x:Static res:Strings.ProfileAutomationApplyToolTip}" Command="{Binding Profiles.Automation.ApplyCommand}"
                            AutomationProperties.Name="{x:Static res:Strings.ProfileAutomationApplyAccessibleName}" />
                    <TextBox Text="{Binding Profiles.Automation.ProgramText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{x:Static res:Strings.ProfileProgramHint}"
                             AutomationProperties.Name="{x:Static res:Strings.ProfileProgramLabel}"
                             AutomationProperties.HelpText="{x:Static res:Strings.ProfileProgramHint}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding Profiles.Automation.ApplyCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <DockPanel Margin="0,6,0,0" Visibility="{Binding Profiles.Automation.HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource WarningMark}" AutomationProperties.Name="{x:Static res:Strings.Warning}" />
                    <TextBlock TextWrapping="Wrap" Text="{Binding Profiles.Automation.Error, NotifyOnTargetUpdated=True}"
                               AutomationProperties.AutomationId="ProfileAutomationError" AutomationProperties.LiveSetting="Polite"
                               views:LiveRegion.AnnouncesUpdates="True" />
                </DockPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
