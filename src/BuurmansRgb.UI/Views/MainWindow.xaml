<Window x:Class="BuurmansRgb.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:BuurmansRgb.UI.Resources"
        xmlns:vm="clr-namespace:BuurmansRgb.UI.ViewModels"
        xmlns:views="clr-namespace:BuurmansRgb.UI.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{x:Static res:Strings.WindowTitle}"
        Width="900" Height="640" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <views:RgbColorToBrushConverter x:Key="ColorToBrush" />
        <views:RgbColorToMediaColorConverter x:Key="ColorToMediaColor" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,2" />
            <Setter Property="Foreground" Value="{x:Static SystemColors.GrayTextBrush}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid IsEnabled="{Binding IsConnected}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Header}" Margin="0,0,0,6"
                               Text="{x:Static res:Strings.DevicesHeader}" />
                    <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                             AutomationProperties.Name="{x:Static res:Strings.DevicesHeader}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DeviceItem}">
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Details}" Foreground="{x:Static SystemColors.GrayTextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,12,16,16">
                        <TextBlock Style="{StaticResource Header}" Margin="0,0,0,6" Text="{x:Static res:Strings.ColorHeader}" />
                        <StackPanel Orientation="Horizontal">
                            <Border Width="48" Height="48" CornerRadius="6" BorderThickness="1" BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                                    Background="{Binding ColorPicker.Color, Converter={StaticResource ColorToBrush}}" />
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Label}" Margin="0,0,0,2" Text="{x:Static res:Strings.HexLabel}" />
                                <TextBox Width="100" Text="{Binding ColorPicker.HexColor, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{x:Static res:Strings.HexLabel}" />
                            </StackPanel>
                        </StackPanel>

                        <ItemsControl Margin="0,10,0,0" ItemsSource="{x:Static vm:ColorPickerViewModel.Presets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ColorPreset}">
                                    <Button Width="28" Height="28" Margin="0,0,6,6"
                                            BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                                            Background="{Binding Color, Converter={StaticResource ColorToBrush}}"
                                            ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                            Command="{Binding DataContext.ColorPicker.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Color}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource Label}" Text="{x:Static res:Strings.HueLabel}" />
                        <Slider Minimum="0" Maximum="360" Value="{Binding ColorPicker.Hue}" SmallChange="1" LargeChange="15"
                                AutomationProperties.Name="{x:Static res:Strings.HueLabel}">
                            <Slider.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#FF0000" />
                                    <GradientStop Offset="0.1667" Color="#FFFF00" />
                                    <GradientStop Offset="0.3333" Color="#00FF00" />
                                    <GradientStop Offset="0.5" Color="#00FFFF" />
                                    <GradientStop Offset="0.6667" Color="#0000FF" />
                                    <GradientStop Offset="0.8333" Color="#FF00FF" />
                                    <GradientStop Offset="1" Color="#FF0000" />
                                </LinearGradientBrush>
                            </Slider.Background>
                        </Slider>

                        <TextBlock Style="{StaticResource Label}" Text="{x:Static res:Strings.SaturationLabel}" />
                        <Slider Minimum="0" Maximum="100" Value="{Binding ColorPicker.Saturation}" SmallChange="1" LargeChange="10"
                                AutomationProperties.Name="{x:Static res:Strings.SaturationLabel}">
                            <Slider.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="White" />
                                    <GradientStop Offset="1" Color="{Binding ColorPicker.HueColor, Converter={StaticResource ColorToMediaColor}}" />
                                </LinearGradientBrush>
                            </Slider.Background>
                        </Slider>

                        <TextBlock Style="{StaticResource Header}" Text="{x:Static res:Strings.BrightnessHeader}" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right"
                                       Text="{Binding Brightness, StringFormat={}{0:0} %}" />
                            <Slider Minimum="0" Maximum="100" Value="{Binding Brightness}" SmallChange="1" LargeChange="10"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    AutomationProperties.Name="{x:Static res:Strings.BrightnessHeader}" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource Header}" Text="{x:Static res:Strings.EffectHeader}" />
                        <ComboBox Width="200" HorizontalAlignment="Left" ItemsSource="{Binding Effects}"
                                  SelectedItem="{Binding SelectedEffect}" DisplayMemberPath="DisplayName"
                                  AutomationProperties.Name="{x:Static res:Strings.EffectHeader}" />

                        <TextBlock Style="{StaticResource Header}" Text="{x:Static res:Strings.PreviewHeader}" />
                        <ItemsControl ItemsSource="{Binding Preview.Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DevicePreviewViewModel}">
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Name}" Margin="0,0,0,4" />
                                        <views:LedStripView Colors="{Binding Colors}" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibility}}">
                <!-- The window color, so the overlay also fits dark and high-contrast themes. -->
                <Rectangle Fill="{x:Static SystemColors.WindowBrush}" Opacity="0.9" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center" FontSize="15"
                               AutomationProperties.AutomationId="ConnectionMessage" />
                    <Button Margin="0,16,0,0" Padding="16,6" HorizontalAlignment="Center"
                            Content="{x:Static res:Strings.Retry}" Command="{Binding ConnectCommand}"
                            Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
