<Window x:Class="BuurmansRgb.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:BuurmansRgb.UI.Resources"
        xmlns:vm="clr-namespace:BuurmansRgb.UI.ViewModels"
        xmlns:views="clr-namespace:BuurmansRgb.UI.Views"
        xmlns:pages="clr-namespace:BuurmansRgb.UI.Views.Pages"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{x:Static res:Strings.WindowTitle}"
        Width="1180" Height="800" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource TextFont}" FontSize="{StaticResource BodySize}">
    <!-- A title bar of our own in bg (§ 6). Windows still moves, snaps and sizes the window, and a
         double click or Alt+Space on the bar work as usual. One pixel of glass keeps the shadow of
         Windows around the window, and on Windows 11 its rounded corners. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- The navigation rail (§ 6): icon above label; the active page in text and semibold, the others muted. -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="DockPanel.Dock" Value="Top" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Item" Margin="8,4" Padding="0,8" MinHeight="60" CornerRadius="14" BorderThickness="1"
                                Background="Transparent" BorderBrush="Transparent">
                            <StackPanel VerticalAlignment="Center">
                                <Path x:Name="Icon" Style="{StaticResource LineIcon}" HorizontalAlignment="Center" Data="{StaticResource IconLamps}" />
                                <TextBlock x:Name="Label" Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="{StaticResource NavLabelSize}" Text="{Binding Label}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Page}" Value="{x:Static vm:AppPage.Color}">
                                <Setter TargetName="Icon" Property="Data" Value="{StaticResource IconColor}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Page}" Value="{x:Static vm:AppPage.Scenes}">
                                <Setter TargetName="Icon" Property="Data" Value="{StaticResource IconScenes}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Page}" Value="{x:Static vm:AppPage.Settings}">
                                <Setter TargetName="Icon" Property="Data" Value="{StaticResource IconSettings}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Item" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}" />
                                <Setter TargetName="Item" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAtBottom}" Value="True">
                    <Setter Property="DockPanel.Dock" Value="Bottom" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The page of the rail's selection; a page is made when it shows and let go when another one does. -->
        <Style x:Key="PageHost" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <pages:LampsPage />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Navigation.CurrentPage}" Value="{x:Static vm:AppPage.Color}">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <pages:ColorPage />
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Navigation.CurrentPage}" Value="{x:Static vm:AppPage.Scenes}">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <pages:ScenesPage />
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Navigation.CurrentPage}" Value="{x:Static vm:AppPage.Settings}">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <pages:SettingsPage />
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Maximized, Windows puts the frame of a window off screen; the padding keeps the content in view. -->
    <Border x:Name="Frame">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Background="{DynamicResource BgBrush}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimizeClick"
                            AutomationProperties.Name="{x:Static res:Strings.CaptionMinimize}" />
                    <Button Click="OnMaximizeClick">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                                <Setter Property="Content" Value="&#xE922;" />
                                <Setter Property="AutomationProperties.Name" Value="{x:Static res:Strings.CaptionMaximize}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Content" Value="&#xE923;" />
                                        <Setter Property="AutomationProperties.Name" Value="{x:Static res:Strings.CaptionRestore}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}" Click="OnCloseClick" AutomationProperties.Name="{x:Static res:Strings.CaptionClose}" />
                </StackPanel>
                <ContentControl Style="{StaticResource TitleBarLogo}" />
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource NavBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,0">
                    <ListBox Margin="0,8" Background="Transparent" BorderThickness="0" IsEnabled="{Binding IsConnected}"
                             ItemsSource="{x:Static vm:NavigationViewModel.Items}" SelectedItem="{Binding Navigation.SelectedItem}"
                             ItemContainerStyle="{StaticResource NavItem}" KeyboardNavigation.DirectionalNavigation="Cycle"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="{x:Static res:Strings.NavAccessibleName}">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ItemsPresenter />
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <DockPanel LastChildFill="False" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ContentControl Content="{Binding}" Style="{StaticResource PageHost}" IsEnabled="{Binding IsConnected}" />

                    <!-- What just happened, and whether the engine saved it. -->
                    <DockPanel Grid.Row="1" Margin="32,6,32,10">
                        <TextBlock DockPanel.Dock="Right" Margin="16,0,0,0" Style="{StaticResource SubText}" Text="{Binding SaveStatus}"
                                   AutomationProperties.AutomationId="SaveStatus" />
                        <TextBlock Style="{StaticResource SubText}" Text="{Binding StatusMessage, NotifyOnTargetUpdated=True}"
                                   AutomationProperties.AutomationId="StatusMessage" AutomationProperties.LiveSetting="Polite"
                                   views:LiveRegion.AnnouncesUpdates="True" />
                    </DockPanel>

                    <Grid Grid.RowSpan="2" Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibility}}">
                        <Rectangle Fill="{DynamicResource BgBrush}" Opacity="0.94" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center"
                                       AutomationProperties.AutomationId="ConnectionMessage" />
                            <Button Margin="0,20,0,0" HorizontalAlignment="Center" Style="{StaticResource PrimaryButton}"
                                    Content="{x:Static res:Strings.Retry}" Command="{Binding ConnectCommand}"
                                    Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
