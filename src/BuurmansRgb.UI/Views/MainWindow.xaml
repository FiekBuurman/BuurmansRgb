<Window x:Class="BuurmansRgb.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:contracts="clr-namespace:BuurmansRgb.Contracts;assembly=BuurmansRgb.Contracts"
        xmlns:res="clr-namespace:BuurmansRgb.UI.Resources"
        xmlns:vm="clr-namespace:BuurmansRgb.UI.ViewModels"
        xmlns:views="clr-namespace:BuurmansRgb.UI.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{x:Static res:Strings.WindowTitle}"
        Width="900" Height="640" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <views:RgbColorToBrushConverter x:Key="ColorToBrush" />
        <views:RgbColorToMediaColorConverter x:Key="ColorToMediaColor" />
        <views:DeviceTypeToIconConverter x:Key="TypeToIcon" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,2" />
            <Setter Property="Foreground" Value="{x:Static SystemColors.GrayTextBrush}" />
        </Style>
        <!-- The icon of a device's type; the DataContext needs a Type property. -->
        <Style x:Key="DeviceIcon" TargetType="Path">
            <Setter Property="Width" Value="{x:Static views:DeviceIcons.Size}" />
            <Setter Property="Height" Value="{x:Static views:DeviceIcons.Size}" />
            <Setter Property="Data" Value="{Binding Type, Converter={StaticResource TypeToIcon}}" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <!-- The panel of a StatusBar is a DockPanel: docked right, before the message that fills the rest. -->
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding SaveStatus}" AutomationProperties.AutomationId="SaveStatus" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid IsEnabled="{Binding IsConnected}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Margin="12">
                    <!-- The device list grouped by heading: the real devices and the simulated ones.
                         "All devices" has no heading. -->
                    <DockPanel.Resources>
                        <CollectionViewSource x:Key="GroupedDevices" Source="{Binding Devices}">
                            <CollectionViewSource.GroupDescriptions>
                                <PropertyGroupDescription PropertyName="Group" />
                            </CollectionViewSource.GroupDescriptions>
                        </CollectionViewSource>
                    </DockPanel.Resources>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Header}" Margin="0,0,0,6"
                               Text="{x:Static res:Strings.DevicesHeader}" />

                    <!-- Profiles hold the lighting of every device, so they sit apart from the device list. -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource Header}" Margin="0,0,0,2" Text="{x:Static res:Strings.ProfilesHeader}" />
                        <TextBlock Style="{StaticResource Label}" Margin="0,0,0,6" TextWrapping="Wrap" Text="{x:Static res:Strings.ProfilesHint}" />
                        <ListBox Height="96" ItemsSource="{Binding Profiles.Names}" SelectedItem="{Binding Profiles.SelectedName}"
                                 AutomationProperties.Name="{x:Static res:Strings.ProfilesHeader}">
                            <ListBox.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding Profiles.LoadCommand}" />
                            </ListBox.InputBindings>
                        </ListBox>
                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                            <Button Padding="10,3" Content="{x:Static res:Strings.ProfileLoad}"
                                    ToolTip="{x:Static res:Strings.ProfileLoadToolTip}" Command="{Binding Profiles.LoadCommand}" />
                            <Button Margin="6,0,0,0" Padding="10,3" Content="{x:Static res:Strings.ProfileDelete}"
                                    Command="{Binding Profiles.DeleteCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Label}" Margin="0,10,0,2" Text="{x:Static res:Strings.ProfileNameLabel}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,3" Content="{Binding Profiles.SaveLabel}"
                                    ToolTip="{x:Static res:Strings.ProfileSaveToolTip}" Command="{Binding Profiles.SaveCommand}" />
                            <TextBox VerticalContentAlignment="Center" MaxLength="{x:Static contracts:ProfileNames.MaxLength}"
                                     Text="{Binding Profiles.Name, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{x:Static res:Strings.ProfileNameLabel}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding Profiles.SaveCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Source={StaticResource GroupedDevices}}" SelectedItem="{Binding SelectedDevice}"
                             AutomationProperties.Name="{x:Static res:Strings.DevicesHeader}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="{x:Null}">
                                                <Setter Property="AutomationProperties.Name" Value="{x:Static res:Strings.AllDevices}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="Heading" Margin="2,10,0,2" FontWeight="SemiBold" Text="{Binding Name}"
                                                   Foreground="{x:Static SystemColors.GrayTextBrush}" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="{x:Null}">
                                                <Setter TargetName="Heading" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding LocationToolTip}" />
                                <Setter Property="ToolTip" Value="{Binding LocationToolTip}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DeviceItem}">
                                <DockPanel Margin="2,4">
                                    <!-- The item's text color, so the icon also shows on the selection highlight. -->
                                    <Path Style="{StaticResource DeviceIcon}" DockPanel.Dock="Left" Margin="0,1,8,0" VerticalAlignment="Top"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          ToolTip="{Binding TypeName}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Details}" Foreground="{x:Static SystemColors.GrayTextBrush}" />
                                        <TextBlock Text="{Binding LocationLabel}" Foreground="{x:Static SystemColors.GrayTextBrush}"
                                                   Visibility="{Binding ShowsLocationLabel, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,12,16,16">
                        <TextBlock Style="{StaticResource Header}" Margin="0,0,0,6" Text="{x:Static res:Strings.ColorHeader}" />
                        <Border Margin="0,0,0,10" Padding="10,8" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{x:Static SystemColors.HighlightBrush}"
                                Visibility="{Binding LedEditor.HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Margin="8,0,0,0" Padding="10,3" Content="{x:Static res:Strings.FillGradient}"
                                            ToolTip="{x:Static res:Strings.FillGradientToolTip}" Command="{Binding FillGradientCommand}" />
                                    <Button Margin="8,0,0,0" Padding="10,3" Content="{x:Static res:Strings.ClearLedSelection}"
                                            Command="{Binding ClearLedSelectionCommand}" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding LedEditor.SelectionText}" />
                                    <TextBlock Foreground="{x:Static SystemColors.GrayTextBrush}" TextWrapping="Wrap"
                                               Text="{x:Static res:Strings.LedSelectionHint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="48" Height="48" CornerRadius="6" BorderThickness="1" BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                                    Background="{Binding ColorPicker.Color, Converter={StaticResource ColorToBrush}}" />
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Label}" Margin="0,0,0,2" Text="{x:Static res:Strings.HexLabel}" />
                                <TextBox Width="100" Text="{Binding ColorPicker.HexColor, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{x:Static res:Strings.HexLabel}" />
                            </StackPanel>
                        </StackPanel>

                        <ItemsControl Margin="0,10,0,0" ItemsSource="{x:Static vm:ColorPickerViewModel.Presets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ColorPreset}">
                                    <Button Width="28" Height="28" Margin="0,0,6,6"
                                            BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                                            Background="{Binding Color, Converter={StaticResource ColorToBrush}}"
                                            ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                            Command="{Binding DataContext.ColorPicker.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Color}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource Label}" Text="{x:Static res:Strings.HueLabel}" />
                        <Slider Minimum="0" Maximum="360" Value="{Binding ColorPicker.Hue}" SmallChange="1" LargeChange="15"
                                AutomationProperties.Name="{x:Static res:Strings.HueLabel}">
                            <Slider.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#FF0000" />
                                    <GradientStop Offset="0.1667" Color="#FFFF00" />
                                    <GradientStop Offset="0.3333" Color="#00FF00" />
                                    <GradientStop Offset="0.5" Color="#00FFFF" />
                                    <GradientStop Offset="0.6667" Color="#0000FF" />
                                    <GradientStop Offset="0.8333" Color="#FF00FF" />
                                    <GradientStop Offset="1" Color="#FF0000" />
                                </LinearGradientBrush>
                            </Slider.Background>
                        </Slider>

                        <TextBlock Style="{StaticResource Label}" Text="{x:Static res:Strings.SaturationLabel}" />
                        <Slider Minimum="0" Maximum="100" Value="{Binding ColorPicker.Saturation}" SmallChange="1" LargeChange="10"
                                AutomationProperties.Name="{x:Static res:Strings.SaturationLabel}">
                            <Slider.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="White" />
                                    <GradientStop Offset="1" Color="{Binding ColorPicker.HueColor, Converter={StaticResource ColorToMediaColor}}" />
                                </LinearGradientBrush>
                            </Slider.Background>
                        </Slider>

                        <!-- With the color loop, the picker above colors the selected color of the loop. -->
                        <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                                Visibility="{Binding IsColorLoop, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.ColorLoopHeader}" />
                                <TextBlock Foreground="{x:Static SystemColors.GrayTextBrush}" TextWrapping="Wrap"
                                           Text="{x:Static res:Strings.ColorLoopHint}" />
                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                    <ItemsControl ItemsSource="{Binding ColorLoopEditor.Swatches}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ColorLoopSwatch}">
                                                <Button x:Name="Swatch" Width="32" Height="32" Margin="0,0,6,0" BorderThickness="1"
                                                        BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                                                        Background="{Binding Color, Converter={StaticResource ColorToBrush}}"
                                                        ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                                        Command="{Binding DataContext.ColorLoopEditor.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Index}" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Swatch" Property="BorderThickness" Value="3" />
                                                        <Setter TargetName="Swatch" Property="BorderBrush" Value="{x:Static SystemColors.HighlightBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Width="32" Height="32" Margin="6,0,0,0" Content="+" FontSize="16"
                                            ToolTip="{x:Static res:Strings.ColorLoopAdd}" AutomationProperties.Name="{x:Static res:Strings.ColorLoopAdd}"
                                            Command="{Binding ColorLoopEditor.AddColorCommand}" />
                                    <Button Width="32" Height="32" Margin="6,0,0,0" Content="−" FontSize="16"
                                            ToolTip="{x:Static res:Strings.ColorLoopRemove}" AutomationProperties.Name="{x:Static res:Strings.ColorLoopRemove}"
                                            Command="{Binding ColorLoopEditor.RemoveColorCommand}" />
                                </StackPanel>
                                <CheckBox Margin="0,8,0,0" IsChecked="{Binding ColorLoopEditor.Spread}"
                                          Content="{x:Static res:Strings.ColorLoopSpread}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Header}" Text="{x:Static res:Strings.BrightnessHeader}" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right"
                                       Text="{Binding Brightness, StringFormat={}{0:0} %}" />
                            <Slider Minimum="0" Maximum="100" Value="{Binding Brightness}" SmallChange="1" LargeChange="10"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    AutomationProperties.Name="{x:Static res:Strings.BrightnessHeader}" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource Header}" Text="{x:Static res:Strings.EffectHeader}" />
                        <ComboBox Width="200" HorizontalAlignment="Left" ItemsSource="{Binding Effects}"
                                  SelectedItem="{Binding SelectedEffect}" DisplayMemberPath="DisplayName"
                                  AutomationProperties.Name="{x:Static res:Strings.EffectHeader}" />

                        <TextBlock Style="{StaticResource Header}" Text="{x:Static res:Strings.SpeedHeader}" />
                        <DockPanel IsEnabled="{Binding IsSpeedEnabled}">
                            <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right"
                                       Text="{Binding Speed, StringFormat={}{0:0} %}" />
                            <Slider Minimum="{x:Static vm:MainViewModel.MinSpeed}" Maximum="{x:Static vm:MainViewModel.MaxSpeed}"
                                    Value="{Binding Speed}" SmallChange="5" LargeChange="25"
                                    IsSnapToTickEnabled="True" TickFrequency="5"
                                    AutomationProperties.Name="{x:Static res:Strings.SpeedHeader}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Label}" Text="{x:Static res:Strings.SpeedOnlyAnimated}"
                                   Visibility="{Binding IsSpeedEnabled, Converter={StaticResource InverseBoolToVisibility}}" />

                        <TextBlock Style="{StaticResource Header}" Text="{x:Static res:Strings.PreviewHeader}" />
                        <TextBlock Style="{StaticResource Label}" Margin="0,0,0,8" TextWrapping="Wrap" Text="{x:Static res:Strings.PreviewHint}" />
                        <ItemsControl ItemsSource="{Binding Preview.Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DevicePreviewViewModel}">
                                    <StackPanel Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Path Style="{StaticResource DeviceIcon}" Margin="0,0,6,0" VerticalAlignment="Center"
                                                  Stroke="{x:Static SystemColors.ControlTextBrush}" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            <Button Margin="10,0,0,0" Padding="8,1" VerticalAlignment="Center"
                                                    Content="{x:Static res:Strings.FlashDevice}" ToolTip="{x:Static res:Strings.FlashDeviceToolTip}"
                                                    Command="{Binding FlashCommand}" AutomationProperties.Name="{Binding FlashAccessibleName}" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Zones}" AutomationProperties.Name="{Binding Name}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ZonePreviewViewModel}">
                                                    <StackPanel Margin="0,0,0,6">
                                                        <TextBlock Margin="0,0,0,3" TextWrapping="Wrap"
                                                                   Visibility="{Binding ShowsHeaderLink, Converter={StaticResource BoolToVisibility}}">
                                                            <Hyperlink Command="{Binding SelectZoneCommand}" ToolTip="{x:Static res:Strings.SelectZoneToolTip}">
                                                                <Run Text="{Binding Header, Mode=OneWay}" />
                                                            </Hyperlink>
                                                        </TextBlock>
                                                        <TextBlock Margin="0,0,0,3" Text="{Binding Header}" TextWrapping="Wrap"
                                                                   Visibility="{Binding ShowsHeaderText, Converter={StaticResource BoolToVisibility}}" />
                                                        <views:LedPreviewView Colors="{Binding Colors}" Matrix="{Binding Matrix}" HorizontalAlignment="Stretch"
                                                                            SelectionFirst="{Binding SelectionFirst}" SelectionLast="{Binding SelectionLast}"
                                                                            ClickCommand="{Binding ClickLedCommand}"
                                                                            AutomationProperties.Name="{Binding AccessibleName}" />
                                                        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="{x:Static res:Strings.EmptyZoneHint}"
                                                                   Visibility="{Binding ShowsEmptyZoneHint, Converter={StaticResource BoolToVisibility}}" />
                                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal"
                                                                    Visibility="{Binding CanResize, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock VerticalAlignment="Center" Text="{Binding LedCountLabel}"
                                                                       Foreground="{x:Static SystemColors.GrayTextBrush}" />
                                                            <TextBox Width="56" Margin="6,0,0,0" VerticalContentAlignment="Center"
                                                                     Text="{Binding LedCountText, UpdateSourceTrigger=PropertyChanged}"
                                                                     AutomationProperties.Name="{Binding LedCountAccessibleName}">
                                                                <TextBox.InputBindings>
                                                                    <KeyBinding Key="Enter" Command="{Binding ApplyLedCountCommand}" />
                                                                </TextBox.InputBindings>
                                                            </TextBox>
                                                            <Button Margin="6,0,0,0" Padding="10,1" Content="{x:Static res:Strings.ApplyLedCount}"
                                                                    ToolTip="{x:Static res:Strings.ApplyLedCountToolTip}" Command="{Binding ApplyLedCountCommand}"
                                                                    AutomationProperties.Name="{Binding ApplyLedCountAccessibleName}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibility}}">
                <!-- The window color, so the overlay also fits dark and high-contrast themes. -->
                <Rectangle Fill="{x:Static SystemColors.WindowBrush}" Opacity="0.9" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center" FontSize="15"
                               AutomationProperties.AutomationId="ConnectionMessage" />
                    <Button Margin="0,16,0,0" Padding="16,6" HorizontalAlignment="Center"
                            Content="{x:Static res:Strings.Retry}" Command="{Binding ConnectCommand}"
                            Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
