<!-- "Per apparaat" on Kleur (DESIGN.md § 9): a card per device in view. With "Hele huis" and two or more
     devices each card opens and closes (DeviceCard), with "Alles openklappen", "Alles dichtklappen" and a
     row of chips to jump to one; a closed card shows its name, the number of its LEDs, a small strip in
     its colors and Knipperen. With one chosen device, or a house with one, its card is always open, as
     before. An open card shows how to choose LEDs, "Zones gelijk" for a device with more zones, and per
     zone a head with its name and, at a fixed place, "Tellen" to count its LEDs and a button to let only
     that zone blink, a dot or key per LED, the length of a zone whose length can be set and the count
     while it runs. The DataContext is MainViewModel. -->
<UserControl x:Class="BuurmansRgb.UI.Views.LedPreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:BuurmansRgb.UI.Resources"
             xmlns:vm="clr-namespace:BuurmansRgb.UI.ViewModels"
             xmlns:views="clr-namespace:BuurmansRgb.UI.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             Focusable="False">
    <UserControl.Resources>
        <!-- A length of four digits of 0.6 em in the mono font, plus the padding and the border: 64 px at
             100 %, wider with a larger text size of Windows. -->
        <views:EmConverter x:Key="LengthBoxWidth" Ems="2.4" Extra="28" />
        <!-- "Per apparaat" keeps 12 em beside the links; with less room they go under it. -->
        <views:EmConverter x:Key="PerDeviceHeadingWidth" Ems="12" />
        <!-- A chip ends in "…" past 18 em of its text; the tooltip holds the whole name. -->
        <views:EmConverter x:Key="ChipMaxWidth" Ems="18" Extra="60" />

        <!-- What a card shows open: first how to choose LEDs (it stood under the heading "Voorbeeld"),
             then "Zones gelijk", the warning of a device without direct mode, and the zones. -->
        <DataTemplate x:Key="DeviceBody" DataType="{x:Type vm:DevicePreviewViewModel}">
            <StackPanel>
                <TextBlock Margin="0,0,0,12" Style="{StaticResource SubText}" Text="{x:Static res:Strings.PreviewHint}" />
                <!-- "Zones gelijk", only for a device with more zones with LEDs, with a short line under
                     it as the switches on the Instellingen page have; the rest of the explanation is the
                     tooltip, so a card stays short. The switch keeps the focus when the preview is made
                     again after a change of it. -->
                <DockPanel Margin="0,0,0,10" ToolTip="{x:Static res:Strings.ZonesAlikeHint}"
                           Visibility="{Binding ShowsZonesAlike, Converter={StaticResource BoolToVisibility}}">
                    <views:ToggleSwitch DockPanel.Dock="Right" Margin="14,0,0,0" VerticalAlignment="Top" Style="{StaticResource Switch}"
                                  IsChecked="{Binding ZonesAlike}"
                                  AutomationProperties.Name="{Binding ZonesAlikeAccessibleName}"
                                  AutomationProperties.HelpText="{x:Static res:Strings.ZonesAlikeHint}"
                                  views:FocusKeeper.Key="{Binding ZonesAlikeFocusKey}" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="{x:Static res:Strings.ZonesAlike}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource SubText}" Text="{x:Static res:Strings.ZonesAlikeSubText}" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,0,0,10" Visibility="{Binding LacksDirectMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource WarningMark}"
                               AutomationProperties.Name="{x:Static res:Strings.NoDirectModeWarning}" />
                    <TextBlock Style="{StaticResource SubText}" Text="{x:Static res:Strings.NoDirectModeHint}" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Zones}" Focusable="False" AutomationProperties.Name="{Binding Name}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ZonePreviewViewModel}">
                            <StackPanel Margin="0,0,0,10">
                                <!-- The head of a zone: its name, a link that selects the zone (or "Alles
                                     selecteren" for a device with one zone), and at a fixed place on the right
                                     "Tellen" and "Knipperen", in that order, so Knipperen lines up with that of
                                     the device above. A zone with "Tellen" keeps the place of Knipperen also
                                     while it has no LEDs to blink (Hidden), so Tellen does not move when its
                                     length goes to 0 and back. Both keep the focus when the preview is made
                                     again after a resize. -->
                                <Grid x:Name="ZoneHead" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <views:LinkButton HorizontalAlignment="Left" FontSize="{DynamicResource SubTextSize}"
                                                Content="{Binding Header}" ToolTip="{x:Static res:Strings.SelectZoneToolTip}"
                                                Command="{Binding SelectZoneCommand}"
                                                Visibility="{Binding ShowsHeaderLink, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Style="{StaticResource SubText}" Text="{Binding Header}"
                                                   Visibility="{Binding ShowsHeaderText, Converter={StaticResource BoolToVisibility}}" />
                                        <views:LinkButton HorizontalAlignment="Left" FontSize="{DynamicResource SubTextSize}"
                                                Content="{x:Static res:Strings.SelectAll}" ToolTip="{x:Static res:Strings.SelectAllToolTip}"
                                                Command="{Binding SelectZoneCommand}" AutomationProperties.Name="{Binding SelectAllAccessibleName}"
                                                Visibility="{Binding ShowsSelectAllLink, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <!-- "Tellen", for a zone whose length can be set; once more while counting starts
                                         again from LED 1. -->
                                    <Button x:Name="CountButton" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top" Style="{StaticResource SecondaryButton}"
                                            Content="{x:Static res:Strings.CountZone}" ToolTip="{x:Static res:Strings.CountZoneToolTip}"
                                            Command="{Binding CountLedsCommand}" AutomationProperties.Name="{Binding CountAccessibleName}"
                                            ToolTipService.ShowOnDisabled="True" views:FocusKeeper.Key="{Binding CountFocusKey}"
                                            Visibility="{Binding ShowsCount, Converter={StaticResource BoolToVisibility}}" />
                                    <Button x:Name="FlashButton" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Top"
                                            Content="{x:Static res:Strings.FlashZone}" ToolTip="{x:Static res:Strings.FlashZoneToolTip}"
                                            Command="{Binding FlashCommand}" AutomationProperties.Name="{Binding FlashAccessibleName}"
                                            ToolTipService.ShowOnDisabled="True" views:FocusKeeper.Key="{Binding FlashFocusKey}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding KeepsFlashPlace}" Value="True">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ShowsFlash}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                                <!-- The LEDs, also with the keys of the per-LED editor; they keep the focus
                                     when the preview is made again. The click strip of the view (HitRadius
                                     beyond its edges) counts on this order and these margins: what comes
                                     before it (the name, Knipperen) wins above it through YieldsAt, and what
                                     comes after it (8 px below, such as the label of the length) wins below. -->
                                <views:LedPreviewView Colors="{Binding Colors}" Matrix="{Binding Matrix}" HorizontalAlignment="Stretch"
                                                      IsRing="{Binding IsRing}" LedNames="{Binding LedNames}" LedLabels="{Binding LedLabels}"
                                                      SelectionFirst="{Binding SelectionFirst}" SelectionLast="{Binding SelectionLast}"
                                                      ClickCommand="{Binding ClickLedCommand}"
                                                      ActiveLed="{Binding ActiveLed}" KeyCommand="{Binding PressKeyCommand}" KeyGroup="{Binding DeviceId}"
                                                      views:FocusKeeper.Key="{Binding LedsFocusKey}"
                                                      AutomationProperties.Name="{Binding AccessibleName}" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource SubText}" Text="{x:Static res:Strings.EmptyZoneHint}"
                                           Visibility="{Binding ShowsEmptyZoneHintText, Converter={StaticResource BoolToVisibility}}" />
                                <!-- The count of the LEDs while it runs, instead of the length: a big counter, a
                                     status that a screen reader reads when it changes (not at every LED), and the
                                     controls, which keep the focus when the preview is made again. When the count
                                     ends with the focus in it, the focus goes to "Tellen". -->
                                <Border Margin="0,8,0,0" Style="{StaticResource Card}" Padding="16,12"
                                        Visibility="{Binding IsCounting, Converter={StaticResource BoolToVisibility}}"
                                        views:FocusFallback.Target="{Binding ElementName=CountButton}">
                                    <StackPanel DataContext="{Binding Count}">
                                        <TextBlock Style="{StaticResource BigValue}" FontSize="{DynamicResource CountValueSize}" FontFamily="{StaticResource MonoFont}"
                                                   Text="{Binding LedText}" AutomationProperties.Name="{Binding AccessibleName}" />
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource SubText}" Text="{Binding Status, NotifyOnTargetUpdated=True}"
                                                   AutomationProperties.LiveSetting="Polite" views:LiveRegion.AnnouncesUpdates="True" />
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Margin="0,0,10,8" Style="{StaticResource SecondaryButton}" MinWidth="110"
                                                    Content="{Binding PauseOrResumeText}" ToolTip="{x:Static res:Strings.ZoneCountPauseToolTip}"
                                                    Command="{Binding PauseOrResumeCommand}"
                                                    views:FocusKeeper.Key="{Binding FocusKey, StringFormat={}{0}/pause}" />
                                            <Button Margin="0,0,10,8" Style="{StaticResource IconButton}" Content="−"
                                                    ToolTip="{x:Static res:Strings.ZoneCountPrevious}" Command="{Binding PreviousCommand}"
                                                    AutomationProperties.Name="{x:Static res:Strings.ZoneCountPrevious}"
                                                    views:FocusKeeper.Key="{Binding FocusKey, StringFormat={}{0}/previous}" />
                                            <Button Margin="0,0,18,8" Style="{StaticResource IconButton}" Content="+"
                                                    ToolTip="{x:Static res:Strings.ZoneCountNext}" Command="{Binding NextCommand}"
                                                    AutomationProperties.Name="{x:Static res:Strings.ZoneCountNext}"
                                                    views:FocusKeeper.Key="{Binding FocusKey, StringFormat={}{0}/next}" />
                                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource SubText}"
                                                           Text="{x:Static res:Strings.ZoneCountPaceLabel}" />
                                                <ItemsControl ItemsSource="{Binding PaceOptions}" Focusable="False"
                                                              AutomationProperties.Name="{x:Static res:Strings.ZoneCountPaceGroup}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ZoneCountPaceOption}">
                                                            <RadioButton Margin="0,0,6,0" Style="{StaticResource DayToggle}" Content="{Binding Text}"
                                                                         GroupName="{Binding GroupName}" IsChecked="{Binding IsChecked}"
                                                                         AutomationProperties.Name="{Binding AccessibleName}" ToolTip="{Binding AccessibleName}"
                                                                         views:FocusKeeper.Key="{Binding GroupName, StringFormat={}{0}/option}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </WrapPanel>
                                        <WrapPanel>
                                            <Button Margin="0,0,10,0" Style="{StaticResource SecondaryButton}"
                                                    Content="{x:Static res:Strings.ZoneCountKeep}" ToolTip="{x:Static res:Strings.ZoneCountKeepToolTip}"
                                                    Command="{Binding KeepCommand}" ToolTipService.ShowOnDisabled="True"
                                                    views:FocusKeeper.Key="{Binding FocusKey, StringFormat={}{0}/keep}" />
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Content="{x:Static res:Strings.ZoneCountStop}" ToolTip="{x:Static res:Strings.ZoneCountStopToolTip}"
                                                    Command="{Binding StopCommand}"
                                                    views:FocusKeeper.Key="{Binding FocusKey, StringFormat={}{0}/stop}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <!-- The controls keep the focus when the preview is made again after a resize. -->
                                <StackPanel Margin="0,8,0,0" Visibility="{Binding ShowsLength, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource SubText}" Text="{Binding Length.Label}" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MaxWidth="360" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <RepeatButton Grid.Column="0" Style="{StaticResource IconRepeatButton}" Content="−"
                                                ToolTip="{x:Static res:Strings.DecreaseLedCountToolTip}" Command="{Binding Length.DecreaseCommand}"
                                                AutomationProperties.Name="{Binding Length.DecreaseAccessibleName}"
                                                views:FocusKeeper.Key="{Binding Length.FocusKey, StringFormat={}{0}/decrease}" />
                                        <Slider Grid.Column="1" Margin="10,0" MinWidth="80" VerticalAlignment="Center"
                                                Minimum="{Binding Length.Minimum}" Maximum="{Binding Length.Maximum}"
                                                Value="{Binding Length.LedCount}" SmallChange="1" LargeChange="10"
                                                IsSnapToTickEnabled="True" TickFrequency="1"
                                                ToolTip="{x:Static res:Strings.ZoneLedCountToolTip}"
                                                views:SliderDrag.Started="{Binding Length.BeginDragCommand}" views:SliderDrag.Completed="{Binding Length.EndDragCommand}"
                                                AutomationProperties.Name="{Binding Length.SliderAccessibleName}"
                                                AutomationProperties.HelpText="{Binding LedCountHelpText}"
                                                views:FocusKeeper.Key="{Binding Length.FocusKey, StringFormat={}{0}/slider}" />
                                        <RepeatButton Grid.Column="2" Style="{StaticResource IconRepeatButton}" Content="+"
                                                ToolTip="{x:Static res:Strings.IncreaseLedCountToolTip}" Command="{Binding Length.IncreaseCommand}"
                                                AutomationProperties.Name="{Binding Length.IncreaseAccessibleName}"
                                                views:FocusKeeper.Key="{Binding Length.FocusKey, StringFormat={}{0}/increase}" />
                                        <TextBox Grid.Column="3" Width="{Binding FontSize, RelativeSource={RelativeSource Self}, Converter={StaticResource LengthBoxWidth}}" Margin="10,0,0,0" FontFamily="{StaticResource MonoFont}"
                                                 Text="{Binding Length.LedCountText, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="{Binding Length.TextAccessibleName}"
                                                 AutomationProperties.HelpText="{Binding LedCountHelpText}"
                                                 views:FocusKeeper.Key="{Binding Length.FocusKey, StringFormat={}{0}/text}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding Length.ApplyCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <Button Grid.Column="4" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.ApplyLedCount}"
                                                ToolTip="{x:Static res:Strings.ApplyLedCountToolTip}" Command="{Binding Length.ApplyCommand}"
                                                AutomationProperties.Name="{Binding Length.ApplyAccessibleName}"
                                                views:FocusKeeper.Key="{Binding Length.FocusKey, StringFormat={}{0}/apply}" />
                                    </Grid>
                                    <!-- Why "Toepassen" cannot take the typed length; a screen reader reads it when it comes. -->
                                    <DockPanel Margin="0,6,0,0" Visibility="{Binding Length.LedCountError, Converter={StaticResource NullToCollapsed}}">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource WarningMark}" AutomationProperties.Name="{x:Static res:Strings.Warning}" />
                                        <TextBlock TextWrapping="Wrap" Text="{Binding Length.LedCountError, NotifyOnTargetUpdated=True}"
                                                   AutomationProperties.LiveSetting="Polite" views:LiveRegion.AnnouncesUpdates="True" />
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- While the preview stands still, a flash of the device or a zone is this mark instead of white on
             and off; a screen reader reads it when it comes. -->
        <DataTemplate x:Key="FlashMark" DataType="{x:Type vm:DevicePreviewViewModel}">
            <Border HorizontalAlignment="Left" Padding="10,2" CornerRadius="999"
                    BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}">
                <TextBlock Style="{StaticResource SubText}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                           Text="{Binding FlashMark, NotifyOnTargetUpdated=True}"
                           AutomationProperties.LiveSetting="Polite" views:LiveRegion.AnnouncesUpdates="True" />
            </Border>
        </DataTemplate>

        <!-- The card that is always open: one chosen device, or a house with one device. Its title is a
             heading for a screen reader, no Tab stop. -->
        <DataTemplate x:Key="FixedCard" DataType="{x:Type vm:DevicePreviewViewModel}">
            <Border Margin="0,0,0,12" Style="{StaticResource LargeCard}" Background="{DynamicResource PreviewBgBrush}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                                Content="{x:Static res:Strings.FlashDevice}" ToolTip="{x:Static res:Strings.FlashDeviceToolTip}"
                                Command="{Binding FlashCommand}" AutomationProperties.Name="{Binding FlashAccessibleName}"
                                ToolTipService.ShowOnDisabled="True" />
                        <Path Style="{StaticResource DeviceIcon}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource CardTitle}" VerticalAlignment="Center" Text="{Binding Name}" AutomationProperties.HeadingLevel="Level3" />
                    </DockPanel>
                    <ContentControl Margin="0,0,0,10" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource FlashMark}"
                                    Visibility="{Binding FlashMark, Converter={StaticResource NullToCollapsed}}" />
                    <ContentControl Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource DeviceBody}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- The card that opens and closes (DeviceCard, § 9.3): on its head the arrow, the icon, the name
             and the number of LEDs as one click area, and beside it the small strip and Knipperen; the mark
             of a flash under the head, also closed. Name, help text and heading level are on the card,
             which a screen reader reads (ExpanderAutomationPeer). -->
        <DataTemplate x:Key="FoldableCard" DataType="{x:Type vm:DevicePreviewViewModel}">
            <views:DeviceCard Margin="0,0,0,10" Header="{Binding}" Content="{Binding}" ContentTemplate="{StaticResource DeviceBody}"
                              IsExpanded="{Binding IsExpanded, Mode=TwoWay}" FocusKey="{Binding CardFocusKey}"
                              AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding LedLine}"
                              AutomationProperties.HeadingLevel="Level3">
                <views:DeviceCard.HeaderTemplate>
                    <DataTemplate DataType="{x:Type vm:DevicePreviewViewModel}">
                        <DockPanel>
                            <Path Style="{StaticResource DeviceIcon}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardTitle}" TextTrimming="None" TextWrapping="Wrap" Text="{Binding Name}" />
                                <TextBlock Style="{StaticResource SubText}" Text="{Binding LedLine}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </views:DeviceCard.HeaderTemplate>
                <views:DeviceCard.Aside>
                    <StackPanel Orientation="Horizontal">
                        <!-- Twelve bulbs in the colors the device shows now, drawn as one element; only decoration. -->
                        <Border Style="{StaticResource StripBoard}" Padding="8,0" VerticalAlignment="Center">
                            <views:SmallLedStrip Width="156" VerticalAlignment="Center" Colors="{Binding Strip}"
                                                 OffBrush="{StaticResource LedOffBrush}" OffRingBrush="{StaticResource StripLedOffRingBrush}" />
                        </Border>
                        <Button Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}"
                                Content="{x:Static res:Strings.FlashDevice}" ToolTip="{x:Static res:Strings.FlashDeviceToolTip}"
                                Command="{Binding FlashCommand}" AutomationProperties.Name="{Binding FlashAccessibleName}"
                                ToolTipService.ShowOnDisabled="True" />
                    </StackPanel>
                </views:DeviceCard.Aside>
                <views:DeviceCard.Note>
                    <ContentControl Margin="80,0,18,10" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource FlashMark}"
                                    Visibility="{Binding FlashMark, Converter={StaticResource NullToCollapsed}}" />
                </views:DeviceCard.Note>
            </views:DeviceCard>
        </DataTemplate>

        <views:DeviceCardTemplateSelector x:Key="CardSelector" Foldable="{StaticResource FoldableCard}" Fixed="{StaticResource FixedCard}" />
    </UserControl.Resources>

    <StackPanel>
        <!-- The heading, with "Alles openklappen" and "Alles dichtklappen" beside it, or under it when the
             text of a larger text size of Windows needs the room. Only the cards that open and close have
             the links and the line under the heading. -->
        <views:HeaderPanel Margin="0,0,0,12" MinHeadingWidth="{Binding (TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={StaticResource PerDeviceHeadingWidth}}">
            <StackPanel VerticalAlignment="Bottom">
                <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.PerDeviceHeader}" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource SubText}" Text="{x:Static res:Strings.PerDeviceHint}"
                           Visibility="{Binding Preview.UsesCards, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <WrapPanel VerticalAlignment="Bottom" Visibility="{Binding Preview.UsesCards, Converter={StaticResource BoolToVisibility}}">
                <views:LinkButton x:Name="ExpandAllLink" Margin="0,0,14,0" Content="{x:Static res:Strings.ExpandAllCards}"
                                  Command="{Binding Preview.ExpandAllCommand}"
                                  AutomationProperties.Name="{x:Static res:Strings.ExpandAllCardsAccessibleName}" />
                <views:LinkButton x:Name="CollapseAllLink" Content="{x:Static res:Strings.CollapseAllCards}"
                                  Command="{Binding Preview.CollapseAllCommand}"
                                  AutomationProperties.Name="{x:Static res:Strings.CollapseAllCardsAccessibleName}" />
            </WrapPanel>
        </views:HeaderPanel>
        <!-- Without devices, no chips, links or cards: how to find them. -->
        <TextBlock Margin="0,0,0,12" Style="{StaticResource SubText}" Text="{x:Static res:Strings.NoLamps}"
                   Visibility="{Binding Preview.HasDevices, Converter={StaticResource InverseBoolToVisibility}}" />
        <!-- Why Knipperen and Tellen are grey: once, above the cards, also with more devices. -->
        <views:PreviewActionsHint DataContext="{Binding Preview.ActionsHint}" />
        <!-- "Naar een apparaat": a chip per device jumps to its card, opens it and puts it at the top. -->
        <views:DeviceChipRow x:Name="Chips" Margin="0,0,0,4" ItemsSource="{Binding Preview.Devices}" Focusable="False"
                             KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="None"
                             AutomationProperties.Name="{x:Static res:Strings.DeviceChipsName}"
                             Visibility="{Binding Preview.UsesCards, Converter={StaticResource BoolToVisibility}}">
            <views:DeviceChipRow.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </views:DeviceChipRow.ItemsPanel>
            <views:DeviceChipRow.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DevicePreviewViewModel}">
                    <Button Margin="0,0,8,8" Style="{StaticResource DeviceChip}" Click="OnChipClick"
                            MaxWidth="{Binding FontSize, RelativeSource={RelativeSource Self}, Converter={StaticResource ChipMaxWidth}}"
                            ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                            AutomationProperties.HelpText="{x:Static res:Strings.DeviceChipHelp}"
                            AutomationProperties.PositionInSet="{Binding Position}" AutomationProperties.SizeOfSet="{Binding SetSize}"
                            views:FocusKeeper.Key="{Binding ChipFocusKey}">
                        <DockPanel>
                            <views:LedBulb DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center" Diameter="12" GlowBlur="10" GlowSpread="2"
                                           IsLit="{Binding ChipLed.IsLit}" Color="{Binding ChipLed.Color}" />
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                        </DockPanel>
                    </Button>
                </DataTemplate>
            </views:DeviceChipRow.ItemTemplate>
        </views:DeviceChipRow>
        <ItemsControl x:Name="Cards" ItemsSource="{Binding Preview.Devices}" Focusable="False" ItemTemplateSelector="{StaticResource CardSelector}"
                      AutomationProperties.Name="{x:Static res:Strings.PerDeviceHeader}" />
    </StackPanel>
</UserControl>
