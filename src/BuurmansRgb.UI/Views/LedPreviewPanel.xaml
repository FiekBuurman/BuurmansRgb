<!-- The preview of the selected lamp, or of all of them: per device a button to let it blink and, with more
     zones, the switch "Zones gelijk"; per zone its name with a button to let only that zone blink, a dot or
     key per LED, and the length of a zone whose length can be set. The DataContext is MainViewModel. -->
<UserControl x:Class="BuurmansRgb.UI.Views.LedPreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:BuurmansRgb.UI.Resources"
             xmlns:vm="clr-namespace:BuurmansRgb.UI.ViewModels"
             xmlns:views="clr-namespace:BuurmansRgb.UI.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             Focusable="False">
    <StackPanel>
        <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.PreviewHeader}" />
        <TextBlock Margin="0,4,0,12" Style="{StaticResource SubText}" Text="{x:Static res:Strings.PreviewHint}" />
        <ItemsControl ItemsSource="{Binding Preview.Devices}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DevicePreviewViewModel}">
                    <Border Margin="0,0,0,12" Style="{StaticResource LargeCard}" Background="{StaticResource PreviewBgBrush}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                                        Content="{x:Static res:Strings.FlashDevice}" ToolTip="{x:Static res:Strings.FlashDeviceToolTip}"
                                        Command="{Binding FlashCommand}" AutomationProperties.Name="{Binding FlashAccessibleName}"
                                        ToolTipService.ShowOnDisabled="True" />
                                <Path Style="{StaticResource DeviceIcon}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CardTitle}" VerticalAlignment="Center" Text="{Binding Name}" />
                            </DockPanel>
                            <!-- "Zones gelijk", only for a device with more zones with LEDs, with a short line under
                                 it as the switches on the Instellingen page have; the rest of the explanation is the
                                 tooltip, so a card stays short. The switch keeps the focus when the preview is made
                                 again after a change of it. -->
                            <DockPanel Margin="0,0,0,10" ToolTip="{x:Static res:Strings.ZonesAlikeHint}"
                                       Visibility="{Binding ShowsZonesAlike, Converter={StaticResource BoolToVisibility}}">
                                <ToggleButton DockPanel.Dock="Right" Margin="14,0,0,0" VerticalAlignment="Top" Style="{StaticResource Switch}"
                                              IsChecked="{Binding ZonesAlike}"
                                              AutomationProperties.Name="{Binding ZonesAlikeAccessibleName}"
                                              AutomationProperties.HelpText="{x:Static res:Strings.ZonesAlikeHint}"
                                              views:FocusKeeper.Key="{Binding ZonesAlikeFocusKey}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Body}" Text="{x:Static res:Strings.ZonesAlike}" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource SubText}" Text="{x:Static res:Strings.ZonesAlikeSubText}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,10" Visibility="{Binding LacksDirectMode, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource WarningMark}"
                                           AutomationProperties.Name="{x:Static res:Strings.NoDirectModeWarning}" />
                                <TextBlock Style="{StaticResource SubText}" Text="{x:Static res:Strings.NoDirectModeHint}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Zones}" Focusable="False" AutomationProperties.Name="{Binding Name}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ZonePreviewViewModel}">
                                        <StackPanel Margin="0,0,0,10">
                                            <!-- The zone name, with a button beside it that lets only this zone blink; the
                                                 button keeps the focus when the preview is made again after a resize. -->
                                            <DockPanel Margin="0,0,0,4">
                                                <Button DockPanel.Dock="Right" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}"
                                                        Content="{x:Static res:Strings.FlashZone}" ToolTip="{x:Static res:Strings.FlashZoneToolTip}"
                                                        Command="{Binding FlashCommand}" AutomationProperties.Name="{Binding FlashAccessibleName}"
                                                        ToolTipService.ShowOnDisabled="True" views:FocusKeeper.Key="{Binding FlashFocusKey}"
                                                        Visibility="{Binding ShowsFlash, Converter={StaticResource BoolToVisibility}}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock FontSize="{StaticResource SubTextSize}" TextWrapping="Wrap"
                                                               Visibility="{Binding ShowsHeaderLink, Converter={StaticResource BoolToVisibility}}">
                                                        <Hyperlink Command="{Binding SelectZoneCommand}" ToolTip="{x:Static res:Strings.SelectZoneToolTip}">
                                                            <Run Text="{Binding Header, Mode=OneWay}" />
                                                        </Hyperlink>
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource SubText}" Text="{Binding Header}"
                                                               Visibility="{Binding ShowsHeaderText, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock FontSize="{StaticResource SubTextSize}"
                                                               Visibility="{Binding ShowsSelectAllLink, Converter={StaticResource BoolToVisibility}}">
                                                        <Hyperlink Command="{Binding SelectZoneCommand}" ToolTip="{x:Static res:Strings.SelectAllToolTip}"
                                                                   AutomationProperties.Name="{Binding SelectAllAccessibleName}">
                                                            <Run Text="{x:Static res:Strings.SelectAll}" />
                                                        </Hyperlink>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                            <!-- The LEDs, also with the keys of the per-LED editor; they keep the focus
                                                 when the preview is made again. -->
                                            <views:LedPreviewView Colors="{Binding Colors}" Matrix="{Binding Matrix}" HorizontalAlignment="Stretch"
                                                                  IsRing="{Binding IsRing}" LedNames="{Binding LedNames}" LedLabels="{Binding LedLabels}"
                                                                  SelectionFirst="{Binding SelectionFirst}" SelectionLast="{Binding SelectionLast}"
                                                                  ClickCommand="{Binding ClickLedCommand}"
                                                                  ActiveLed="{Binding ActiveLed}" KeyCommand="{Binding PressKeyCommand}" KeyGroup="{Binding DeviceId}"
                                                                  views:FocusKeeper.Key="{Binding LedsFocusKey}"
                                                                  AutomationProperties.Name="{Binding AccessibleName}" />
                                            <TextBlock Margin="0,4,0,0" Style="{StaticResource SubText}" Text="{x:Static res:Strings.EmptyZoneHint}"
                                                       Visibility="{Binding ShowsEmptyZoneHint, Converter={StaticResource BoolToVisibility}}" />
                                            <!-- The controls keep the focus when the preview is made again after a resize. -->
                                            <StackPanel Margin="0,8,0,0" Visibility="{Binding CanResize, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Style="{StaticResource SubText}" Text="{Binding Length.Label}" />
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" MaxWidth="360" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <RepeatButton Grid.Column="0" Style="{StaticResource IconRepeatButton}" Content="−"
                                                            ToolTip="{x:Static res:Strings.DecreaseLedCountToolTip}" Command="{Binding Length.DecreaseCommand}"
                                                            AutomationProperties.Name="{Binding Length.DecreaseAccessibleName}"
                                                            views:FocusKeeper.Key="{Binding Length.FocusKey, StringFormat={}{0}/decrease}" />
                                                    <Slider Grid.Column="1" Margin="10,0" MinWidth="80" VerticalAlignment="Center"
                                                            Minimum="{Binding Length.Minimum}" Maximum="{Binding Length.Maximum}"
                                                            Value="{Binding Length.LedCount}" SmallChange="1" LargeChange="10"
                                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                                            ToolTip="{x:Static res:Strings.ZoneLedCountToolTip}"
                                                            views:SliderDrag.Started="{Binding Length.BeginDragCommand}" views:SliderDrag.Completed="{Binding Length.EndDragCommand}"
                                                            AutomationProperties.Name="{Binding Length.SliderAccessibleName}"
                                                            AutomationProperties.HelpText="{Binding LedCountHelpText}"
                                                            views:FocusKeeper.Key="{Binding Length.FocusKey, StringFormat={}{0}/slider}" />
                                                    <RepeatButton Grid.Column="2" Style="{StaticResource IconRepeatButton}" Content="+"
                                                            ToolTip="{x:Static res:Strings.IncreaseLedCountToolTip}" Command="{Binding Length.IncreaseCommand}"
                                                            AutomationProperties.Name="{Binding Length.IncreaseAccessibleName}"
                                                            views:FocusKeeper.Key="{Binding Length.FocusKey, StringFormat={}{0}/increase}" />
                                                    <TextBox Grid.Column="3" Width="64" Margin="10,0,0,0" FontFamily="{StaticResource MonoFont}"
                                                             Text="{Binding Length.LedCountText, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="{Binding Length.TextAccessibleName}"
                                                             AutomationProperties.HelpText="{Binding LedCountHelpText}"
                                                             views:FocusKeeper.Key="{Binding Length.FocusKey, StringFormat={}{0}/text}">
                                                        <TextBox.InputBindings>
                                                            <KeyBinding Key="Enter" Command="{Binding Length.ApplyCommand}" />
                                                        </TextBox.InputBindings>
                                                    </TextBox>
                                                    <Button Grid.Column="4" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.ApplyLedCount}"
                                                            ToolTip="{x:Static res:Strings.ApplyLedCountToolTip}" Command="{Binding Length.ApplyCommand}"
                                                            AutomationProperties.Name="{Binding Length.ApplyAccessibleName}"
                                                            views:FocusKeeper.Key="{Binding Length.FocusKey, StringFormat={}{0}/apply}" />
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
