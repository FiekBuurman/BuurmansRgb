<!-- The tiles of a list of colors with + and −; a click on a tile selects it, and the color picker then
     colors that one. The DataContext is a ColorListEditorViewModel, such as the colors of the color loop. -->
<UserControl x:Class="BuurmansRgb.UI.Views.ColorListEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:BuurmansRgb.UI.Resources"
             xmlns:vm="clr-namespace:BuurmansRgb.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ColorListEditorViewModel}"
             Focusable="False">
    <!-- Rows of at most six tiles (44 wide and 8 apart), as the toolbox above: twelve colors are two
         even rows, and + and − stand to the right of the first row, or under the tiles in a narrow window. -->
    <WrapPanel>
        <ItemsControl Style="{StaticResource ColorTileList}" ItemsSource="{Binding Swatches}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ColorSwatch}">
                    <Button Style="{StaticResource ColorListTile}" Background="{Binding Color, Converter={StaticResource ColorToBrush}}"
                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Index}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Style="{StaticResource ColorListButton}" Content="+"
                ToolTip="{x:Static res:Strings.ColorListAdd}" AutomationProperties.Name="{x:Static res:Strings.ColorListAdd}"
                Command="{Binding AddColorCommand}" />
        <Button Style="{StaticResource ColorListButton}" Content="−"
                ToolTip="{x:Static res:Strings.ColorListRemove}" AutomationProperties.Name="{x:Static res:Strings.ColorListRemove}"
                Command="{Binding RemoveColorCommand}" />
    </WrapPanel>
</UserControl>
