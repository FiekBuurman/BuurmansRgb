<!-- A slider with its name above it and its value on the right, such as Helderheid with "80%": the name is
     also what a screen reader calls the slider, and the slider takes the help and status the page gives.
     A panel rather than a UserControl (ValueSlider.xaml.cs). -->
<StackPanel x:Class="BuurmansRgb.UI.Views.ValueSlider"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:views="clr-namespace:BuurmansRgb.UI.Views">
    <DockPanel>
        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoValue}"
                   Text="{Binding ValueText, RelativeSource={RelativeSource AncestorType=views:ValueSlider}}" />
        <!-- Beside the value, such as the arrow of Richting. -->
        <ContentPresenter DockPanel.Dock="Right" Content="{Binding ValueIcon, RelativeSource={RelativeSource AncestorType=views:ValueSlider}}" />
        <TextBlock Margin="0,0,0,6" Style="{StaticResource Body}"
                   Text="{Binding Label, RelativeSource={RelativeSource AncestorType=views:ValueSlider}}" />
    </DockPanel>
    <!-- Minimum and Maximum before Value, so the value never meets the range of a slider that is not yet
         set; the steps always snap to TickFrequency. The help is its tooltip too. -->
    <Slider Minimum="{Binding Minimum, RelativeSource={RelativeSource AncestorType=views:ValueSlider}}"
            Maximum="{Binding Maximum, RelativeSource={RelativeSource AncestorType=views:ValueSlider}}"
            Value="{Binding Value, RelativeSource={RelativeSource AncestorType=views:ValueSlider}}"
            SmallChange="{Binding SmallChange, RelativeSource={RelativeSource AncestorType=views:ValueSlider}}"
            LargeChange="{Binding LargeChange, RelativeSource={RelativeSource AncestorType=views:ValueSlider}}"
            IsSnapToTickEnabled="True"
            TickFrequency="{Binding TickFrequency, RelativeSource={RelativeSource AncestorType=views:ValueSlider}}"
            ToolTip="{Binding HelpText, RelativeSource={RelativeSource AncestorType=views:ValueSlider}}"
            AutomationProperties.Name="{Binding Label, RelativeSource={RelativeSource AncestorType=views:ValueSlider}}"
            AutomationProperties.HelpText="{Binding HelpText, RelativeSource={RelativeSource AncestorType=views:ValueSlider}}"
            AutomationProperties.ItemStatus="{Binding ItemStatus, RelativeSource={RelativeSource AncestorType=views:ValueSlider}}"
            AutomationProperties.AutomationId="{Binding Name, RelativeSource={RelativeSource AncestorType=views:ValueSlider}}" />
</StackPanel>
