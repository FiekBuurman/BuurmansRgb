<!-- The status line (Statusregel, design/DESIGN.md § 4) at the top of Apparaten and Kleur: at most one
     message, the one that matters most, with its action, and "Details" that unfolds the other messages
     that hold, each with its own action, so a message that is pushed aside never goes without a word. A
     message with an explanation has "Uitleg", which unfolds it under the message, in the line or under Details.
     Calm, a card like the rest: a pause or a preview that stands still is a choice, not an error. A screen
     reader reads the message when it comes or changes: the card inside hides, not the control, so the text
     is loaded before it shows and its new text counts as a change (LiveRegion). Details unfold without
     animation. The DataContext is StatusLineViewModel. -->
<UserControl x:Class="BuurmansRgb.UI.Views.StatusLine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:BuurmansRgb.UI.Resources"
             xmlns:vm="clr-namespace:BuurmansRgb.UI.ViewModels"
             xmlns:views="clr-namespace:BuurmansRgb.UI.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StatusLineViewModel}"
             Focusable="False">
    <Border Style="{StaticResource StatusLineCard}" Visibility="{Binding IsShown, Converter={StaticResource BoolToVisibility}}"
            AutomationProperties.AutomationId="StatusLineCard">
        <StackPanel>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <!-- The action of the message in the line: its text follows the source ("Zoeken…", "Stilzetten"), so
                         the button keeps the keyboard focus; only "Hervatten" takes itself away (OnActionClick). A button
                         that hides with the focus in it, because the message left the line, hands the focus on first
                         (OnButtonIsVisibleChanged). -->
                    <Button x:Name="ActionButton" DataContext="{Binding Current}" Style="{StaticResource SecondaryButton}" Content="{Binding ActionText}"
                            ToolTip="{Binding ActionHelpText}" Command="{Binding ActionCommand}" Click="OnActionClick" IsVisibleChanged="OnButtonIsVisibleChanged"
                            Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="{Binding ActionAccessibleName}" AutomationProperties.HelpText="{Binding ActionHelpText}"
                            AutomationProperties.AutomationId="StatusLineAction" />
                    <!-- "Uitleg" of a message with an explanation (other RGB software): pressed, the explanation shows
                         under the line; pressed again, it closes. A toggle like "Details", so a screen reader hears
                         whether it is open. -->
                    <ToggleButton x:Name="ExplanationToggle" DataContext="{Binding Current}" Margin="8,0,0,0" Style="{StaticResource StatusLineDetailsToggle}"
                                  Content="{x:Static res:Strings.StatusExplanation}" IsChecked="{Binding ShowsExplanation}"
                                  ToolTip="{x:Static res:Strings.StatusExplanationToolTip}" IsVisibleChanged="OnButtonIsVisibleChanged"
                                  Visibility="{Binding HasExplanation, Converter={StaticResource BoolToVisibility}}"
                                  AutomationProperties.Name="{Binding ExplanationAccessibleName}" AutomationProperties.HelpText="{x:Static res:Strings.StatusExplanationToolTip}"
                                  AutomationProperties.AutomationId="StatusLineExplanationToggle" />
                    <!-- "Niet meer melden" of a message the user can take away for good (other RGB software): it ends the
                         message, so the focus moves on first (OnDismissClick). -->
                    <Button x:Name="DismissButton" DataContext="{Binding Current}" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="{Binding DismissText}"
                            ToolTip="{Binding DismissHelpText}" Command="{Binding DismissCommand}" Click="OnDismissClick" IsVisibleChanged="OnButtonIsVisibleChanged"
                            Visibility="{Binding HasDismiss, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="{Binding DismissAccessibleName}" AutomationProperties.HelpText="{Binding DismissHelpText}"
                            AutomationProperties.AutomationId="StatusLineDismiss" />
                    <ToggleButton x:Name="DetailsToggle" Margin="8,0,0,0" Style="{StaticResource StatusLineDetailsToggle}" Content="{x:Static res:Strings.StatusDetails}"
                                  IsChecked="{Binding ShowsDetails}" ToolTip="{x:Static res:Strings.StatusDetailsToolTip}" IsVisibleChanged="OnButtonIsVisibleChanged"
                                  Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}"
                                  AutomationProperties.Name="{Binding DetailsAccessibleName}" AutomationProperties.HelpText="{x:Static res:Strings.StatusDetailsToolTip}"
                                  AutomationProperties.AutomationId="StatusLineDetails" />
                </StackPanel>
                <TextBlock Style="{StaticResource StatusLineText}" Text="{Binding Current.Text, NotifyOnTargetUpdated=True}"
                           AutomationProperties.AutomationId="StatusLine" AutomationProperties.LiveSetting="Polite"
                           views:LiveRegion.AnnouncesUpdates="True" />
            </DockPanel>
            <!-- What "Uitleg" of the message in the line unfolds, with the link to the guide once there is one. -->
            <StackPanel DataContext="{Binding Current}" Margin="0,8,0,0"
                        Visibility="{Binding ShowsExplanation, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                        AutomationProperties.AutomationId="StatusLineExplanationPanel">
                <TextBlock Style="{StaticResource StatusLineDetailText}" Text="{Binding Explanation}" AutomationProperties.AutomationId="StatusLineExplanation" />
                <Button HorizontalAlignment="Left" Style="{StaticResource LinkButton}" Content="{Binding ExplanationLinkText}" Command="{Binding ExplanationLinkCommand}"
                        IsVisibleChanged="OnButtonIsVisibleChanged"
                        Visibility="{Binding HasExplanationLink, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="{Binding ExplanationLinkAccessibleName}" AutomationProperties.AutomationId="StatusLineExplanationLink" />
            </StackPanel>
            <!-- The other messages that hold, in the order they matter, each with its own action. Others changes one
                 message at a time, so the item of a message that stays keeps its button and the focus on it. -->
            <StackPanel Visibility="{Binding ShowsDetails, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="StatusLineDetailList">
                <Border Margin="0,10,0,4" Height="1" Background="{DynamicResource BorderBrush}" />
                <ItemsControl ItemsSource="{Binding Others}" Focusable="False" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StatusMessage}">
                            <StackPanel Margin="0,6,0,0">
                                <DockPanel>
                                    <!-- The action, "Uitleg" and then "Niet meer melden", in reading and Tab order. -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Content="{Binding ActionText}" ToolTip="{Binding ActionHelpText}" Command="{Binding ActionCommand}" Click="OnActionClick"
                                                IsVisibleChanged="OnButtonIsVisibleChanged"
                                                Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}"
                                                AutomationProperties.Name="{Binding ActionAccessibleName}" AutomationProperties.HelpText="{Binding ActionHelpText}"
                                                AutomationProperties.AutomationId="StatusLineDetailAction" />
                                        <ToggleButton Margin="8,0,0,0" Style="{StaticResource StatusLineDetailsToggle}"
                                                      Content="{x:Static res:Strings.StatusExplanation}" IsChecked="{Binding ShowsExplanation}"
                                                      ToolTip="{x:Static res:Strings.StatusExplanationToolTip}" IsVisibleChanged="OnButtonIsVisibleChanged"
                                                      Visibility="{Binding HasExplanation, Converter={StaticResource BoolToVisibility}}"
                                                      AutomationProperties.Name="{Binding ExplanationAccessibleName}" AutomationProperties.HelpText="{x:Static res:Strings.StatusExplanationToolTip}"
                                                      AutomationProperties.AutomationId="StatusLineDetailExplanationToggle" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                                                Content="{Binding DismissText}" ToolTip="{Binding DismissHelpText}" Command="{Binding DismissCommand}" Click="OnDismissClick"
                                                IsVisibleChanged="OnButtonIsVisibleChanged"
                                                Visibility="{Binding HasDismiss, Converter={StaticResource BoolToVisibility}}"
                                                AutomationProperties.Name="{Binding DismissAccessibleName}" AutomationProperties.HelpText="{Binding DismissHelpText}"
                                                AutomationProperties.AutomationId="StatusLineDetailDismiss" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource StatusLineDetailText}" Text="{Binding Text}"
                                               AutomationProperties.AutomationId="StatusLineDetail" />
                                </DockPanel>
                                <StackPanel Margin="0,6,0,0" Visibility="{Binding ShowsExplanation, Converter={StaticResource BoolToVisibility}}"
                                            AutomationProperties.AutomationId="StatusLineDetailExplanationPanel">
                                    <TextBlock Style="{StaticResource StatusLineDetailText}" Text="{Binding Explanation}"
                                               AutomationProperties.AutomationId="StatusLineDetailExplanation" />
                                    <Button HorizontalAlignment="Left" Style="{StaticResource LinkButton}" Content="{Binding ExplanationLinkText}"
                                            Command="{Binding ExplanationLinkCommand}" IsVisibleChanged="OnButtonIsVisibleChanged"
                                            Visibility="{Binding HasExplanationLink, Converter={StaticResource BoolToVisibility}}"
                                            AutomationProperties.Name="{Binding ExplanationLinkAccessibleName}"
                                            AutomationProperties.AutomationId="StatusLineDetailExplanationLink" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
