<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>BuurmansRgb.UI</AssemblyName>
    <!-- Shared with BuurmansRgb.Engine, see Directory.Build.props. -->
    <OutDir>$(AppOutputRoot)$(Configuration)\</OutDir>
  </PropertyGroup>

  <!-- Unlike the engine and the providers, the view models, views and converters stay public,
       although no other assembly uses them: XAML binds to them by reflection, and a binding to a
       type it cannot reach only fails at run time, where no test sees it. Helpers that XAML does
       not use, such as UiText and ReentrancyGuard, are internal. -->
  <ItemGroup>
    <InternalsVisibleTo Include="BuurmansRgb.UI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>BuurmansRgb.UI.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <!-- XAML uses the generated Strings class, but WPF compiles a temporary assembly for XAML before
       the resources are generated. Generate them first and hand the class to that compile.
       _GeneratedCodeFiles is internal to the WPF targets (verified with SDK 10.0.302). If an SDK
       update breaks it, the build fails with CS0234 "'Resources' does not exist in the namespace
       'BuurmansRgb.UI'" in the *_wpftmp project;
       a markup extension that reads Strings.ResourceManager would then replace x:Static. -->
  <Target Name="IncludeStringsInMarkupCompile" BeforeTargets="GenerateTemporaryTargetAssembly" DependsOnTargets="PrepareResourceNames;ResGen">
    <ItemGroup>
      <_GeneratedCodeFiles Include="$(IntermediateOutputPath)Strings.Designer.cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BuurmansRgb.Contracts\BuurmansRgb.Contracts.csproj" />
  </ItemGroup>

</Project>
