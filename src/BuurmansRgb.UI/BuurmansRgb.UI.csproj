<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- A window without an icon of its own takes this one, also on the taskbar. -->
    <ApplicationIcon>$(AppIconPath)</ApplicationIcon>
    <!-- LibraryImport generates its marshalling code as unsafe code (WindowFrame). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>BuurmansRgb.UI</AssemblyName>
    <!-- Shared with BuurmansRgb.Engine, see Directory.Build.props. -->
    <OutDir>$(AppOutputRoot)$(Configuration)$(AppOutputSuffix)\</OutDir>
    <!-- Memory (docs/ontwikkelaars.md, "Metingen"): with tiered compilation .NET keeps a quick first
         version and later an optimized second one of every method that runs often, which cost the
         app 8-17 MB of working set. Without it, each method is compiled once. Every publish of the
         app (with the installer or without) compiles it ahead of time (ReadyToRun), so the app is
         usable only ~0.15 s later for it; a plain build without it starts 0.2-0.7 s later.
         Only on publish (dotnet publish sets _IsPublishing, also for its restore): set always, the
         SDK would give every restore a runtime identifier and fetch the ReadyToRun compiler and the
         win-x64 runtime packs for a plain build and test as well. So publish with dotnet publish
         and its own restore, and a publish from Visual Studio or with -t:Publish gets no
         ReadyToRun (docs/ontwikkelaars.md, "Installer bouwen en testen"). -->
    <TieredCompilation>false</TieredCompilation>
    <PublishReadyToRun Condition="'$(_IsPublishing)' == 'true'">true</PublishReadyToRun>
    <!-- Only these assemblies get ReadyToRun code, see KeepSharedAssembliesIL. -->
    <ReadyToRunAssemblies>$(AssemblyName);CommunityToolkit.Mvvm</ReadyToRunAssemblies>
  </PropertyGroup>

  <!-- The engine is published to the same folder (installer\build.ps1, docs/installatie.md) and
       loads the same BuurmansRgb.Contracts, BuurmansRgb.Core, StreamJsonRpc, MessagePack and the
       rest of what comes in through Contracts. The app is published second, so ReadyToRun on those
       would change the engine too, unmeasured. Keep every assembly but the app's own as it is. -->
  <Target Name="KeepSharedAssembliesIL" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_ReadyToRunAssembly Include="$(ReadyToRunAssemblies)" />
      <PublishReadyToRunExclude Include="@(ResolvedFileToPublish->'%(Filename)%(Extension)')"
                                Condition="'%(ResolvedFileToPublish.Extension)' == '.dll'" />
      <PublishReadyToRunExclude Remove="@(_ReadyToRunAssembly->'%(Identity).dll')" />
    </ItemGroup>
  </Target>

  <!-- Unlike the engine and the providers, the view models, views and converters stay public,
       although no other assembly uses them: XAML binds to them by reflection, and a binding to a
       type it cannot reach only fails at run time, where no test sees it. Helpers that XAML does
       not use, such as UiText and ReentrancyGuard, are internal. -->
  <ItemGroup>
    <InternalsVisibleTo Include="BuurmansRgb.UI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>BuurmansRgb.UI.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <!-- XAML uses the generated Strings class, but WPF compiles a temporary assembly for XAML before
       the resources are generated. Generate them first and hand the class to that compile.
       _GeneratedCodeFiles is internal to the WPF targets (verified with SDK 10.0.302). If an SDK
       update breaks it, the build fails with CS0234 "'Resources' does not exist in the namespace
       'BuurmansRgb.UI'" in the *_wpftmp project;
       a markup extension that reads Strings.ResourceManager would then replace x:Static. -->
  <Target Name="IncludeStringsInMarkupCompile" BeforeTargets="GenerateTemporaryTargetAssembly" DependsOnTargets="PrepareResourceNames;ResGen">
    <ItemGroup>
      <_GeneratedCodeFiles Include="$(IntermediateOutputPath)Strings.Designer.cs" />
    </ItemGroup>
  </Target>

  <!-- The fonts of the design (design/DESIGN.md § 2), one static file per weight: WPF only shows the
       default instance of a variable font. Their licence goes along in the app folder. -->
  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <None Update="Fonts\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BuurmansRgb.Contracts\BuurmansRgb.Contracts.csproj" />
  </ItemGroup>

</Project>
