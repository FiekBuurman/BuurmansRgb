<Project Sdk="Microsoft.NET.Sdk">

  <!-- The names of the simulated devices show in the settings app, so they are Dutch, like the
       rest of its texts. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>BuurmansRgb.Providers.Simulated.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BuurmansRgb.Core\BuurmansRgb.Core.csproj" />
  </ItemGroup>

</Project>
