<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- The engine and the settings app run from one folder: the tray starts BuurmansRgb.UI.exe
       next to the engine. Both apps set their OutDir to it, so neither references the other. -->
  <PropertyGroup>
    <AppOutputRoot>$(MSBuildThisFileDirectory)artifacts\app\</AppOutputRoot>
  </PropertyGroup>

</Project>
