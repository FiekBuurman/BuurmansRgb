<Project>

  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="StreamJsonRpc" Version="2.25.29" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <!-- Pinned transitive packages. StreamJsonRpc 2.25.29 brings MessagePack 2.5.302, which has
       advisory GHSA-qhrr-8q5h-9q3h; 2.5.307 is the latest patched 2.x release. -->
  <ItemGroup>
    <PackageVersion Include="MessagePack" Version="2.5.307" />
  </ItemGroup>

</Project>
