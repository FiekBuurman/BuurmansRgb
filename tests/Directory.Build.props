<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Helpers that every test project shares, compiled into each of them; not into a project that
       only helps the tests and has no xUnit. -->
  <ItemGroup Condition="'$(IsTestHelperProject)' != 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <Using Include="BuurmansRgb.Tests" />
    <Using Include="BuurmansRgb.Tests.TestCancellation" Static="true" />
    <Using Include="BuurmansRgb.Tests.TestColors" Static="true" />
  </ItemGroup>

  <!-- dotnet test names a TRX file after the user, machine and time, so in one results folder you
       cannot tell which file belongs to which test project. With -p:TrxReport=true (build.yml does
       this) every test project writes one TRX file named after itself instead. The file name option
       is only valid next to the report option, so both travel together here. -->
  <PropertyGroup Condition="'$(TrxReport)' == 'true'">
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --report-xunit-trx --report-xunit-trx-filename $(MSBuildProjectName).trx</TestingPlatformCommandLineArguments>
  </PropertyGroup>

</Project>
